# Editor-side half of the contract in .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.{json,md,yml,yaml}]
indent_size = 2

# Sea Power config files: keys are written flush-left and comments use '#'.
# Trailing whitespace is preserved because donor files are copied through.
[*.ini]
indent_size = 4
trim_trailing_whitespace = false

# Verbatim upstream mirror — editors must not reformat it.
[mods-source/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
