<!-- Backers ledger: ransom economy, Alvand gossip before M4 -->
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
    <Border.Effect>
      <DropShadowEffect />
    </Border.Effect>
    <Border.Background>
      <ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
    </Border.Background>

    <StackPanel Orientation="Vertical">

        <Grid
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="WORD ON THE" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="******* WATERFRONT *******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="WATERFRONT" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>

        </Grid>

        <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
        <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

        <Grid
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" Text="FM"/>
        <TextBlock Grid.Row="0" Grid.Column="2" FontSize="16" Text="THE BACKERS"/>
        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="16" Text="TO"/>
        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="16" Text="RANSOM FLOTILLA"/>
        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="16" Text="INFO"/>
        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="16" Text="ALL CREWS"/>
        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="SUBJ"/>
        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="RANSOM LEDGER - WHAT WE HAVE AND WHAT IT BUYS"/>
      </Grid>

      <TextBlock TextWrapping="Wrap" FontSize="16" Margin="0,24,0,0">
        1. The ledger is healthy. Hulls sold, crews ransomed, weapons spent wisely. What follows is what the money buys next.
        <LineBreak/><LineBreak/>
        2. STOCK ON HAND:
      </TextBlock>

      <Border Padding="8" Margin="0,4,0,8">
        <Grid TextElement.FontSize="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="ITEM / FAMILY"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="STATUS"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,0" Text="Styx rounds"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="Missile boats rearm free between hunts. Do not waste them on sampans."/>

          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,12,0" Text="Torpedoes"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="Shershen and Turya boats reload alongside. Night work preferred."/>

          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6,12,0" Text="100kg bombs"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="Bonanza and Cessna kits landing this week. Spotter planes with teeth."/>

          <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6,12,0" Text="Gun ammunition"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="20mm and 7.62mm in depth. Gunnery practice is authorized."/>

          <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6,12,0" Text="The big hull"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap" Text="Word is an Alvand frigate may be had, for serious money, before Malacca. Start saving."/>
        </Grid>
      </Border>

      <TextBlock TextWrapping="Wrap" FontSize="16">
        3. Malacca next. Everything we own fits in one strait, and so does everything against us. Spend carefully.
        <LineBreak/><LineBreak/>
        SIGNED: THE BACKERS
        <LineBreak/><LineBreak/>
        BT
      </TextBlock>
    </StackPanel>
  </Border>
</ScrollViewer>
