<!-- Pacific Strike 17 MAU targeting intelligence event: naval-message paper format. -->
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
    <Border.Effect>
      <DropShadowEffect />
    </Border.Effect>
    <Border.Background>
      <ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
    </Border.Background>

    <StackPanel Orientation="Vertical">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="NAVAL MESSAGE" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
        <TextBlock Grid.Column="1" Text="*******S E C R E T*******" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="NAVY DEPARTMENT" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
      </Grid>

      <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
      <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" FontSize="16">
          SOFORT<LineBreak/>
          O 212300Z SEP 85
        </TextBlock>

        <TextBlock Grid.Row="0" Grid.Column="3" FontSize="16" Text="ZYUW RUHQHQA0777 2642300"/>
      </Grid>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" Text="VON"/>
        <TextBlock Grid.Row="0" Grid.Column="2" FontSize="16" Text="CINCPAC HONOLULU HI"/>
        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="16" Text="AN"/>
        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="16" Text="COMMANDER 17 MAU AFLOAT"/>
        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="16" Text="INFO"/>
        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="16">
          CTF 77 SANDAKAN MY<LineBreak/>
          CINCPACFLT PEARL HARBOR HI<LineBreak/>
          COMSUBPAC PEARL HARBOR HI<LineBreak/>
          MARITIME HQ DARWIN NT AU
        </TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="BETR"/>
        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="ZIELAUFKLÄRUNG - EINRICHTUNGEN IN PUERTO PRINCESA"/>
      </Grid>

      <TextBlock TextWrapping="Wrap" FontSize="16" Margin="0,24,0,0">
        GEHEIM
        <LineBreak/>
        BT
        <LineBreak/><LineBreak/>
        REFERENZEN:
        <LineBreak/>
        A. ORION INTREP 20-85/PP, PERISKOPFOTO UND ES-ORTUNG.
        <LineBreak/>
        B. CINCPAC JIC ZIELAKTE PP-CHALLENGER-17.
        <LineBreak/>
        C. TF 77 LUFT-/FEUERUNTERSTÜTZUNGSHINWEIS 21SEP85/CHALLENGER.
        <LineBreak/><LineBreak/>
        1. (S) ZUSAMMENFASSUNG: Aufklärung durch HMAS ORION hat elf feindliche Einrichtungen im Angriffsraum Puerto Princesa identifiziert. Die nachstehenden Daten werden dem Stab der 17 MAU zur Einsatzplanung und zur Verringerung des Risikos beim Anmarsch auf den Strand übermittelt.
        <LineBreak/><LineBreak/>
        2. (S) ZIELDATEN:
      </TextBlock>

      <Border Padding="8" Margin="0,4,0,12">
        <Grid TextElement.FontSize="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="RAUM"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="ANZ."/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="EINRICHTUNG"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="KOORDINATEN BREITE/LÄNGE"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,0" Text="FLUGPLATZ/RPVP"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,12,0" Text="4"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,6,12,0" Text="FLUGFELD/STARTBAHN"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,6,0,0" Text="09-44-21.6N / 118-44-57.0E"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,12,0" Text="FLUGPLATZ/RPVP"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,12,0" Text="4"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,4,12,0" Text="FLAK-STELLUNG A"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,4,0,0" Text="09-44-01.8N / 118-45-09.6E"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4,12,0" Text="FLUGPLATZ/RPVP"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,12,0" Text="4"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,4,12,0" Text="FLAK-STELLUNG B"/>
          <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,4,0,0" Text="09-44-03.6N / 118-45-02.4E"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4,12,0" Text="FLUGPLATZ/RPVP"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,12,0" Text="4"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,4,12,0" Text="SA-10/S-300-FLA-STELLUNG"/>
          <TextBlock Grid.Row="4" Grid.Column="3" Margin="0,4,0,0" Text="09-45-14.4N / 118-45-28.2E"/>

          <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4,12,0" Text="SÜDANMARSCH"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,4,12,0" Text="SILKWORM TEL A"/>
          <TextBlock Grid.Row="5" Grid.Column="3" Margin="0,4,0,0" Text="09-40-34.8N / 118-44-21.6E"/>

          <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4,12,0" Text="SÜDANMARSCH"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="6" Grid.Column="2" Margin="0,4,12,0" Text="SILKWORM TEL B"/>
          <TextBlock Grid.Row="6" Grid.Column="3" Margin="0,4,0,0" Text="09-40-36.0N / 118-44-25.8E"/>

          <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,4,12,0" Text="SÜDANMARSCH"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="7" Grid.Column="2" Margin="0,4,12,0" Text="SA-8 TEL A"/>
          <TextBlock Grid.Row="7" Grid.Column="3" Margin="0,4,0,0" Text="09-40-32.4N / 118-44-18.6E"/>

          <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,4,12,0" Text="SÜDANMARSCH"/>
          <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="8" Grid.Column="2" Margin="0,4,12,0" Text="SA-8 TEL B"/>
          <TextBlock Grid.Row="8" Grid.Column="3" Margin="0,4,0,0" Text="09-40-39.6N / 118-44-24.0E"/>

          <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,4,12,0" Text="SÜDANMARSCH"/>
          <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="9" Grid.Column="2" Margin="0,4,12,0" Text="SON-9-FEUERLEITUNG"/>
          <TextBlock Grid.Row="9" Grid.Column="3" Margin="0,4,0,0" Text="09-40-36.6N / 118-44-22.2E"/>

          <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,4,12,0" Text="NORDANMARSCH"/>
          <TextBlock Grid.Row="10" Grid.Column="1" Margin="0,4,12,0" Text="2"/>
          <TextBlock Grid.Row="10" Grid.Column="2" Margin="0,4,12,0" Text="HY-1 TEL A"/>
          <TextBlock Grid.Row="10" Grid.Column="3" Margin="0,4,0,0" Text="09-45-25.8N / 118-45-51.6E"/>

          <TextBlock Grid.Row="11" Grid.Column="0" Margin="0,4,12,0" Text="NORDANMARSCH"/>
          <TextBlock Grid.Row="11" Grid.Column="1" Margin="0,4,12,0" Text="2"/>
          <TextBlock Grid.Row="11" Grid.Column="2" Margin="0,4,12,0" Text="HY-1 TEL B"/>
          <TextBlock Grid.Row="11" Grid.Column="3" Margin="0,4,0,0" Text="09-45-28.8N / 118-45-58.2E"/>
        </Grid>
      </Border>

      <TextBlock TextWrapping="Wrap" FontSize="16">
        3. (S) GEBIETSÜBERSICHT: Der Sektor der Antonio Bautista Airbase (RPVP) enthält vier identifizierte Einrichtungen. Der Südanmarsch enthält fünf identifizierte Einrichtungen. Der Nordanmarsch enthält zwei identifizierte Einrichtungen. Die Gesamtzahl der identifizierten Ziele beträgt elf.
        <LineBreak/><LineBreak/>
        4. (S) AUSWIRKUNG AUF DIE PLANUNG: SA-10/S-300-Feuerleitstand, TELs für Küstenflugkörper und zugehöriges Radar sind als vorrangige Unterdrückungsziele zu behandeln, bevor Landungsboote in die Hafenanfahrten einlaufen. FlaK- und Startbahneinrichtungen bleiben Angriffsziele für die anschließende Abriegelung des Landungsraums.
        <LineBreak/><LineBreak/>
        5. (S) ÜBERGABE: Koordinaten aus den Bezügen A und B abgeleitet und anschließend für die Einsatzplanung nach Bezug C formatiert. Weiterleiten an Battalion Landing Team, Verbindungsoffizier für Marinegeschützfeuer, Verbindungsoffizier für Luftunterstützung und Planer der unterstützenden Luftstreitkräfte.
        <LineBreak/><LineBreak/>
        GEZEICHNET: CINCPAC WATCH CENTER
        <LineBreak/><LineBreak/>
        BT
        <LineBreak/>
        GEHEIM
      </TextBlock>
    </StackPanel>
  </Border>
</ScrollViewer>
