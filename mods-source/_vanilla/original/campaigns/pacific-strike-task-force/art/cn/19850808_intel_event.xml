<!-- Campaign event template for standard USN-style "daily intentions message" (DIM) - formatting taken from real world examples -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>
		
        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			
			<TextBlock Grid.Row="0" Grid.Column="0" Text="海军消息" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
			<TextBlock Grid.Row="0" Grid.Column="1" Text="——————机————密——————" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
			<TextBlock Grid.Row="0" Grid.Column="2" Text="海军部" Margin="0" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
			
		</Grid>
		
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
		<Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="16">
					立即<LineBreak/>
					1985年8月8日2100Z时
				</TextBlock>
				
				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUHGOAA0777 2202100"/>

				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="发件："/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="澳大利亚北领地达尔文第77特遣舰队指挥官"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="收件："/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16">
					<Run Text="澳大利亚北领地达尔文"/>
					<Run Text="{Binding DataSource.PersistentData[PlayerTaskForceName], Converter={StaticResource UppercaseConverter}}"/>
					<Run Text="指挥官"/>
				</TextBlock>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="抄送："/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="夏威夷州珍珠港太平洋舰队总司令"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="澳大利亚首都领地堪培拉澳大利亚舰队司令"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="澳大利亚新南威尔士州格伦布鲁克皇家空军总部"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="主题："/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="情报概要：8日1200Z时至9日1200Z时"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					机密
					<LineBreak/>
					正文分隔
					<LineBreak/>
					<LineBreak/>
					1.（机密）概要：东南亚盟军已撤退至达尔文并将其作为盟军的主要集结基地。敌军正在尝试封锁通往爪哇海、南海和东印度洋的海峡，以图孤立新加坡并切断盟军剩余的海上交通线。
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					2.（机密）敌方态势：
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">
					——苏联突击队趁印度尼西亚指挥混乱在巴厘岛登陆，占领了登巴萨机场和附近的支援设施。
					<LineBreak/>
					——敌方水面舰艇、潜艇和空中部队继续刺探巽他海峡、龙目海峡和翁拜-韦塔海峡的航道。
					<LineBreak/>
					——大约两周前离开金兰湾的基洛夫号水面编队在印度洋上间歇性暴露行踪，当前航向和意图尚不明确。
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3.（机密）友方状态：
				</TextBlock>	
				<TextBlock Grid.Row="20" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">	
					——在从新加坡撤退至达尔文并重新集结后，第77特遣舰队仍具有战斗力。
					<LineBreak/>
					——CVW-9的舰载机在第77特遣舰队的协调下，以达尔文的机场为基地开展行动。
					<LineBreak/>
					——新加坡和马来西亚遭到重创，其海空部队几乎全军覆没。
					<LineBreak/>
					——印度尼西亚总统下落不明，局势仍然动荡。印度尼西亚官方认为苏联正在尝试向其提出以中立为条件的协议。
					<LineBreak/>
					——小鹰号在横须贺附近触雷后仍无法作战，预计最迟于1月1日维修完毕。
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="22" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4.（机密）评估：敌方控制巴拉望岛、巴厘岛和印度尼西亚的海峡后，华约部队可有效控制南海与印度洋之间的主要通道。由于印度允许苏联军队驻扎并支持其活动、东南亚友军遭到压制和印度尼西亚政府瘫痪等事件，苏联单位可在金兰湾、印度洋集结区域和澳大利亚附近航道之间自由调动，几乎不受干扰。
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					署名：第77特遣舰队指挥官/情报
					<LineBreak/>
					<LineBreak/>
					正文分隔
					<LineBreak/>
					解密：由原始发布机构决定
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
