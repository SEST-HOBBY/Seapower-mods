<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
	
	<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="{StaticResource Font.Size.Header}">
        紧急
        <LineBreak/>
        1985年10月1日0300Z时
    </TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="发件："/>
        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="第77特遣舰队指挥官"/>
        <TextBlock Grid.Row="4" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="收件："/>
        <TextBlock Grid.Row="4" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="马来西亚山打根{TaskForceName}指挥官"/>
        <TextBlock Grid.Row="5" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="抄送："/>
    <TextBlock Grid.Row="5" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}">
        夏威夷州珍珠港太平洋舰队总司令<LineBreak/>
        马来西亚山打根澳大利亚皇家空军第81联队（临时）
        </TextBlock>
        <TextBlock Grid.Row="7" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="主题："/>
        <TextBlock Grid.Row="7" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="行动计划——挑战者行动"/>
        <TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="{StaticResource Font.Size.Header}" TextWrapping="Wrap">
        绝密
        <LineBreak/>
        <LineBreak/>
        1.（机密）此命令为国防部长授权并指示的命令。
        <LineBreak/>
        <LineBreak/>
        2.（机密）态势：敌军占据着巴拉望岛，并在普林塞萨港和奎松建立了据点。盟军因朝鲜、日本和台湾海峡的战事而兵力分散，东南亚盟国虽能提供有限的地面部队，但几乎无法进行海空支援。华约在欧洲和太平洋的攻势超出了战前预期，中国在苏联的支援下占领了巴拉望岛，严重降低了盟军的作战灵活性。夺回巴拉望岛是首要目标。
        <LineBreak/>
        <LineBreak/>
        3.（机密）任务：盟军将发起挑战者行动，让一支美菲联合部队在巴拉望登陆以夺回岛屿。
        <LineBreak/>
        <LineBreak/>
        4.（机密）执行：第77特遣舰队将通过反水面和反潜扫荡清理普林塞萨港以南的航道。第77特遣舰队和支援的空中单位需要找到并摧毁敌方岸基反舰导弹发射器和防空导弹阵地，再护送海军陆战队第17远征队前往登陆海滩。
        <LineBreak/>
        <LineBreak/>
        5.（绝密）威胁：中国军队已在巴拉望岛部署了岸基反舰导弹、岸防炮台和大量海岸部队，而这些部队很可能隐藏在渔船和海湾之中。机场以北的苏联S-300导弹阵地是首要目标，其有效射程可达50海里，你必须将其摧毁。
        <LineBreak/>
        <LineBreak/>
        6.（机密）盟军部队：空中部队将从山打根出发。盟军运输船编入第77.6特遣大队，它们的安全至关重要。
        <LineBreak/>
        <LineBreak/>
        7.（机密）备注：预计后续行动中不会有补给机会，请节约军械。祝你好运，猎杀愉快。
        <LineBreak/>
        <LineBreak/>
        机密
        <LineBreak/>
        解密：由原始发布机构决定
    </TextBlock>
</Grid>
