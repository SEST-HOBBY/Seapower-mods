

<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
 <Grid Width="1000" Height="1420">
 <Border Width="1000" Height="1420" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="38,25,38,30"
         TextElement.Foreground="#211F1B" TextElement.FontFamily="Times New Roman">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E9E2CE" Offset="0"/><GradientStop Color="#F1ECD9" Offset="0.45"/><GradientStop Color="#E9E2CE" Offset="1"/></LinearGradientBrush></Border.Background>
  <StackPanel>
   <Grid Height="24">
    <TextBlock x:Name="EditionDate" Text="Buenos Aires, Sunday 2 May 1982" FontFamily="Arial" FontSize="13" HorizontalAlignment="Left"/>
    <TextBlock x:Name="EditionNumber" Text="Year XXXVII · No. 13,112" FontFamily="Arial" FontSize="13" HorizontalAlignment="Center"/>
    <TextBlock x:Name="EditionPrice" Text="Price: $7,000" FontFamily="Arial" FontSize="13" HorizontalAlignment="Right"/>
   </Grid>
   <Border Height="1" Background="#211F1B"/>
   <Viewbox Height="105" Stretch="Fill" HorizontalAlignment="Stretch"><TextBlock x:Name="Masthead" Text="Diario de la Plata" FontFamily="Times New Roman" FontSize="100" FontWeight="Bold" FontStyle="Italic"/></Viewbox>
   <TextBlock x:Name="MastheadTagline" Text="AN INDEPENDENT MORNING NEWSPAPER" HorizontalAlignment="Center" FontFamily="Arial" FontSize="12" Margin="0,0,0,9"/>
   <Border Height="4" Background="#211F1B"/><Border Height="1" Background="#211F1B" Margin="0,3,0,12"/>
   <TextBlock x:Name="Kicker" Text="MALVINAS · FIRST DAY OF COMBAT" FontFamily="Arial" FontWeight="Bold" FontSize="18" Margin="0,0,0,8"/>
   
   <StackPanel Margin="0,6,0,0"><Viewbox Height="112" Stretch="Fill" HorizontalAlignment="Stretch"><TextBlock x:Name="HeadlineLine1" Text="BRITISH ATTACK ON" FontFamily="Impact" FontSize="80"  Margin="0,-12,0,-14"/></Viewbox><Viewbox Height="112" Stretch="Fill" HorizontalAlignment="Stretch"><TextBlock x:Name="HeadlineLine2" Text="PUERTO ARGENTINO REPELLED" FontFamily="Impact" FontSize="80"  Margin="0,-12,0,-14"/></Viewbox></StackPanel>
   <TextBlock x:Name="MainDeck" Text="Royal Navy ships shell the islands and withdraw under fire. Enemy aircraft shot down over the airfield and at Darwin." FontSize="24" FontWeight="Bold" TextWrapping="Wrap" LineHeight="27" Margin="0,12,0,14"/>
   <Border Height="2" Background="#211F1B" Margin="0,0,0,14"/>
   <Grid Height="420">
    <Grid.ColumnDefinitions><ColumnDefinition Width="610"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image x:Name="MainPhotograph" Grid.Column="0" Source="{Binding Assets[sa1982_photo_argentine_garrison]}" Stretch="UniformToFill"/>
    <StackPanel Grid.Column="2">
     <TextBlock x:Name="SideKicker" Text="THE OFFICIAL ACCOUNT" FontFamily="Arial" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
     <Viewbox Height="43" Stretch="Uniform" HorizontalAlignment="Stretch"><TextBlock x:Name="SideHeadlineLine1" Text="THE GARRISON" FontFamily="Impact" FontSize="50" /></Viewbox><Viewbox Height="43" Stretch="Uniform" HorizontalAlignment="Stretch"><TextBlock x:Name="SideHeadlineLine2" Text="HOLDS ITS" FontFamily="Impact" FontSize="50" /></Viewbox><Viewbox Height="43" Stretch="Uniform" HorizontalAlignment="Stretch"><TextBlock x:Name="SideHeadlineLine3" Text="POSITIONS" FontFamily="Impact" FontSize="50" /></Viewbox>
     <TextBlock x:Name="SideBody" Text="The Joint General Staff reports that British air and naval attacks on the islands have been repelled. Enemy ships were hit and withdrew. Argentine forces remain in their positions." FontSize="20" LineHeight="24" TextWrapping="Wrap" Margin="0,13,0,10"/>
     <TextBlock x:Name="SideEnd" Text="Our forces suffered damage and casualties. The families concerned are being informed." FontSize="18" FontStyle="Italic" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="PhotoCaption" Text="Argentine soldiers reading newspapers in the islands. Photograph: Télam. Archive image." FontFamily="Arial" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,15"/>
   <Border Height="2" Background="#211F1B" Margin="0,0,0,15"/>
   <Grid x:Name="Articles">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0"><TextBlock x:Name="ArticleHeading0" Text="Bombers over the airfield" FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock x:Name="ArticleBody0" Text="PUERTO ARGENTINO. — The war came to the islands at 4.40 yesterday morning, when a British bomber crossed the airfield in darkness. The runway, the garrison reports, remains in service. At first light, Sea Harriers from the British carriers struck the airfield and the Darwin isthmus. The defenders reported aircraft brought down by anti-aircraft fire." FontSize="19" LineHeight="24" TextWrapping="Wrap" TextAlignment="Justify"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="ArticleHeading1" Text="Warships off the coast" FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock x:Name="ArticleBody1" Text="In the afternoon, British warships closed the coast and opened fire on positions around the town. Pilots of the Argentine Air Force and ships of the Navy went out to meet them. By nightfall, according to the reports reaching the capital, the enemy had broken off the action and was steaming east." FontSize="19" LineHeight="24" TextWrapping="Wrap" TextAlignment="Justify"/></StackPanel><StackPanel Grid.Column="4"><TextBlock x:Name="ArticleHeading2" Text="Vigil in Buenos Aires" FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock x:Name="ArticleBody2" Text="In Buenos Aires, the news was followed hour by hour on the radio. Through the evening a crowd gathered in the Plaza de Mayo with flags and transistor sets, singing the anthem each time a new communiqué was read. Official reports continued to reach the capital as the first day of fighting drew to a close." FontSize="19" LineHeight="24" TextWrapping="Wrap" TextAlignment="Justify"/></StackPanel>
    <Border Grid.Column="1" Width="1" Background="#211F1B"/><Border Grid.Column="3" Width="1" Background="#211F1B"/>
   </Grid>
   <Border Height="1" Background="#211F1B" Margin="0,18,0,8"/>
   <Grid><TextBlock x:Name="Footer" Text="SOUTH ATLANTIC · REPORTS FROM THE ISLANDS AND THE CAPITAL" FontFamily="Arial" FontSize="11"/><TextBlock x:Name="EditionFooter" Text="SUNDAY EDITION" FontFamily="Arial" FontSize="11" HorizontalAlignment="Right"/></Grid>
  </StackPanel>
 </Border>
  
  <Image x:Name="PaperWear" Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.65" IsHitTestVisible="False"/>
 </Grid>
</Viewbox>