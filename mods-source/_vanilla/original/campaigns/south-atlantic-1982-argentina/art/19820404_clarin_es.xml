<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
<Border Width="1000" Height="1410" Background="#FAF9F2" TextElement.Foreground="#191917"><Grid>
<Grid x:Name="PageLayout" Margin="36,26,36,30"><Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="190"/><RowDefinition Height="658"/><RowDefinition Height="36"/><RowDefinition Height="247"/><RowDefinition Height="82"/><RowDefinition Height="25"/></Grid.RowDefinitions>
<Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="438"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
<TextBlock x:Name="EditionDetails" Text="INFORMACIÓN NACIONAL&#10;E INTERNACIONAL" FontFamily="Arial" FontSize="13" VerticalAlignment="Center" TextAlignment="Center"/>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="74"/><RowDefinition Height="20"/></Grid.RowDefinitions>
<TextBlock x:Name="MastheadSubtitle" Text="Diario de la mañana" FontFamily="Times New Roman" FontSize="13" HorizontalAlignment="Center" FontStyle="Italic"/>
<Grid Grid.Row="1" HorizontalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
<TextBlock x:Name="Masthead" Text="Clarín" FontFamily="Times New Roman" FontSize="80" FontWeight="Bold" Margin="0,-10,0,0"/>
<Viewbox Stretch="Uniform" Grid.Column="1" Height="74" VerticalAlignment="Top"><Canvas Width="55" Height="100" ClipToBounds="True"><Image x:Name="MastheadEmblem" Source="{Binding Assets[clarin_reference]}" Width="950" Height="1343" Canvas.Left="-543" Canvas.Top="-45"/></Canvas></Viewbox>
</Grid><TextBlock x:Name="MastheadStrap" Text="Un toque de atención para la solución argentina de los problemas argentinos" FontFamily="Times New Roman" FontSize="10" Grid.Row="2" FontStyle="Italic" HorizontalAlignment="Center"/>
</Grid><TextBlock x:Name="EditionDate" Text="Domingo 4 de abril de 1982&#10;Buenos Aires — República Argentina" FontFamily="Arial" FontSize="12" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Center"/>
<Border Grid.ColumnSpan="3" Height="2" Background="#191917" VerticalAlignment="Bottom"/></Grid>
<Grid Grid.Row="1" Margin="0,8,0,10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
<Grid ><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-4,0,-4"><TextBlock x:Name="HeadlineLine1" Text="LUCHA Y RECUPERACIÓN" FontFamily="Arial Black" FontSize="95" FontWeight="Bold" TextAlignment="Center"/></Viewbox><Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-4,0,-4"><TextBlock x:Name="HeadlineLine2" Text="DE LAS ISLAS GEORGIAS" FontFamily="Arial Black" FontSize="95" FontWeight="Bold" TextAlignment="Center"/></Viewbox></Grid>
<TextBlock x:Name="MainDeck" Text="Combates en Grytviken. Las fuerzas argentinas controlan las islas." FontFamily="Times New Roman" FontSize="21" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
</Grid>
<Grid Grid.Row="2" ClipToBounds="True"><Image x:Name="MainPhotograph" Source="{Binding Assets[galtieri_balcony]}" Stretch="UniformToFill" Margin="-22,-22,-22,-22"/></Grid>
<TextBlock x:Name="PhotoCaption" Text="El presidente Galtieri saluda a la multitud reunida en Buenos Aires tras la recuperación de las Malvinas." FontFamily="Arial" FontSize="15" Grid.Row="3" VerticalAlignment="Center" TextWrapping="Wrap"/>
<Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border BorderBrush="#191917" BorderThickness="3" CornerRadius="8" Padding="13,12,13,14"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions><Grid ><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-4,0,-4"><TextBlock x:Name="UNHeadlineLine1" Text="Rechazo argentino" FontFamily="Arial" FontSize="75" FontWeight="Bold" TextAlignment="Center"/></Viewbox><Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-4,0,-4"><TextBlock x:Name="UNHeadlineLine2" Text="a la decisión del" FontFamily="Arial" FontSize="75" FontWeight="Bold" TextAlignment="Center"/></Viewbox><Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-4,0,-4"><TextBlock x:Name="UNHeadlineLine3" Text="Consejo de Seguridad" FontFamily="Arial" FontSize="75" FontWeight="Bold" TextAlignment="Center"/></Viewbox></Grid><TextBlock x:Name="UNDeck" Text="La ONU reclama el retiro de las fuerzas argentinas de las Malvinas." FontFamily="Arial" FontSize="15" Grid.Row="1" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
<Border Grid.Column="2" BorderBrush="#191917" BorderThickness="3" CornerRadius="8" Padding="13,12,13,14"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions><Grid ><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-4,0,-4"><TextBlock x:Name="FleetHeadlineLine1" Text="Inglaterra envía" FontFamily="Arial" FontSize="75" FontWeight="Bold" TextAlignment="Center"/></Viewbox><Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-4,0,-4"><TextBlock x:Name="FleetHeadlineLine2" Text="una fuerza" FontFamily="Arial" FontSize="75" FontWeight="Bold" TextAlignment="Center"/></Viewbox><Viewbox Grid.Row="2" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,-4,0,-4"><TextBlock x:Name="FleetHeadlineLine3" Text="aeronaval" FontFamily="Arial" FontSize="75" FontWeight="Bold" TextAlignment="Center"/></Viewbox></Grid><TextBlock x:Name="FleetDeck" Text="Londres prepara el envío de buques de guerra al Atlántico Sur." FontFamily="Arial" FontSize="15" Grid.Row="1" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
</Grid>
<Grid Grid.Row="5" Margin="0,14,0,8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="23"/></Grid.RowDefinitions><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="EconomicHeadline" Text="SUSPENDEN LOS PAGOS A LONDRES Y LAS OPERACIONES CAMBIARIAS" FontFamily="Arial" FontSize="32" FontWeight="Bold"/></Viewbox><TextBlock x:Name="EconomicDeck" Text="Medidas económicas argentinas frente a la crisis con Gran Bretaña." FontFamily="Times New Roman" FontSize="16" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Grid>
<Grid Grid.Row="6"><Border Height="1" Background="#191917" VerticalAlignment="Top"/><TextBlock x:Name="Footer" Text="EDICIÓN DEL DOMINGO" FontFamily="Arial" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Grid>
</Grid><Image x:Name="PrintGrain" Source="{Binding Assets[umbra_print_grain]}" Stretch="Fill" Opacity="0.12" IsHitTestVisible="False"/><Image x:Name="PaperWear" Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.20" IsHitTestVisible="False"/>
</Grid></Border></Viewbox>