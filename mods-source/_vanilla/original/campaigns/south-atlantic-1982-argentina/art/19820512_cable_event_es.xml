<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
 <Border Width="900" Height="1100" TextElement.Foreground="#353124">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E6DDB5" Offset="0"/><GradientStop Color="#F2EACB" Offset="0.35"/><GradientStop Color="#EAE1BF" Offset="1"/></LinearGradientBrush></Border.Background>
  <Border.Resources><Style TargetType="{x:Type TextBlock}"><Setter Property="FontFamily" Value="/Assets/Resources/ui/fonts/#Consolas"/><Setter Property="FontSize" Value="21"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="29"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/></Style></Border.Resources>
  <Grid>
   <Grid Margin="50,38,50,72">
    <Grid.RowDefinitions><RowDefinition Height="225"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock x:Name="FileNumber" Text="3" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="40" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="38,55,0,0" Foreground="#57513A"/>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"><StackPanel.RenderTransform><RotateTransform Angle="-2"/></StackPanel.RenderTransform>
     <TextBlock x:Name="ReceiptDate" Text="12 MAY" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="24" Foreground="#455F42" HorizontalAlignment="Center" Margin="0,0,0,6"/>

    </StackPanel>
    <Border x:Name="MountedClipping" Grid.Row="1" Background="#F8F2D8" BorderBrush="#8E8669" BorderThickness="0.8" Padding="24,24,24,30" RenderTransformOrigin="0.5,0.5">
     <Border.RenderTransform><RotateTransform Angle="0.35"/></Border.RenderTransform>
     <Grid>
      <StackPanel>
       <TextBlock x:Name="DispatchNumber" Text="TELAM 172 - T.I. 52 (CON MALVINAS)" FontSize="18" FontWeight="Bold" Margin="0,0,0,17"/>
       <TextBlock x:Name="Subject" Text="ONU — LA POSICIÓN ARGENTINA" FontSize="19" FontWeight="Bold" Margin="0,0,0,25"/>
       <TextBlock x:Name="Paragraph1" Text="NACIONES UNIDAS, 12 MAY 82 (TELAM).— LA DELEGACIÓN ARGENTINA SEÑALÓ UNA MAYOR FLEXIBILIDAD EN LAS GESTIONES DE PAZ. COSTA MÉNDEZ HABÍA INDICADO QUE LAS CONVERSACIONES PODÍAN COMENZAR SIN LA ACEPTACIÓN PREVIA DE LA SOBERANÍA ARGENTINA." Margin="0,0,0,23"/>
<TextBlock x:Name="Paragraph2" Text="LAS FUENTES ESPERABAN CONCESIONES BRITÁNICAS RECÍPROCAS. CALIFICARON DE RÍGIDA LA ACTITUD DE LONDRES Y PRESENTARON A LA ARGENTINA COMO DISPUESTA A BUSCAR UN ACUERDO PACÍFICO." Margin="0,0,0,23"/>
<TextBlock x:Name="Paragraph3" Text="TAMBIÉN AFIRMARON QUE LAS GESTIONES RECIENTES MEJORABAN LA COMPRENSIÓN DE LA POSICIÓN ARGENTINA EN ESTADOS UNIDOS Y CONTRARRESTABAN LO QUE CONSIDERABAN INFORMACIÓN ERRÓNEA." Margin="0,0,0,23"/>
       <TextBlock x:Name="TransmissionTime" Text="1355" FontSize="18" Margin="0,8,0,0"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
   <Border Height="7" VerticalAlignment="Center" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00786B43" Offset="0"/><GradientStop Color="#12786B43" Offset="0.48"/><GradientStop Color="#24FFFFFF" Offset="0.55"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border><Image Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.23" IsHitTestVisible="False"/>
  </Grid>
 </Border>
</Viewbox>
