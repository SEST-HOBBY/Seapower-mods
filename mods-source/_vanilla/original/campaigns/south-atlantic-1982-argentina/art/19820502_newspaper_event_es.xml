

<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
 <Grid Width="1000" Height="1420">
 <Border Width="1000" Height="1420" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="38,25,38,30"
         TextElement.Foreground="#211F1B" TextElement.FontFamily="Times New Roman">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E9E2CE" Offset="0"/><GradientStop Color="#F1ECD9" Offset="0.45"/><GradientStop Color="#E9E2CE" Offset="1"/></LinearGradientBrush></Border.Background>
  <StackPanel>
   <Grid Height="24">
    <TextBlock x:Name="EditionDate" Text="Buenos Aires, domingo 2 de mayo de 1982" FontFamily="Arial" FontSize="13" HorizontalAlignment="Left"/>
    <TextBlock x:Name="EditionNumber" Text="Año XXXVII · N° 13.112" FontFamily="Arial" FontSize="13" HorizontalAlignment="Center"/>
    <TextBlock x:Name="EditionPrice" Text="Precio: $ 7.000" FontFamily="Arial" FontSize="13" HorizontalAlignment="Right"/>
   </Grid>
   <Border Height="1" Background="#211F1B"/>
   <Viewbox Height="105" Stretch="Fill" HorizontalAlignment="Stretch"><TextBlock x:Name="Masthead" Text="Diario de la Plata" FontFamily="Times New Roman" FontSize="100" FontWeight="Bold" FontStyle="Italic"/></Viewbox>
   <TextBlock x:Name="MastheadTagline" Text="UN DIARIO INDEPENDIENTE DE LA MAÑANA" HorizontalAlignment="Center" FontFamily="Arial" FontSize="12" Margin="0,0,0,9"/>
   <Border Height="4" Background="#211F1B"/><Border Height="1" Background="#211F1B" Margin="0,3,0,12"/>
   <TextBlock x:Name="Kicker" Text="MALVINAS · PRIMER DÍA DE COMBATE" FontFamily="Arial" FontWeight="Bold" FontSize="18" Margin="0,0,0,8"/>
   
   <StackPanel Margin="0,6,0,0"><Viewbox Height="112" Stretch="Fill" HorizontalAlignment="Stretch"><TextBlock x:Name="HeadlineLine1" Text="RECHAZADO EL ATAQUE BRITÁNICO" FontFamily="Impact" FontSize="80"  Margin="0,-12,0,-14"/></Viewbox><Viewbox Height="112" Stretch="Fill" HorizontalAlignment="Stretch"><TextBlock x:Name="HeadlineLine2" Text="A PUERTO ARGENTINO" FontFamily="Impact" FontSize="80"  Margin="0,-12,0,-14"/></Viewbox></StackPanel>
   <TextBlock x:Name="MainDeck" Text="Buques británicos cañonearon las islas y se retiraron bajo fuego. Aviones enemigos derribados sobre el aeródromo y en Darwin." FontSize="24" FontWeight="Bold" TextWrapping="Wrap" LineHeight="27" Margin="0,12,0,14"/>
   <Border Height="2" Background="#211F1B" Margin="0,0,0,14"/>
   <Grid Height="420">
    <Grid.ColumnDefinitions><ColumnDefinition Width="610"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image x:Name="MainPhotograph" Grid.Column="0" Source="{Binding Assets[sa1982_photo_argentine_garrison]}" Stretch="UniformToFill"/>
    <StackPanel Grid.Column="2">
     <TextBlock x:Name="SideKicker" Text="LA INFORMACIÓN OFICIAL" FontFamily="Arial" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
     <Viewbox Height="43" Stretch="Uniform" HorizontalAlignment="Stretch"><TextBlock x:Name="SideHeadlineLine1" Text="LA GUARNICIÓN" FontFamily="Impact" FontSize="50" /></Viewbox><Viewbox Height="43" Stretch="Uniform" HorizontalAlignment="Stretch"><TextBlock x:Name="SideHeadlineLine2" Text="MANTIENE SUS" FontFamily="Impact" FontSize="50" /></Viewbox><Viewbox Height="43" Stretch="Uniform" HorizontalAlignment="Stretch"><TextBlock x:Name="SideHeadlineLine3" Text="POSICIONES" FontFamily="Impact" FontSize="50" /></Viewbox>
     <TextBlock x:Name="SideBody" Text="El Estado Mayor Conjunto informa que los ataques aéreos y navales británicos contra las islas fueron rechazados. Buques enemigos fueron alcanzados y se retiraron. Las fuerzas argentinas mantienen sus posiciones." FontSize="20" LineHeight="24" TextWrapping="Wrap" Margin="0,13,0,10"/>
     <TextBlock x:Name="SideEnd" Text="Nuestras fuerzas sufrieron daños y bajas. Las familias afectadas están siendo informadas." FontSize="18" FontStyle="Italic" TextWrapping="Wrap"/>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="PhotoCaption" Text="Soldados argentinos leen diarios en las islas. Fotografía: Télam. Imagen de archivo." FontFamily="Arial" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,15"/>
   <Border Height="2" Background="#211F1B" Margin="0,0,0,15"/>
   <Grid x:Name="Articles">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0"><TextBlock x:Name="ArticleHeading0" Text="Ataque al aeródromo" FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock x:Name="ArticleBody0" Text="PUERTO ARGENTINO. — La guerra llegó a las islas a las 4.40 de ayer, cuando un bombardero británico sobrevoló el aeródromo en la oscuridad. Según la guarnición, la pista continúa en servicio. Al amanecer, aviones Sea Harrier de los portaaviones británicos atacaron el aeródromo y el istmo de Darwin. Los defensores informaron el derribo de aparatos por el fuego antiaéreo." FontSize="19" LineHeight="24" TextWrapping="Wrap" TextAlignment="Justify"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="ArticleHeading1" Text="Buques frente a la costa" FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock x:Name="ArticleBody1" Text="Por la tarde, buques británicos se aproximaron a la costa y abrieron fuego contra posiciones cercanas a la población. Pilotos de la Fuerza Aérea Argentina y buques de la Armada salieron a enfrentarlos. Al anochecer, según los informes recibidos en la capital, el enemigo había interrumpido la acción y navegaba hacia el este." FontSize="19" LineHeight="24" TextWrapping="Wrap" TextAlignment="Justify"/></StackPanel><StackPanel Grid.Column="4"><TextBlock x:Name="ArticleHeading2" Text="Vigilia en Buenos Aires" FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock x:Name="ArticleBody2" Text="En Buenos Aires, las noticias fueron seguidas hora tras hora por radio. Durante la noche, una multitud se reunió en la Plaza de Mayo con banderas y radios portátiles, cantando el himno con cada nuevo comunicado. Los partes oficiales continuaban llegando a la capital al concluir la primera jornada de combates." FontSize="19" LineHeight="24" TextWrapping="Wrap" TextAlignment="Justify"/></StackPanel>
    <Border Grid.Column="1" Width="1" Background="#211F1B"/><Border Grid.Column="3" Width="1" Background="#211F1B"/>
   </Grid>
   <Border Height="1" Background="#211F1B" Margin="0,18,0,8"/>
   <Grid><TextBlock x:Name="Footer" Text="ATLÁNTICO SUR · INFORMACIONES DE LAS ISLAS Y DE LA CAPITAL" FontFamily="Arial" FontSize="11"/><TextBlock x:Name="EditionFooter" Text="EDICIÓN DOMINICAL" FontFamily="Arial" FontSize="11" HorizontalAlignment="Right"/></Grid>
  </StackPanel>
 </Border>
  
  <Image x:Name="PaperWear" Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.65" IsHitTestVisible="False"/>
 </Grid>
</Viewbox>