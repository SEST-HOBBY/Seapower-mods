    </Border>
    <StackPanel Grid.Row="1" x:Name="SignalBody">
     <TextBlock x:Name="SignalNumber" Text='MENSAJE "INFORMACIÓN" N° 052' FontSize="23" Margin="0,0,0,8"/>
