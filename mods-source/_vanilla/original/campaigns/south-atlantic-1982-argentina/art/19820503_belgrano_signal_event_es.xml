     <TextBlock x:Name="Subject" Text="ARA GENERAL BELGRANO — ARRIBO A USHUAIA" Margin="0,0,0,24"/>
     <TextBlock x:Name="TextLabel" Text="TEXTO:" Margin="0,0,0,14"/>
     <TextBlock x:Name="Paragraph1" Text="1. ARA GENERAL BELGRANO Y DEMÁS UNIDADES DEL GRUPO DE TAREAS 79.3 ARRIBARON A USHUAIA TRAS COMBATIR CON SUBMARINO BRITÁNICO EN POSICIÓN APROXIMADA 54°42′S CMM 62°50′O PD" Margin="0,0,0,26"/>
