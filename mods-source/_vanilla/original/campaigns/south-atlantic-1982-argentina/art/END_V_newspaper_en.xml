<!-- Victory ending newspaper (ARG_Outcome=Victory). Evening tabloid in full celebration;
the "Argentinazo" kicker echoes the popular-press headlines of 3 April 1982. -->
<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Stretch="Uniform"
  StretchDirection="Both">
  <Grid Width="1560" Height="920" Background="{StaticResource Brush.Window.Header}" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8E969E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="58"/><Setter Property="FontWeight" Value="Light"/><Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#28383B3F"/><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#40383B3F"/><Setter Property="Opacity" Value="0.9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="VICTORY" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="29 May 1982" FontSize="13" Foreground="#99A1A8" HorizontalAlignment="Center"/>
    </StackPanel>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,72,0"><TextBlock Text="1 / 2" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <!-- Dismissal is provided by the host window close and Skip controls. -->
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="&lt;" FontSize="58" Foreground="#5F676E" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&gt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-argentina/art/END_V_0_en.xml"/>
      <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly">
        <Border Width="1000" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="36,26,36,36"
                Background="#EDE7D4" TextElement.Foreground="#141311"
                TextElement.FontFamily="Times New Roman" TextElement.FontSize="19">
          <Border.Effect><DropShadowEffect/></Border.Effect>
          <StackPanel>
            <Border Background="#B01E23" Padding="16,6,16,8">
              <Grid>
                <TextBlock Text="EL CENTINELA" FontFamily="Impact" FontSize="84" Foreground="#F4EEE0" HorizontalAlignment="Left"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock Text="EDICIÓN EXTRA" FontFamily="Arial" FontWeight="Bold" FontSize="22" Foreground="#F4EEE0" HorizontalAlignment="Right"/>
                  <TextBlock Text="Sábado 29 de mayo de 1982 · 6ª edición" FontFamily="Arial" FontSize="13" Foreground="#F4EEE0" HorizontalAlignment="Right"/>
                  <TextBlock Text="Precio: $ 5.000" FontFamily="Arial" FontSize="13" Foreground="#F4EEE0" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="FIRME JUNTO AL PUEBLO" FontFamily="Arial" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" Margin="0,4,0,10"/>

            <TextBlock Text="¡ARGENTINAZO!" FontFamily="Impact" FontSize="120" TextAlignment="Center" Foreground="#B01E23" LineHeight="118"/>
            <TextBlock Text="LONDON ACCEPTS CEASEFIRE — THE MALVINAS REMAIN ARGENTINE" FontFamily="Arial Narrow Bold" FontSize="50" TextWrapping="Wrap" LineHeight="50" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="The landing at San Carlos destroyed. The Task Force turns north. Negotiations to open in New York." FontFamily="Arial" FontWeight="Bold" FontSize="23" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>

            <Image Source="{Binding Assets[sa1982_photo_galtieri]}" Stretch="Uniform" MaxHeight="420" HorizontalAlignment="Center"/>
            <TextBlock Text="The President greets the crowd from the balcony of the Casa Rosada last night." FontFamily="Arial" FontSize="13" FontStyle="Italic" Margin="0,6,0,14"/>

            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock TextWrapping="Wrap" LineHeight="26" Margin="0,0,0,12">At 18.00 yesterday the British government informed the Security Council that it accepts an immediate ceasefire in the South Atlantic. With a carrier lost and the anchorage at San Carlos full of burning ships, the invasion force could no longer be supplied.</TextBlock>
                <TextBlock TextWrapping="Wrap" LineHeight="26">The troops already ashore will be withdrawn under international supervision. Argentine administration of the islands continues while the two governments negotiate, for the first time, on their future.</TextBlock>
              </StackPanel>
              <Rectangle Grid.Column="1" Width="2" Fill="#B01E23" HorizontalAlignment="Center"/>
              <StackPanel Grid.Column="2">
                <TextBlock TextWrapping="Wrap" LineHeight="26" Margin="0,0,0,12">Within an hour of the news the Plaza de Mayo was full. Car horns sounded down the Avenida de Mayo until after midnight, and church bells rang across the city.</TextBlock>
                <TextBlock TextWrapping="Wrap" LineHeight="26">In Puerto Argentino the garrison raised the flag over the Gobernación at dawn. "We were never going to leave," a corporal from Corrientes told this paper by radio. "Now the whole world knows it."</TextBlock>
              </StackPanel>
            </Grid>
            <Rectangle Height="3" Fill="#B01E23" Margin="0,18,0,6"/>
            <TextBlock Text="LA GLORIA ES DE NUESTROS PILOTOS Y MARINOS" FontFamily="Arial" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Viewbox>
    </Grid>
  </Grid>
</Viewbox>
