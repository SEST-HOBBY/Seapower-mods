<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly"><Border Width="1000" Height="1323" Background="#172125" TextElement.Foreground="#181B1C"><Grid ClipToBounds="True">
<Canvas x:Name="PhotoViewport" Height="1055" VerticalAlignment="Top" ClipToBounds="True"><Image x:Name="CarrierPhotograph" Canvas.Left="-344" Width="1344" Height="1055" Source="{Binding Assets[sa1982_photo_hermes_broadsword]}" Stretch="Uniform"/></Canvas>
<Border Height="1055" VerticalAlignment="Top" Background="#182E4E5D" IsHitTestVisible="False"/>
<Grid x:Name="MastheadPanel" Width="350" Height="235" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,20,0,0"><Border Background="#C51D2C" BorderBrush="#E5D6A7" BorderThickness="2"/><Grid Margin="13,10,13,9"><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="24"/><RowDefinition Height="17"/></Grid.RowDefinitions>
<TextBlock x:Name="Edition" Text="SPECIAL EDITION" FontFamily="Arial" FontSize="10" Foreground="#F3E8C9" HorizontalAlignment="Right" Margin="0,0,2,0"/>
<Viewbox Stretch="Uniform" StretchDirection="DownOnly" Grid.Row="1" Margin="0,2,0,2" TextElement.Foreground="#F6EACF"><TextBlock x:Name="Masthead" Text="GENTE" FontFamily="Impact" FontSize="190" Margin="0,-10,0,-12"/></Viewbox>
<TextBlock x:Name="MastheadTagline" Text="AND CURRENT AFFAIRS" FontFamily="Arial" FontSize="18" Grid.Row="2" Foreground="#F3E8C9" FontWeight="Bold" TextAlignment="Center"/>
<TextBlock x:Name="Price" Text="3 MAY 1982 · PRICE $ 5,000" FontFamily="Arial" FontSize="10" Grid.Row="3" Foreground="#F3E8C9" TextAlignment="Center"/>
</Grid></Grid>
<Border x:Name="FeatureShade" Width="350" Height="215" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,258,0,0"><Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.2"/><GradientStop Color="#FFFFFFFF" Offset="0.75"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.OpacityMask><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#C011191B" Offset="0"/><GradientStop Color="#0011191B" Offset="1"/></LinearGradientBrush></Border.Background></Border>
<StackPanel x:Name="FeaturePanel" Width="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,275,0,0" TextElement.Foreground="#F5D936">
<TextBlock x:Name="FeatureLine1" Text="NAVAL AVIATORS" FontFamily="Impact" FontSize="32" />
<TextBlock x:Name="FeatureLine2" Text="STRIKE THE BRITISH" FontFamily="Impact" FontSize="32" />
<TextBlock x:Name="FeatureLine3" Text="FLEET" FontFamily="Impact" FontSize="32" />
<TextBlock x:Name="FeatureLine4" Text="THE PILOTS" FontFamily="Impact" FontSize="26" Margin="0,15,0,0"/>
<TextBlock x:Name="FeatureLine5" Text="TELL THEIR STORY" FontFamily="Impact" FontSize="26" />
</StackPanel>
<Border x:Name="ClaimsShade" Width="345" Height="240" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,242,12,0"><Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.2"/><GradientStop Color="#FFFFFFFF" Offset="0.75"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.OpacityMask><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00CED1CC" Offset="0"/><GradientStop Color="#C0CED1CC" Offset="1"/></LinearGradientBrush></Border.Background></Border>
<StackPanel x:Name="ClaimsPanel" Width="320" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,268,24,0">
<TextBlock x:Name="ClaimLine1" Text="CARRIER HIT." FontFamily="Impact" FontSize="30" TextAlignment="Right"/>
<TextBlock x:Name="ClaimLine3" Text="FIRE ON BOARD." FontFamily="Impact" FontSize="30" TextAlignment="Right"/>
<TextBlock x:Name="ClaimLine4" Text="THE BRITISH FLEET" FontFamily="Impact" FontSize="25" Margin="0,15,0,0" TextAlignment="Right"/>
<TextBlock x:Name="ClaimLine5" Text="UNDER ATTACK." FontFamily="Impact" FontSize="25" TextAlignment="Right"/>
</StackPanel>
<Grid x:Name="SpecialIssueRibbon" Width="440" Height="76" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#EDD443" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TransformGroup><RotateTransform Angle="-48"/><TranslateTransform X="-138" Y="38"/></TransformGroup></Grid.RenderTransform><Border BorderBrush="#243033" BorderThickness="0,2" Margin="0,4"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="RibbonLine1" Text="SPECIAL" FontFamily="Impact" FontSize="25" TextAlignment="Center"/><TextBlock x:Name="RibbonLine2" Text="ISSUE" FontFamily="Impact" FontSize="28" TextAlignment="Center" Margin="0,-4,0,0"/></StackPanel></Grid>
<Border Height="330" VerticalAlignment="Bottom"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00121B1F" Offset="0"/><GradientStop Color="#F5121B1F" Offset="0.2"/><GradientStop Color="#FF121B1F" Offset="1"/></LinearGradientBrush></Border.Background></Border>
<Grid x:Name="HeadlinePanel" Height="270" VerticalAlignment="Bottom" Margin="16,0,16,30" TextElement.Foreground="#F4D72D"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Grid.Row="0"><TextBlock x:Name="HeadlineLine1" Text="WE SANK AN" FontFamily="Impact" FontSize="165" Margin="0,-10,0,-12"/></Viewbox><Viewbox Stretch="Uniform" StretchDirection="DownOnly" Grid.Row="1"><TextBlock x:Name="HeadlineLine2" Text="AIRCRAFT CARRIER!" FontFamily="Impact" FontSize="165" Margin="0,-10,0,-12"/></Viewbox></Grid>
<Image x:Name="PrintGrain" Source="{Binding Assets[umbra_print_grain]}" Stretch="Fill" Opacity="0.085" IsHitTestVisible="False"/>
<Image x:Name="PaperWear" Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.24" IsHitTestVisible="False"/>
<Border x:Name="PaperFold" Height="9" VerticalAlignment="Top" Margin="0,754,0,0" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#16FFF4CE" Offset="0.43"/><GradientStop Color="#1B211C13" Offset="0.55"/><GradientStop Color="#00211C13" Offset="1"/></LinearGradientBrush></Border.Background></Border><Border BorderBrush="#625A42" BorderThickness="1.4" IsHitTestVisible="False"/>
</Grid></Border></Viewbox>
