<!-- Fictional Harwich Times, 31 May 1982. Original alternate-history campaign reporting.
Layout references: user-supplied Cape Cod Times scans, 18 July 1981 and 14 August 1982.
The renamed masthead is a separate image to keep the gull and serif treatment together.
Its lettering is reconstructed from the supplied reference, not an exact scan extraction.
All news copy below remains editable. The archival photograph dates to 28 May 1981. -->
<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
 <Grid Width="1000" Height="1640">
  <Border Padding="28,26" Background="#EEEBD5" TextElement.Foreground="#282A23" TextElement.FontFamily="Times New Roman">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="185"/><RowDefinition Height="178"/><RowDefinition Height="490"/><RowDefinition Height="*"/><RowDefinition Height="55"/></Grid.RowDefinitions>
    <!-- Remove this whole Grid to omit the top edition strip. -->
    <Grid x:Name="EditionStrip"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Background="#D4DECB" Grid.Column="0"/><Border Background="#D4DECB" Grid.Column="2"/><Border BorderBrush="#488888" BorderThickness="1" Grid.ColumnSpan="4"/>
     <TextBlock Text="Monday&#10;report" FontFamily="Arial" FontWeight="Bold" FontStyle="Italic" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/><Border Grid.Column="1" BorderBrush="#488888" BorderThickness="1,0,0,0" Padding="16,10"><StackPanel><TextBlock x:Name="TeaserTitle0" Text="The truce" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" FontWeight="Bold" Margin="0,0,0,7"/><TextBlock x:Name="TeaserBody0" Text="Reagan and Haig reopen talks" FontSize="17" LineHeight="20" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic"/></StackPanel></Border><Border Grid.Column="2" BorderBrush="#488888" BorderThickness="1,0,0,0" Padding="16,10"><StackPanel><TextBlock x:Name="TeaserTitle1" Text="The withdrawal" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" FontWeight="Bold" Margin="0,0,0,7"/><TextBlock x:Name="TeaserBody1" Text="U.N. to oversee departure" FontSize="17" LineHeight="20" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic"/></StackPanel></Border><Border Grid.Column="3" BorderBrush="#488888" BorderThickness="1,0,0,0" Padding="16,10"><StackPanel><TextBlock x:Name="TeaserTitle2" Text="The future" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" FontWeight="Bold" Margin="0,0,0,7"/><TextBlock x:Name="TeaserBody2" Text="Sovereignty still in dispute" FontSize="17" LineHeight="20" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic"/></StackPanel></Border>
    </Grid>
    <Grid Grid.Row="1" x:Name="NewspaperHeader" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="151"/><RowDefinition Height="24"/><RowDefinition Height="2"/></Grid.RowDefinitions>
     <Grid ClipToBounds="True">
      <Image x:Name="Masthead" Source="{Binding Assets[harwich_times_masthead]}" Width="850" Height="283.33" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-9,-66,0,-99"/>
      <TextBlock x:Name="Greeting" Text="Good&#10;Morning!" FontSize="22" LineHeight="22" TextAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,14,0,0"/>
      <TextBlock x:Name="MastheadTagline" Text="THE CAPE AND ISLANDS’ DAILY NEWSPAPER" FontFamily="Arial" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
     </Grid>
     <Grid Grid.Row="1"><TextBlock Text="Vol. 1, No. 122" FontFamily="Arial" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="EditionDate" Text="Harwich, Massachusetts · Monday, May 31, 1982" FontFamily="Arial" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="32 Pages                    25¢" FontFamily="Arial" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Border Grid.Row="2" Background="#606054"/>
    </Grid>
    <!-- Edit each complete headline line in its Text value. -->
    <StackPanel Grid.Row="2" Margin="0,8,0,0"><Viewbox Height="80" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,3"><TextBlock x:Name="HeadlineLine1" Text="Reagan and Haig secure" FontSize="70" LineHeight="77" TextWrapping="Wrap" FontFamily="Arial"/></Viewbox><Viewbox Height="80" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,3"><TextBlock x:Name="HeadlineLine2" Text="South Atlantic cease-fire" FontSize="70" LineHeight="77" TextWrapping="Wrap" FontFamily="Arial"/></Viewbox></StackPanel>
    <Grid Grid.Row="3" x:Name="LeadStory" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="520"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel x:Name="PhotoColumn"><Image x:Name="MainPhotograph" Source="{Binding Assets[ar_reagan_haig_cabinet_1981]}" Height="347" Stretch="Uniform" Opacity="0.91"/><TextBlock x:Name="PhotoTitle" Text="Diplomacy at the White House" FontSize="21" LineHeight="24" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic" Margin="0,7,0,5"/><TextBlock x:Name="PhotoCaption" Text="Reagan (center), Haig (left) and advisers at the White House. Archive photograph, May 28, 1981. White House Photographic Office." FontSize="15" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Border BorderBrush="#6A766A" BorderThickness="0,1,0,0" Padding="0,8,0,0"><TextBlock x:Name="PhotoDeck" Text="Orders to fight give way to preparations for home." FontSize="20" LineHeight="23" TextWrapping="Wrap" FontStyle="Italic"/></Border>
     </StackPanel>
     <StackPanel x:Name="LeadColumn" Grid.Column="2"><TextBlock x:Name="LeadParagraph1" Text="WASHINGTON — President Reagan and Secretary of State Alexander M. Haig Jr. have secured agreement on a cease-fire between Britain and Argentina after renewed American mediation in the South Atlantic conflict." FontSize="17" LineHeight="20" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="LeadParagraph2" Text="Haig carried proposals between the two governments while Reagan pressed their leaders to halt the fighting and accept a supervised withdrawal from the disputed islands." FontSize="17" LineHeight="20" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="LeadParagraph3" Text="The agreement follows heavy losses to the British expedition. Its troops retain a foothold at San Carlos, but the cost of pressing the campaign has brought London back to negotiations." FontSize="17" LineHeight="20" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="LeadParagraph4" Text="British troops and the Argentine garrison are to leave in stages. An interim administration under the United Nations flag will govern the islands while talks continue." FontSize="17" LineHeight="20" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="LeadParagraph5" Text="Neither government has abandoned its claim to sovereignty. The cease-fire stops the fighting, but leaves the central dispute unsettled." FontSize="17" LineHeight="20" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel>
    </Grid>
    <Grid Grid.Row="4" x:Name="AnalysisSection"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="235"/><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="Subheadline" Text="Both sides accept withdrawal plan" FontSize="33" LineHeight="37" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic" VerticalAlignment="Center"/>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel x:Name="DetailColumn1" Grid.Column="0"><TextBlock x:Name="Detail1_1" Text="The first task is to separate the opposing forces and arrange their departure under international supervision. The agreement calls for both sides to stop offensive operations." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="Detail1_2" Text="Military representatives must still settle the timetable, routes and safeguards for the withdrawal. The cease-fire gives them an opportunity to do so without another battle." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel><StackPanel x:Name="DetailColumn2" Grid.Column="2"><TextBlock x:Name="Detail2_1" Text="An interim administration will take responsibility for the islands until Britain and Argentina reach a further agreement. Neither side will be required to surrender its sovereignty claim." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="Detail2_2" Text="The future of the islanders remains central to the dispute. The new arrangement postpones the final decision rather than resolving it by force." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel><StackPanel x:Name="DetailColumn3" Grid.Column="4"><TextBlock x:Name="Detail3_1" Text="Washington has brought two governments with sharply conflicting aims to the same table. The next test is whether the truce can survive the withdrawal and the opening of political talks." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="Detail3_2" Text="For the men at sea and ashore, the immediate consequence is simpler. Orders to fight are giving way to preparations for the journey home." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel></Grid>
     <Border Grid.Row="2" BorderBrush="#666657" BorderThickness="0,1,0,0"><TextBlock x:Name="LowerTitle" Text="A pause in the fighting, an uncertain peace" FontSize="29" LineHeight="33" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic" VerticalAlignment="Center"/></Border>
     <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel x:Name="LowerColumn1" Grid.Column="0"><TextBlock x:Name="LowerHeading1" Text="London weighs the cost" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" Height="48" Margin="0,0,0,9"/><TextBlock x:Name="LowerBody1_1" Text="The British force has suffered enough damage to make a continued campaign costly. The agreement offers a way to end the fighting, but gives London no final settlement of the islands’ future." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel><StackPanel x:Name="LowerColumn2" Grid.Column="2"><TextBlock x:Name="LowerHeading2" Text="Buenos Aires keeps its claim" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" Height="48" Margin="0,0,0,9"/><TextBlock x:Name="LowerBody2_1" Text="Argentina has prevented a decisive British victory without securing recognition of its sovereignty. Its surviving ships and aircraft return from a campaign whose political result remains open." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel><StackPanel x:Name="LowerColumn3" Grid.Column="4"><TextBlock x:Name="LowerHeading3" Text="The next negotiations" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" Height="48" Margin="0,0,0,9"/><TextBlock x:Name="LowerBody3_1" Text="Reagan and Haig’s mediation has secured the cease-fire. The United Nations will oversee the interim arrangements, while Britain and Argentina must still negotiate a lasting agreement." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel></Grid>
    </Grid>
    <Border Grid.Row="5" x:Name="Footer" BorderBrush="#777769" BorderThickness="0,1,0,0" Padding="0,8,0,0"><Grid><StackPanel><TextBlock x:Name="PrintingOffice" Text="Printed at 91 Georgia Lane, Harwich, MA · Harwich Times" FontSize="14"/><TextBlock Text="SOUTH ATLANTIC · THE CEASE-FIRE AND THE WITHDRAWAL" FontFamily="Arial" FontSize="10" Margin="0,5,0,0"/></StackPanel><TextBlock Text="1" FontSize="18" HorizontalAlignment="Right"/></Grid></Border>
   </Grid>
  </Border>
  <Image x:Name="PaperWear" Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.32" IsHitTestVisible="False"/>
 </Grid>
</Viewbox>