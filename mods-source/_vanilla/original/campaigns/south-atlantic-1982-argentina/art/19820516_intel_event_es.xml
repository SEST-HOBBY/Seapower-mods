<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
 <Grid Width="1200" Height="1480">
  <!-- The original Message 090 remains editable and retains its preliminary loss figures. -->
  <Border Margin="30,35,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1140" Height="1400" Background="#EFEDDF" TextElement.Foreground="#28271F">
  <Border.Resources><Style TargetType="{x:Type TextBlock}">
   <Setter Property="FontFamily" Value="/Assets/Resources/ui/fonts/#Special Elite"/>
   <Setter Property="FontSize" Value="22"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="LineHeight" Value="30"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
  </Style></Border.Resources>
  <Grid>
   <Grid Margin="74,48,46,35">
    <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="65"/></Grid.RowDefinitions>
    <StackPanel HorizontalAlignment="Left">
     <TextBlock x:Name="Office" Text="ESTADO MAYOR GENERAL DEL EJÉRCITO" FontFamily="Times New Roman" FontSize="21" TextAlignment="Center"/>
     <TextBlock x:Name="Branch" Text="JEFATURA III — OPERACIONES" FontFamily="Times New Roman" FontSize="21" TextAlignment="Center"/>
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="#302F28" BorderThickness="2">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="#302F28" BorderThickness="0,0,1.5,1.5"><TextBlock x:Name="DateHeader" Text="FECHA / HORA" FontFamily="Times New Roman" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <Border Grid.Column="1" BorderBrush="#302F28" BorderThickness="0,0,0,1.5"><TextBlock x:Name="EventsHeader" Text="ACONTECIMIENTOS" FontFamily="Times New Roman" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <Border Grid.Row="1" BorderBrush="#302F28" BorderThickness="0,0,1.5,0"><TextBlock x:Name="DateTime" Text="151130May82" FontSize="19" Margin="12,22,5,0"/></Border>
      <StackPanel x:Name="MessageBody" Grid.Row="1" Grid.Column="1" Margin="22,22,22,16">
       <TextBlock x:Name="MessageTitle" Text="Mensaje Nro 090 del Gobernador Militar MALVINAS:" Margin="0,0,0,22"/>
       <TextBlock x:Name="Paragraph1" Text="A las 0420 horas se inicia el ataque ejecutado al parecer por grupos comandos que podrían haber sido aerodesembarcados. Los atacantes realizan fuego de ametralladoras, lanzacohetes, cañón sin retroceso y al parecer morteros." Margin="0,0,0,17"/>
<TextBlock x:Name="Paragraph2" Text="Podría haber habido fuego naval inicial, no se ha podido ratificar. Terminado el ataque a las 0530 se aprecia que los atacantes se repliegan." Margin="0,0,0,17"/>
<TextBlock x:Name="Paragraph3" Text="De la inspección ocular posterior se descubren bandas de ametralladoras y tubos de lanzacohetes." Margin="0,0,0,17"/>
<TextBlock x:Name="Paragraph4" Text="Daños realizados: 5 aviones PUCARÁ, 3 aviones T-34 MENTOR y 1 avión SKYVAN fuera de servicio. Quedaría 1 T-34 MENTOR en condiciones a confirmar." Margin="0,0,0,17"/>
<TextBlock x:Name="Paragraph5" Text="No existe otra información de mayores detalles." Margin="0,0,0,17"/>
<TextBlock x:Name="Paragraph6" Text="Se solicita la mayor reserva a fin de no hacer trascender sus resultados al enemigo y la explotación sicológica consiguiente." Margin="0,0,0,17"/>
<TextBlock x:Name="Paragraph7" Text="Presente parte manejarlo con el menor personal posible." Margin="0,0,0,17"/>
      </StackPanel>
     </Grid>
    </Border>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
     <TextBlock x:Name="PageNumber" Text="Pág 1 – 1" FontSize="18" TextAlignment="Center"/>
     <TextBlock x:Name="Classification" Text="SECRETO" FontSize="19" TextAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#187E704F" Offset="0"/><GradientStop Color="#007E704F" Offset="0.08"/><GradientStop Color="#007E704F" Offset="0.93"/><GradientStop Color="#147E704F" Offset="1"/></LinearGradientBrush></Border.Background></Border>
  <Border Height="8" VerticalAlignment="Center" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00766E57" Offset="0"/><GradientStop Color="#12766E57" Offset="0.48"/><GradientStop Color="#20FFFFFF" Offset="0.55"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border><Image Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.12" IsHitTestVisible="False"/>
  </Grid>
 </Border>
  <!-- Photo attribution: Ken Griffiths, Destroyed Argentine Pucara aircraft Pebble Island 1982.
       Source: https://commons.wikimedia.org/wiki/File:Destroyed_Argentine_Pucara_aircraft_Pebble_Island_1982.jpg
       License: CC BY-SA 3.0 Unported, https://creativecommons.org/licenses/by-sa/3.0/
       Source revision includes Hohum's 2016 colour correction. The JPEG is unchanged.
       Both prints show the same post-war 1982 photograph. The second is an enlarged crop.
       The photograph and cropped presentation remain available under CC BY-SA 3.0.
       Full provenance is retained in pebble_raid_sources.txt. -->
  <!-- Extra paper below the original text lets the prints rest on the sheet without hiding any words. -->
  <Border Width="494" Padding="12,12,12,18" Background="#FFFDF4" BorderBrush="#B7B2A3" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="85,965,0,0" RenderTransformOrigin="0.5,0.5">
   <Border.RenderTransform><RotateTransform Angle="4"/></Border.RenderTransform>
   <Image Source="{Binding Assets[pebble_pucara_1982]}" Width="468" Height="308" Stretch="Uniform"/>
  </Border>
  <Border Width="464" Padding="12,12,12,18" Background="#FFFDF4" BorderBrush="#B7B2A3" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="625,1010,0,0" RenderTransformOrigin="0.5,0.5">
   <Border.RenderTransform><RotateTransform Angle="-5"/></Border.RenderTransform>
   <!-- Enlarge the fuselage and wing damage in XAML without altering the source image. -->
   <Grid Width="438" Height="260" ClipToBounds="True">
    <Image Source="{Binding Assets[pebble_pucara_1982]}" Width="760" Height="501" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-300,-150,0,0"/>
   </Grid>
  </Border>
 </Grid>
</Viewbox>
