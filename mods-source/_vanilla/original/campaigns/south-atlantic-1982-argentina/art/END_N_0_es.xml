<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="Both">
  <!-- Spanish edition. Keep navigation within the Spanish sequence and preserve the shared bindings. --><Grid Width="1560" Height="920" Background="{StaticResource Brush.Window.Header}" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8E969E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="58"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#28383B3F"/>
                  <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#40383B3F"/>
                  <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="76"/>
      <RowDefinition Height="1"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="64"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="ACUERDO NEGOCIADO" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="ATLÁNTICO SUR, MAYO DE 1982" FontSize="13" Foreground="#99A1A8" HorizontalAlignment="Center"/>
    </StackPanel>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,72,0">
      <TextBlock Text="1 / 3" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="122"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="122"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Vertical">
        <!-- Photo provenance (historical details, separate from the campaign caption):
             Javier Pérez de Cuéllar at Schiphol, 12 July 1982. Used as a portrait of the mediator, not a photograph of the fictional May settlement.
             Credit: Rob Bogaerts / Anefo, Nationaal Archief. Cropped portrait version by Jan Arkesteijn.
             Source: https://commons.wikimedia.org/wiki/File:Javier_P%C3%A9rez_de_Cu%C3%A9llar_(1982).jpg
             Rights: Creative Commons Attribution-ShareAlike 3.0 Netherlands.
             License: https://creativecommons.org/licenses/by-sa/3.0/nl/
        -->
        <Image Source="{Binding Assets[ar_end_perez_de_cuellar]}" Height="365" Stretch="Uniform" HorizontalAlignment="Center"/>
        <TextBlock Text="El secretario general de las Naciones Unidas." FontSize="11" Foreground="#99A1A8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock x:Name="SlideTitle" Text="Una paz negociada" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,7"/>
        <TextBlock x:Name="SlideBody" TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#D0D4D8">
          <Run Text="Sus ataques han causado graves pérdidas a la expedición británica. Aunque las fuerzas restantes conservan una cabeza de playa en San Carlos, el costo de continuar la campaña ha llevado a Londres de nuevo a la mesa de negociaciones. La reanudación de la mediación ha logrado un alto el fuego."/>
          <LineBreak/>
          <LineBreak/>
          <Run Text="Según el acuerdo, las tropas británicas y la guarnición argentina se retirarán por etapas bajo supervisión internacional. Una administración provisional bajo la bandera de las Naciones Unidas gobernará las islas mientras continúan las negociaciones. Ninguno de los dos países renuncia a su reclamo de soberanía."/>
        </TextBlock>
      </StackPanel>
      <Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&gt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-argentina/art/END_N_1_es.xml"/>
      <TextBlock Grid.Column="0" Text="&lt;" FontSize="58" Foreground="#5F676E" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Viewbox>
