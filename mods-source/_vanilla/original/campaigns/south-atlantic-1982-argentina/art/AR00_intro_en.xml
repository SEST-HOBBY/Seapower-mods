<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Stretch="Uniform"
  StretchDirection="Both">
  <!-- Match the host Free Content window so the slide does not read as an inset panel. -->
  <Grid Width="1560" Height="920" Background="{StaticResource Brush.Window.Header}" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8E969E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="58"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#28383B3F"/><Setter Property="Opacity" Value="0.82"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#40383B3F"/><Setter Property="Opacity" Value="0.9"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="INTRODUCTION" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="SOUTH ATLANTIC, APRIL 1982" FontSize="13" Foreground="#99A1A8" HorizontalAlignment="Center"/>
    </StackPanel>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,72,0"><TextBlock Text="1 / 6" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <!-- Dismissal is provided by the host window close and Skip controls. -->
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="&lt;" FontSize="58" Foreground="#5F676E" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&gt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-argentina/art/AR00_0_en.xml"/>
      <StackPanel Grid.Column="1" Orientation="Vertical">
        <Image Source="{Binding Assets[sa1982_photo_falklands]}" Height="365" Stretch="Uniform" HorizontalAlignment="Center"/>
        <TextBlock Text="Hills, bays and grasslands of the Islas Malvinas." FontStyle="Italic" FontSize="11" Foreground="#99A1A8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock x:Name="SlideTitle" Text="The Malvinas / Falkland Islands" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,7"/>
        <TextBlock x:Name="SlideBody" TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#D0D4D8">
          <Run Text="The Malvinas, known to Britain as the Falkland Islands, lie some 550 kilometres east of Patagonia. The two main islands, Soledad and Gran Malvina, are separated by the Estrecho de San Carlos. Stanley is the principal settlement, while small sheep farms are scattered across a cold, windswept landscape of grassland and rocky hills."/>
          <LineBreak/><LineBreak/>
          <Run Text="Argentina regarded the islands as national territory inherited from Spain and taken by Britain in 1833. Their recovery became a cause shared across generations and political divisions. Years of negotiations had brought no agreement on sovereignty. By 1982, the military government believed that taking control of the islands would force Britain to settle the dispute and rally the country behind it."/>
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Viewbox>

