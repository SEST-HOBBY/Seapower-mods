<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
  
  <Border x:Name="Cover" Width="754" Height="1004" Background="#BDA58B" TextElement.Foreground="#171916">
    <Grid ClipToBounds="True">
      <!-- Keep the full explosion photograph visible between the masthead and cover lines. -->
      <Border Height="212" Background="#D6C8AC" VerticalAlignment="Top"/>
      <Image x:Name="CoverPhotograph" Source="{Binding Assets[gente_carriers_sunk_photo]}" Stretch="Uniform" Width="754" Height="424" VerticalAlignment="Top" Margin="0,205,0,0" />
      <Grid x:Name="MastheadPanel" Width="251" Height="163" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,25,0,0">
        <Grid.RenderTransform>
          <RotateTransform Angle="-2.2" CenterX="125.5" CenterY="81.5" />
        </Grid.RenderTransform>
        <Border Background="#DB1823" BorderBrush="#C6B258" BorderThickness="1.5" />
        <Viewbox Width="230" Height="8" Margin="10,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill">
          <TextBlock x:Name="IssueLine" FontFamily="Arial" FontSize="100" FontStyle="Normal" FontWeight="Bold" Margin="0.1465,-14.8196,-4.9331,-6.8599" Text="VICTORY SPECIAL - 1982 - $ 27,000" />
        </Viewbox>
        <Viewbox Width="211" Height="6" Margin="20,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill">
          <TextBlock x:Name="RegionalPricesLine1" FontFamily="Arial" FontSize="100" FontStyle="Normal" FontWeight="Bold" Margin="-7.1777,-14.8196,-4.8836,-12.8169" Text="URUGUAY N$ 38 - PARAGUAY 400 GUARANIES" />
        </Viewbox>
        <Viewbox Width="238" Height="6" Margin="7,23,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill">
          <TextBlock x:Name="RegionalPricesLine2" FontFamily="Arial" FontSize="100" FontStyle="Normal" FontWeight="Bold" Margin="-7.1777,-14.8196,-3.0287,-12.8169" Text="UNITED STATES US$ 2.50 - ECUADOR S/. 75 - COLOMBIA $ 125" />
        </Viewbox>
        <Viewbox Width="231" Height="96" Margin="10,36,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" TextElement.Foreground="#EDE5CF">
          <TextBlock x:Name="Masthead" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="-3.5156,-20.1671,-1.8072,-19.4332" Text="GENTE" />
        </Viewbox>
        <Viewbox Width="207" Height="14" Margin="23,140,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" TextElement.Foreground="#EDE5CF">
          <TextBlock x:Name="MastheadTagline" FontFamily="Arial" FontSize="100" FontStyle="Italic" FontWeight="Bold" Margin="1.1230,-19.3606,0.9270,-21.5571" Text="AND CURRENT AFFAIRS" />
        </Viewbox>
      </Grid>
      <Grid x:Name="FeaturePanel" Width="250" Height="170" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="270,16,0,0">
        <Viewbox Width="203" Height="21" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill">
          <TextBlock x:Name="FeatureLine1" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="-4.1016,-20.1671,0.0475,-19.4332" Text="THE VICTORY" />
        </Viewbox>
        <Viewbox Width="228" Height="21" Margin="0,32,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill">
          <TextBlock x:Name="FeatureLine2" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="-4.1016,-20.1671,-0.5855,-19.4332" Text="SPECIAL REPORT" />
        </Viewbox>
        <Viewbox Width="109" Height="21" Margin="0,64,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill">
          <TextBlock x:Name="FeatureLine3" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="-0.5859,-20.1671,-2.3448,-19.4332" Text="THE PHOTOS" />
        </Viewbox>
        <Viewbox Width="154" Height="21" Margin="0,96,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill">
          <TextBlock x:Name="FeatureLine4" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="0.5859,-20.1671,-1.8072,-19.4332" Text="YOU'LL ONLY SEE" />
        </Viewbox>
        <Viewbox Width="24" Height="19" Margin="0,130,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill">
          <TextBlock x:Name="FeaturePrefix" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="-4.1016,-21.8273,-4.1500,-21.0933" Text="IN" />
        </Viewbox>
        <Border Margin="29,126,0,0" Width="86" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#DB1823">
          <Viewbox Margin="4,5,4,5" Stretch="Fill" TextElement.Foreground="#EDE5CF">
            <TextBlock x:Name="FeatureBrand" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="-3.5156,-20.1671,-1.8072,-19.4332" Text="GENTE" />
          </Viewbox>
        </Border>
      </Grid>
      
      <Grid x:Name="SpecialIssueRibbon" Width="280" Height="65" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#EDE5CF">
        <Grid.RenderTransform>
          <TransformGroup>
            <RotateTransform Angle="32" />
            <TranslateTransform X="579" Y="-33" />
          </TransformGroup>
        </Grid.RenderTransform>
        <Viewbox Width="85" Height="23" Margin="93,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" TextElement.Foreground="#BC514B">
          <TextBlock x:Name="RibbonLine1" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="-2.3926,-20.1671,-0.8785,-19.4332" Text="SPECIAL" />
        </Viewbox>
        <Viewbox Width="200" Height="24" Margin="20,33,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" TextElement.Foreground="#BC514B">
          <TextBlock x:Name="RibbonLine2" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="-4.1016,-20.1671,-4.1500,-19.4332" Text="EDITION" />
        </Viewbox>
      </Grid>
      
      <!-- Change these complete cover lines to edit the victory announcement. -->
      <Border x:Name="VictoryAnnouncement" Margin="0,620,0,0" Height="118" VerticalAlignment="Top" Background="#EDE5CF">
        <StackPanel Margin="22,12,22,9">
          <Viewbox Height="34" Stretch="Uniform" HorizontalAlignment="Left" MaxWidth="710">
            <TextBlock x:Name="VictorySubheadline" Text="HERMES AND INVINCIBLE SUNK" FontFamily="Impact" FontSize="37" Foreground="#991F23"/>
          </Viewbox>
          <TextBlock x:Name="VictoryDeckLine1" Text="Argentina’s fighting men have struck the decisive blow." FontFamily="Arial" FontSize="20" FontWeight="Bold" Margin="0,8,0,0"/>
          <TextBlock x:Name="VictoryDeckLine2" Text="Britain has lost both aircraft carriers." FontFamily="Arial" FontSize="20" FontWeight="Bold" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
      <Border Margin="0,750,0,0" Background="#111A17" />
      <Grid x:Name="HeadlinePanel" Margin="0,738,0,0" Height="269" VerticalAlignment="Top" Background="#111A17">
        <Grid.RenderTransform>
          <RotateTransform Angle="0.8" CenterX="377" CenterY="134" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="132" />
          <RowDefinition Height="137" />
        </Grid.RowDefinitions>
        
        <Viewbox Grid.Row="0" Margin="18,14,26,6" Stretch="Uniform" TextElement.Foreground="#FFE527">
          <TextBlock x:Name="HeadlineLine1" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="0.0000,-21.8273,-1.8072,-21.0933" Text="WE HAVE" />
        </Viewbox>
        <Viewbox Grid.Row="1" Margin="17,11,25,24" Stretch="Uniform" TextElement.Foreground="#FFE527">
          <TextBlock x:Name="HeadlineLine2" FontFamily="Impact" FontSize="100" FontStyle="Normal" FontWeight="Normal" Margin="0.0000,-20.1671,-3.8571,-19.4332" Text="WON" />
        </Viewbox>
      </Grid>
      
      <Image x:Name="PaperFinish" Source="{Binding Assets[gente_victory_finish]}" Stretch="Fill" Opacity="0.045" IsHitTestVisible="False" />
      <Border BorderBrush="#786F55" BorderThickness="1.2" Opacity="0.55" IsHitTestVisible="False" />
    </Grid>
  </Border>
</Viewbox>