<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
  <Border Width="820" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#101010"
          TextElement.FontFamily="Arial">
    <Border.Effect><DropShadowEffect/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="#F2F0EA">
        <Border Background="#C8102E" Padding="20,6,24,10" HorizontalAlignment="Left">
          <TextBlock Text="Semana Gráfica" FontFamily="Times New Roman" FontWeight="Bold" FontStyle="Italic" FontSize="64" Foreground="White"/>
        </Border>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="Año 17 · N° 868" FontSize="14" Foreground="#141414" HorizontalAlignment="Right"/>
          <TextBlock Text="6 de mayo de 1982" FontSize="14" Foreground="#141414" HorizontalAlignment="Right"/>
          <TextBlock Text="$25.000" FontSize="14" FontWeight="Bold" Foreground="#141414" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1">
        <Image Source="{Binding Assets[sa1982_photo_super_etendards]}" Stretch="UniformToFill" Height="760"/>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="28,12,28,0">
          <TextBlock Text="ESTAMOS" FontFamily="Impact" FontSize="120" Foreground="#FFD400" LineHeight="112">
            <TextBlock.Effect><DropShadowEffect ShadowDepth="4" BlurRadius="6"/></TextBlock.Effect>
          </TextBlock>
          <TextBlock Text="GANANDO" FontFamily="Impact" FontSize="120" Foreground="#FFD400" LineHeight="112">
            <TextBlock.Effect><DropShadowEffect ShadowDepth="4" BlurRadius="6"/></TextBlock.Effect>
          </TextBlock>
          </StackPanel><StackPanel VerticalAlignment="Bottom" Margin="28,0,28,26"><TextBlock Text="Martes, 15.40 horas. Dos Super Étendard de la Armada regresan a baja altura sobre el mar tras el ataque a la escolta británica." FontSize="16" FontStyle="Italic" Foreground="White" TextWrapping="Wrap" Margin="0,8,180,0">
            <TextBlock.Effect><DropShadowEffect ShadowDepth="2" BlurRadius="4"/></TextBlock.Effect>
          </TextBlock>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2" Background="#F2F0EA">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="20,14,10,18">
          <TextBlock Text="EXOCET" FontFamily="Impact" FontSize="26" Foreground="#C8102E"/>
          <TextBlock Text="El misil que quebró la pantalla de radar británica." FontSize="15" Foreground="#141414" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="10,14,10,18">
          <TextBlock Text="LOS PILOTOS" FontFamily="Impact" FontSize="26" Foreground="#C8102E"/>
          <TextBlock Text="Exclusivo: los pilotos que realizaron la misión cuentan su historia." FontSize="15" Foreground="#141414" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="10,14,20,18">
          <TextBlock Text="MALVINAS" FontFamily="Impact" FontSize="26" Foreground="#C8102E"/>
          <TextBlock Text="32 páginas de fotografías de las islas y de la flota." FontSize="15" Foreground="#141414" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Viewbox>
