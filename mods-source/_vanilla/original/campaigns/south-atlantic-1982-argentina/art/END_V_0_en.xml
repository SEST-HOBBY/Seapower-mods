<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="Both">
  <Grid Width="1560" Height="920" Background="{StaticResource Brush.Window.Header}" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#8E969E" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="58" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Opacity" Value="0.58" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#28383B3F" />
                  <Setter Property="Opacity" Value="0.82" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#40383B3F" />
                  <Setter Property="Opacity" Value="0.9" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="76" />
      <RowDefinition Height="1" />
      <RowDefinition Height="*" />
      <RowDefinition Height="64" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="VICTORY" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="SOUTH ATLANTIC, 1982" FontSize="13" Foreground="#99A1A8" HorizontalAlignment="Center" />
    </StackPanel>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,72,0">
      <TextBlock Text="1 / 3" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0" />
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="122" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="122" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Vertical">
        <!-- Photo provenance (historical details, separate from the campaign caption):
             HMS Exeter photographed from HMS Cardiff approaching Ascension Island on the return voyage, June 1982.
             Photographer: Tim Jones. Commons version cropped and levels adjusted by Hohum in 2010.
             Source: https://commons.wikimedia.org/wiki/File:HMS_Exeter,_seen_from_the_HMS_Cardiff_(June_1982,_after_the_Falklands_War).jpg
             Rights: PD-self, released into the public domain by the photographer.
             Downloaded original Commons file, 1482 x 1151. No additional edits.
        -->
        <Image Source="{Binding Assets[ar_end_exeter_homeward]}" Height="365" Stretch="Uniform" HorizontalAlignment="Center" />
        <TextBlock Text="A British warship returning towards Ascension, June 1982." FontSize="11" Foreground="#99A1A8" HorizontalAlignment="Center" Margin="0,8,0,0" />
        <TextBlock x:Name="SlideTitle" Text="The British Task Force Withdraws" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,7" />
        <TextBlock x:Name="SlideBody" TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#D0D4D8">
          <Run Text="The British attempt to retake the Malvinas has failed. Losses inflicted by your ships and aircraft have deprived the expedition of the strength needed to continue. London accepts a ceasefire and orders its remaining forces to withdraw." />
          <LineBreak />
          <LineBreak />
          <Run Text="The task force that sailed south to restore British control now turns for home. Argentine troops hold their positions across the islands, and the immediate threat of invasion has passed. Your campaign at sea has decided the outcome." />
        </TextBlock>
      </StackPanel>
      <Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&gt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-argentina/art/END_V_1_en.xml" />
      <TextBlock Grid.Column="0" Text="&lt;" FontSize="58" Foreground="#5F676E" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Viewbox>
