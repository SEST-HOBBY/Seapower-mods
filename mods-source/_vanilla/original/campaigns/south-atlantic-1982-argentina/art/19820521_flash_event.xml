<!-- Campaign adaptation of the confirmed San Carlos landing reports, not a verbatim historical signal.
Historical basis: Argentine Army official report, printed p. 76 (ar_faa_mlv_c79_013.pdf),
and the Ministry of Defence archive ar_ea_cem_vrs_02_02_0.pdf, PDF p. 31.
Assessment also adapts the naval/logistical reasoning of the 29 May translated intercept,
3/AA/098965-82, parts IV-VI, reproduced in the UK campaign's 19820529_umbra_event.xml.
This is original campaign prose for 21 May, not a quotation or a redated historical message.
Later Darwin fighting, aircraft losses and total absence of Argentine naval resources are not assumed. -->
<!-- Match the earlier MESSAGE 090 intel event: operations-log table, game font and paper finish.
Only the date is specified because no exact signal time is claimed. -->
<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
 <Border Width="1140" Height="1000" Background="#EFEDDF" TextElement.Foreground="#28271F">
  <Border.Resources><Style TargetType="{x:Type TextBlock}">
   <Setter Property="FontFamily" Value="/Assets/Resources/ui/fonts/#Special Elite"/>
   <Setter Property="FontSize" Value="22"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="LineHeight" Value="30"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
  </Style></Border.Resources>
  <Grid>
   <Grid Margin="74,48,46,35">
    <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="65"/></Grid.RowDefinitions>
    <StackPanel HorizontalAlignment="Left">
     <TextBlock x:Name="Office" Text="ARMY GENERAL STAFF" FontFamily="Times New Roman" FontSize="21" TextAlignment="Center"/>
     <TextBlock x:Name="Branch" Text="OPERATIONS BRANCH" FontFamily="Times New Roman" FontSize="21" TextAlignment="Center"/>
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="#302F28" BorderThickness="2">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="174"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="#302F28" BorderThickness="0,0,1.5,1.5"><TextBlock x:Name="DateHeader" Text="DATE" FontFamily="Times New Roman" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <Border Grid.Column="1" BorderBrush="#302F28" BorderThickness="0,0,0,1.5"><TextBlock x:Name="EventsHeader" Text="EVENTS" FontFamily="Times New Roman" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <Border Grid.Row="1" BorderBrush="#302F28" BorderThickness="0,0,1.5,0"><TextBlock x:Name="DateTime" Text="21 MAY 1982" FontSize="19" Margin="12,22,5,0"/></Border>
      <StackPanel x:Name="MessageBody" Grid.Row="1" Grid.Column="1" Margin="22,22,22,16">
       <TextBlock x:Name="MessageTitle" Text="San Carlos — enemy beachhead established" Margin="0,0,0,22"/>
       <TextBlock x:Name="Paragraph1" Text="Enemy troops have established a beachhead at San Carlos. Our local detachment offered resistance but could not prevent the landing. Troops and supplies continue to come ashore." Margin="0,0,0,17"/>
       <TextBlock x:Name="Paragraph2" Text="Despite the effort of our ships and aircraft, the enemy retains sufficient freedom of action at sea to reinforce and supply the beachhead." Margin="0,0,0,17"/>
       <TextBlock x:Name="Paragraph3" Text="This permits him to build up his forces for an advance against our positions, supported by naval gunfire. No early change in this situation is anticipated." Margin="0,0,0,17"/>
       <TextBlock x:Name="Paragraph4" Text="The operation to defeat the invasion at sea has failed. The island garrison must now face the British advance without assurance of reinforcement or resupply." Margin="0,0,0,17"/>
       <TextBlock x:Name="Paragraph5" Text="Our forces will continue to resist. We can no longer promise them relief." Margin="0,0,0,17"/>
      </StackPanel>
     </Grid>
    </Border>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
     <TextBlock x:Name="PageNumber" Text="Page 1 – 1" FontSize="18" TextAlignment="Center"/>
     <TextBlock x:Name="Classification" Text="SECRET" FontSize="19" TextAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#187E704F" Offset="0"/><GradientStop Color="#007E704F" Offset="0.08"/><GradientStop Color="#007E704F" Offset="0.93"/><GradientStop Color="#147E704F" Offset="1"/></LinearGradientBrush></Border.Background></Border>
  <Border Height="8" VerticalAlignment="Center" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00766E57" Offset="0"/><GradientStop Color="#12766E57" Offset="0.48"/><GradientStop Color="#20FFFFFF" Offset="0.55"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border><Image Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.12" IsHitTestVisible="False"/>
  </Grid>
 </Border>
</Viewbox>
