<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Stretch="Uniform"
  StretchDirection="Both">
  <Grid Width="1560" Height="920" Background="{StaticResource Brush.Window.Header}" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8E969E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="58"/><Setter Property="FontWeight" Value="Light"/><Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#28383B3F"/><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#40383B3F"/><Setter Property="Opacity" Value="0.9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="OPERACIÓN ROSARIO" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="2 April 1982" FontSize="13" Foreground="#99A1A8" HorizontalAlignment="Center"/>
    </StackPanel>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,72,0"><TextBlock Text="2 / 6" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <!-- Dismissal is provided by the host window close and Skip controls. -->
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
      <!-- The geographical introduction now precedes the decision slide. -->
      <Button Grid.Column="0" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&lt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-argentina/art/AR00_intro_en.xml"/>
      <Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&gt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-argentina/art/AR00_1_en.xml"/>
      <StackPanel Grid.Column="1" Orientation="Vertical">
        <Image Source="{Binding Assets[sa1982_photo_galtieri]}" Height="365" Stretch="Uniform" HorizontalAlignment="Center"/>
        <TextBlock Text="Buenos Aires, March 1982" FontStyle="Italic" FontSize="11" Foreground="#99A1A8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock Text="The Decision" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,7"/>
        <TextBlock x:Name="SlideBody" TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#D0D4D8">
          <Run Text="By early 1982, Lieutenant General Leopoldo Galtieri’s military government faced a deepening economic crisis and growing opposition at home. Admiral Jorge Anaya urged the recovery of the Malvinas by force. The Junta judged that Britain would be unwilling to fight a distant war and that a swift occupation could bring the sovereignty dispute to a settlement on Argentine terms."/>
          <LineBreak/><LineBreak/>
          <Run Text="The confrontation over South Georgia in March accelerated preparations. Operation Rosario would land Argentine forces, secure the islands and overcome the small British garrison while avoiding British casualties. The intention was to present London with an accomplished fact, then negotiate. The operation depended on surprise, restraint and the belief that Britain would not respond with a major military expedition."/>
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Viewbox>
