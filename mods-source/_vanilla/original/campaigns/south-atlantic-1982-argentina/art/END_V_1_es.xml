<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="Both">
  <!-- Spanish edition. Keep navigation within the Spanish sequence and preserve the shared bindings. --><Grid Width="1560" Height="920" Background="{StaticResource Brush.Window.Header}" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8E969E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="58"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#28383B3F"/>
                  <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#40383B3F"/>
                  <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="76"/>
      <RowDefinition Height="1"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="64"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="VICTORIA" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="ATLÁNTICO SUR, 1982" FontSize="13" Foreground="#99A1A8" HorizontalAlignment="Center"/>
    </StackPanel>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,72,0">
      <TextBlock Text="2 / 3" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="122"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="122"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Vertical">
        <!-- Photo provenance (historical details, separate from the campaign caption):
             Raising the Argentine flag at Government House, 2 April 1982.
             Credit: Argentina.gob.ar / Gobierno de Argentina.
             Source: https://commons.wikimedia.org/wiki/File:Izamiento_de_la_bandera_argentina_en_las_islas_Malvinas.jpg
             Original source: https://www.argentina.gob.ar/armada/gesta-de-malvinas/la-infanteria-de-marina
             Rights: Creative Commons Attribution 4.0 International, as stated on the Commons description page.
             License: https://creativecommons.org/licenses/by/4.0/
             Downloaded Commons 1280-pixel thumbnail of the current clearer version. Resized by Wikimedia, no additional edits.
        -->
        <Image Source="{Binding Assets[ar_end_argentine_flag]}" Height="365" Stretch="Uniform" HorizontalAlignment="Center"/>
        <TextBlock Text="Las fuerzas argentinas izan la bandera en Stanley." FontSize="11" Foreground="#99A1A8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock x:Name="SlideTitle" Text="Victoria para Argentina" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,7"/>
        <TextBlock x:Name="SlideBody" TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#D0D4D8">
          <Run Text="Gracias a sus acciones, las Malvinas han quedado aseguradas. Ha cumplido el objetivo que se le encomendó al comienzo de la campaña: impedir una reconquista británica y mantener las islas bajo control argentino."/>
          <LineBreak/>
          <LineBreak/>
          <Run Text="Su liderazgo y el valor de los marinos y aviadores bajo su mando han logrado una gran victoria para Argentina. Al concluir los combates, las tripulaciones sobrevivientes se preparan para regresar a casa. Quienes no regresaron serán recordados. Sean eternos sus laureles."/>
        </TextBlock>
      </StackPanel>
      <Button Grid.Column="0" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&lt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-argentina/art/END_V_0_es.xml"/>
      <!-- Keep the thank-you page inside this event so completion follows the full victory sequence. -->
      <Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&gt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-argentina/art/END_V_2_es.xml"/>
    </Grid>
  </Grid>
</Viewbox>
