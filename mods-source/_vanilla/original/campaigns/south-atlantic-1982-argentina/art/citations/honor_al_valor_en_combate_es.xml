<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
  <!-- Adapted from the GC-77 diploma. The original heading, seal and signature are shared through SealImage. -->
  <!-- The fixed Spanish masthead is artwork to preserve its original curve. All form text below it is editable. -->
  <Border x:Name="Paper" Width="976" Height="1600" Background="White" BorderBrush="Black" BorderThickness="1" TextElement.Foreground="Black">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="609"/><RowDefinition Height="115"/><RowDefinition Height="110"/>
        <RowDefinition Height="75"/><RowDefinition Height="110"/><RowDefinition Height="78"/>
        <RowDefinition Height="130"/><RowDefinition Height="60"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid x:Name="HeadingBlock" Grid.Row="0">
        <Border x:Name="OriginalMasthead" Width="946" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,39,0,0">
          <Border.Background><ImageBrush ImageSource="{Binding SealImage}" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.01536885,0.025,0.96926230,0.2625" Stretch="Fill"/></Border.Background>
        </Border>
        <Viewbox Width="747" Height="80" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,477,0,0">
          <TextBlock x:Name="Institution" Text="A R M A D A   A R G E N T I N A" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontStretch="Condensed" FontSize="55" FontWeight="Bold"/>
        </Viewbox>
      </Grid>
      <!-- Courier Prime citation lines use a fixed size to avoid stretched letterforms. -->
      <!-- The campaign-specific grounds replace the historical resolution recital, in the same three-line space. -->
      <StackPanel x:Name="CitationBlock" Grid.Row="1" Margin="48,4,48,0">
        <TextBlock x:Name="CitationLine1" Text="POR LA DESTACADA PERICIA MARINERA Y ENTEREZA, EN RECONOCIMIENTO DEL VALOR Y LA FIRMEZA" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="16.5" FontWeight="Normal" Height="24" Width="878" HorizontalAlignment="Left" TextWrapping="NoWrap" TextAlignment="Left"/>
        <TextBlock x:Name="CitationLine2" Text="DE LAS DOTACIONES DURANTE EL ATAQUE NOCTURNO QUE DESTRUYÓ EL BUQUE DE GUERRA ENEMIGO, Y" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="16.5" FontWeight="Normal" Height="24" Width="878" HorizontalAlignment="Left" Margin="0,14,0,0" TextWrapping="NoWrap" TextAlignment="Left"/>
        <TextBlock x:Name="CitationLine3" Text="POR CONDUCIR A AMBOS BUQUES A SALVO DURANTE LA RETIRADA, SIN PÉRDIDAS." FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="16.5" FontWeight="Normal" Height="24" Width="878" HorizontalAlignment="Left" Margin="0,14,0,0" TextWrapping="NoWrap" TextAlignment="Left"/>
      </StackPanel>
      <Viewbox Grid.Row="2" Width="797" Height="44" Stretch="Uniform" VerticalAlignment="Top" Margin="0,43,0,0">
        <TextBlock x:Name="Authority" Text="EL COMANDANTE EN JEFE DE LA ARMADA" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="36" FontWeight="Bold"/>
      </Viewbox>
      <TextBlock Grid.Row="3" x:Name="Decision" Text="R E S U E L V E:" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,18,0,0"/>
      <Grid Grid.Row="4" x:Name="RecipientBlock" Margin="48,0,48,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="162"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="OTORGAR A LAS" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="20" FontWeight="Bold" Margin="0,30,0,0"/>
        <TextBlock x:Name="Recipient" Grid.Column="1" Text="Corbetas participantes&#10;y sus dotaciones" FontFamily="/Assets/Resources/ui/fonts/#UnifrakturMaguntia" FontSize="37" FontWeight="Normal" LineHeight="48" TextAlignment="Center" TextWrapping="Wrap" Margin="0,13,0,0"/>
      </Grid>
      <Grid Grid.Row="5" Margin="48,0,48,0">
        <TextBlock Text="LA CONDECORACIÓN" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Viewbox Width="580" Height="43" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0"><TextBlock x:Name="AwardTitle" Text="“Honor al Valor en Combate”" FontFamily="/Assets/Resources/ui/fonts/#UnifrakturMaguntia" FontSize="38" FontWeight="Normal"/></Viewbox>
      </Grid>
      <StackPanel Grid.Row="6" x:Name="GrantText" Margin="48,0,48,0">
        <Viewbox Height="24" Width="878" Stretch="Uniform" HorizontalAlignment="Left"><TextBlock Text="POR LO TANTO SE LE CONFIERE EL USO DE LA MEDALLA E INSIGNIA QUE CORRES-" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="20"/></Viewbox>
        <Viewbox Height="24" Width="878" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,14,0,0"><TextBlock Text="PONDIEREN DE ACUERDO A LO ESTABLECIDO Y PARA QUE CONSTE SE LE EXPIDE EN" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="20"/></Viewbox>
        <Viewbox Height="24" Width="477" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,14,0,0"><TextBlock Text="SU NOMBRE EL PRESENTE DIPLOMA." FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="20"/></Viewbox>
      </StackPanel>
      <Viewbox Grid.Row="7" Width="764" Height="24" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48,19,0,0">
        <TextBlock x:Name="IssueDate" Text="EN BUENOS AIRES, A LOS OCHO DÍAS DEL MES DE FEBRERO DE 1983." FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="20"/>
      </Viewbox>
      <!-- Original seal and signature are shown as source artwork for this historical game preview. -->
      <Grid Grid.Row="8" x:Name="Footer">
        <Border x:Name="OriginalSeal" Width="176" Height="219" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="397,46,0,0">
          <Border.Background><ImageBrush ImageSource="{Binding SealImage}" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.40778689,0.83375,0.18032787,0.136875" Stretch="Fill"/></Border.Background>
        </Border>
        <Border x:Name="OriginalSignature" Width="204" Height="180" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="591,0,0,0">
          <Border.Background><ImageBrush ImageSource="{Binding SealImage}" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.60655738,0.80125,0.20901639,0.1125" Stretch="Fill"/></Border.Background>
        </Border>
        <StackPanel Width="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="545,175,0,0">
          <Viewbox Width="171" Height="14" Stretch="Uniform"><TextBlock x:Name="SignatureName" Text="RUBÉN OSCAR FRANCO" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="12" FontWeight="Bold"/></Viewbox>
          <Viewbox Width="86" Height="11" Stretch="Uniform" Margin="0,3,0,0"><TextBlock Text="ALMIRANTE" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="10" FontWeight="Bold"/></Viewbox>
          <Viewbox Width="205" Height="11" Stretch="Uniform" Margin="0,3,0,0"><TextBlock Text="COMANDANTE EN JEFE DE LA ARMADA" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="10" FontWeight="Bold"/></Viewbox>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Viewbox>
