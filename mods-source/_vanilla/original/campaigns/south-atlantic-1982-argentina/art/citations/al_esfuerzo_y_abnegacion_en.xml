<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
<!-- Naval diploma adaptation. Shared original ornament is supplied by SealImage. -->
<Border x:Name="Paper" Width="976" Height="1512" Background="White" TextElement.Foreground="Black"><Grid><Border x:Name="Masthead" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="88,28,0,0" Width="792" Height="355"><Border.Background><ImageBrush ImageSource="{Binding SealImage}" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.015368852,0.025000000,0.969262295,0.262500000" Stretch="Fill"/></Border.Background></Border><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="145,441,0,0" Width="685" Height="61" Stretch="Fill"><TextBlock x:Name="Institution" Text="A R G E N T I N E   N A V Y" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontSize="30" TextWrapping="Wrap" FontWeight="Bold"/></Viewbox><TextBlock x:Name="CitationLine1" Text="IN RECOGNITION OF YOUR EXCEPTIONAL DEDICATION TO THE SUPPLY OF" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="18.5" TextWrapping="NoWrap" FontWeight="Normal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,568,0,0" Width="795" Height="21" TextAlignment="Left"/><TextBlock x:Name="CitationLine2" Text="STANLEY, ENSURING THE DELIVERY OF RUNWAY MATERIALS, AIRCRAFT SPARES" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="18.5" TextWrapping="NoWrap" FontWeight="Normal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,606,0,0" Width="795" Height="21" TextAlignment="Left"/><TextBlock x:Name="CitationLine3" Text="AND FUEL DURING THE SOUTH ATLANTIC CAMPAIGN." FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="18.5" TextWrapping="NoWrap" FontWeight="Normal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,644,0,0" Width="795" Height="21" TextAlignment="Left"/><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="125,738,0,0" Width="727" Height="39" Stretch="Uniform"><TextBlock x:Name="Authority" Text="THE COMMANDER-IN-CHIEF OF THE NAVY" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="30" TextWrapping="Wrap" FontWeight="Bold"/></Viewbox><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="365,808,0,0" Width="250" Height="20" Stretch="Uniform"><TextBlock x:Name="Decision" Text="H E R E B Y   A W A R D S:" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="30" TextWrapping="Wrap" FontWeight="Normal"/></Viewbox><!-- English award wording reads decoration first, then TO and the recipient. --><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,912,0,0" Width="182" Height="18" Stretch="Uniform"><TextBlock x:Name="AwardLabel" Text="THE DECORATION" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="30" TextWrapping="Wrap" FontWeight="Normal"/></Viewbox><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="281,900,0,0" Width="478" Height="34" Stretch="Fill"><TextBlock x:Name="AwardTitle" Text="“AL ESFUERZO Y LA ABNEGACIÓN”" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontSize="30" TextWrapping="Wrap" FontWeight="Bold"/></Viewbox><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,970,0,0" Width="34" Height="20" Stretch="Uniform"><TextBlock x:Name="Grant" Text="TO" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="30" TextWrapping="Wrap" FontWeight="Normal"/></Viewbox><TextBlock x:Name="RecipientRank" Text="{Binding CommanderRank}" FontFamily="/Assets/Resources/ui/fonts/#Roboto" FontSize="26" TextWrapping="Wrap" FontWeight="Bold" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Width="410" Margin="318,970,0,0"/><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="318,1008,0,0" Width="410" Height="46" Stretch="Fill"><TextBlock x:Name="Recipient" Text="{Binding CommanderName}" FontFamily="/Assets/Resources/ui/fonts/#UnifrakturMaguntia" FontSize="30" TextWrapping="Wrap" FontWeight="Normal"/></Viewbox><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,1092,0,0" Width="800" Height="20" Stretch="Uniform"><TextBlock x:Name="GrantClause" Text="IN WITNESS THEREOF, THIS DIPLOMA IS ISSUED IN YOUR NAME." FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="30" TextWrapping="Wrap" FontWeight="Normal"/></Viewbox><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="90,1155,0,0" Width="544" Height="20" Stretch="Uniform"><TextBlock x:Name="Date" Text="BUENOS AIRES, THE EIGHTH DAY OF FEBRUARY 1983." FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="30" TextWrapping="Wrap" FontWeight="Normal"/></Viewbox><Border x:Name="Seal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="410,1232,0,0" Width="151" Height="188"><Border.Background><ImageBrush ImageSource="{Binding SealImage}" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.407786885,0.833750000,0.180327869,0.136875000" Stretch="Fill"/></Border.Background></Border><Border x:Name="Signature" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="588,1201,0,0" Width="164" Height="145"><Border.Background><ImageBrush ImageSource="{Binding SealImage}" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.606557377,0.801250000,0.209016393,0.112500000" Stretch="Fill"/></Border.Background></Border><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="596,1346,0,0" Width="185" Height="15" Stretch="Uniform"><TextBlock x:Name="Signatory" Text="RUBÉN OSCAR FRANCO" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="30" TextWrapping="Wrap" FontWeight="Bold"/></Viewbox><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="650,1364,0,0" Width="70" Height="11" Stretch="Uniform"><TextBlock x:Name="SignatoryRank" Text="ADMIRAL" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="30" TextWrapping="Wrap" FontWeight="Bold"/></Viewbox><Viewbox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="570,1380,0,0" Width="235" Height="11" Stretch="Uniform"><TextBlock x:Name="SignatoryOffice" Text="COMMANDER-IN-CHIEF OF THE NAVY" FontFamily="/Assets/Resources/ui/fonts/#Courier Prime" FontSize="30" TextWrapping="Wrap" FontWeight="Bold"/></Viewbox></Grid></Border></Viewbox>
