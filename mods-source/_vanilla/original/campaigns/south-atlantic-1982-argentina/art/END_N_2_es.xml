<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="Both">
  <!-- Spanish edition. Keep navigation within the Spanish sequence and preserve the shared bindings. --><Grid Width="1560" Height="920" Background="{StaticResource Brush.Window.Header}" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8E969E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="58"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#28383B3F"/>
                  <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#40383B3F"/>
                  <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="76"/>
      <RowDefinition Height="1"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="64"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="CAMPAÑA FINALIZADA" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="ATLÁNTICO SUR, 1982" FontSize="13" Foreground="#99A1A8" HorizontalAlignment="Center"/>
    </StackPanel>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,72,0">
      <TextBlock Text="3 / 3" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="122"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="122"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Vertical">
        <!-- Photo provenance (historical details, separate from the campaign caption):
             Argentine pilots Cachón, Barrionuevo, Rinke and Velasco, 1982. Photographer unknown.
             Source: https://commons.wikimedia.org/wiki/File:Cachon-barrionuevo-rinke-velasco.jpg
             Commons source attribution: http://artofwar.ru/img/z/zampini_d_f/text_0380-1/
             Rights: Commons lists PD-AR-Photo. Worldwide publication status remains unverified, including United States status. This limitation was disclosed with the candidate before the user selected it. Review before release.
        -->
        <Image Source="{Binding Assets[ar_end_argentine_pilots]}" Height="365" Stretch="Uniform" HorizontalAlignment="Center"/>
        <TextBlock Text="Aviadores argentinos durante la campaña." FontSize="11" Foreground="#99A1A8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock x:Name="SlideTitle" Text="¡Esta fue una campaña muy disputada!" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,16,0,16"/>
        <TextBlock x:Name="SlideBody" TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#D0D4D8" Text="Sus esfuerzos han llevado a Gran Bretaña y Argentina a un acuerdo negociado, pero no ha logrado la victoria. El futuro de las Malvinas sigue sin resolverse. Aplique lo aprendido en su próximo intento: reinicie la campaña para buscar una victoria decisiva."/>
      <TextBlock Text="¡Buena suerte, comandante!" FontSize="16" Foreground="#D0D4D8" Margin="0,22,0,0"/>
        <!-- Close the campaign message before the brief developer thank-you. -->
        <Rectangle Height="1" Fill="#3E454B" Margin="0,24,0,20"/>
        <TextBlock x:Name="DeveloperThanks" Text="¡Gracias por jugar GUERRA DE MALVINAS 1982!" FontSize="16" Foreground="#D0D4D8" TextWrapping="Wrap"/>
        <TextBlock x:Name="DeveloperSignature" Text="- El equipo de Triassic Games" FontSize="16" Foreground="#D0D4D8" Margin="0,12,0,0"/>
        </StackPanel>
      <Button Grid.Column="0" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&lt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-argentina/art/END_N_1_es.xml"/>
      <!-- Complete the existing outcome event here, preserving its final-results unlock. -->
      <Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&gt;" Command="{Binding NextCommand}"/>
    </Grid>
  </Grid>
</Viewbox>
