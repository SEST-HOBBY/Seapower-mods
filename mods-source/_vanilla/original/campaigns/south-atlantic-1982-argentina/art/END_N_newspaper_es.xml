<!-- Fictional Harwich Times, 31 May 1982. Original alternate-history campaign reporting.
Layout references: user-supplied Cape Cod Times scans, 18 July 1981 and 14 August 1982.
The renamed masthead is a separate image to keep the gull and serif treatment together.
Its lettering is reconstructed from the supplied reference, not an exact scan extraction.
All news copy below remains editable. The archival photograph dates to 28 May 1981. -->
<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
 <Grid Width="1000" Height="1640">
  <Border Padding="28,26" Background="#EEEBD5" TextElement.Foreground="#282A23" TextElement.FontFamily="Times New Roman">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="185"/><RowDefinition Height="178"/><RowDefinition Height="490"/><RowDefinition Height="*"/><RowDefinition Height="55"/></Grid.RowDefinitions>
    <!-- Remove this whole Grid to omit the top edition strip. -->
    <Grid x:Name="EditionStrip"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Background="#D4DECB" Grid.Column="0"/><Border Background="#D4DECB" Grid.Column="2"/><Border BorderBrush="#488888" BorderThickness="1" Grid.ColumnSpan="4"/>
     <TextBlock Text="Edición del&#10;lunes" FontFamily="Arial" FontWeight="Bold" FontStyle="Italic" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/><Border Grid.Column="1" BorderBrush="#488888" BorderThickness="1,0,0,0" Padding="16,10"><StackPanel><TextBlock x:Name="TeaserTitle0" Text="La tregua" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" FontWeight="Bold" Margin="0,0,0,7"/><TextBlock x:Name="TeaserBody0" Text="Reagan y Haig reabren el diálogo" FontSize="17" LineHeight="20" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic"/></StackPanel></Border><Border Grid.Column="2" BorderBrush="#488888" BorderThickness="1,0,0,0" Padding="16,10"><StackPanel><TextBlock x:Name="TeaserTitle1" Text="La retirada" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" FontWeight="Bold" Margin="0,0,0,7"/><TextBlock x:Name="TeaserBody1" Text="La ONU supervisará la salida" FontSize="17" LineHeight="20" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic"/></StackPanel></Border><Border Grid.Column="3" BorderBrush="#488888" BorderThickness="1,0,0,0" Padding="16,10"><StackPanel><TextBlock x:Name="TeaserTitle2" Text="El futuro" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" FontWeight="Bold" Margin="0,0,0,7"/><TextBlock x:Name="TeaserBody2" Text="La soberanía sigue en disputa" FontSize="17" LineHeight="20" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic"/></StackPanel></Border>
    </Grid>
    <Grid Grid.Row="1" x:Name="NewspaperHeader" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="151"/><RowDefinition Height="24"/><RowDefinition Height="2"/></Grid.RowDefinitions>
     <Grid ClipToBounds="True">
      <Image x:Name="Masthead" Source="{Binding Assets[harwich_times_masthead]}" Width="850" Height="283.33" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-9,-66,0,-99"/>
      <TextBlock x:Name="Greeting" Text="¡Buenos&#10;días!" FontSize="22" LineHeight="22" TextAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,14,0,0"/>
      <TextBlock x:Name="MastheadTagline" Text="EL DIARIO DE CAPE COD Y LAS ISLAS" FontFamily="Arial" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
     </Grid>
     <Grid Grid.Row="1"><TextBlock Text="Vol. 1, No. 122" FontFamily="Arial" FontSize="10" VerticalAlignment="Center"/><TextBlock x:Name="EditionDate" Text="Harwich, Massachusetts · Lunes, 31 de mayo de 1982" FontFamily="Arial" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="32 páginas                    25¢" FontFamily="Arial" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Border Grid.Row="2" Background="#606054"/>
    </Grid>
    <!-- Edit each complete headline line in its Text value. -->
    <StackPanel Grid.Row="2" Margin="0,8,0,0"><Viewbox Height="80" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,3"><TextBlock x:Name="HeadlineLine1" Text="Reagan y Haig logran" FontSize="70" LineHeight="77" TextWrapping="Wrap" FontFamily="Arial"/></Viewbox><Viewbox Height="80" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,3"><TextBlock x:Name="HeadlineLine2" Text="la tregua en el Atlántico Sur" FontSize="70" LineHeight="77" TextWrapping="Wrap" FontFamily="Arial"/></Viewbox></StackPanel>
    <Grid Grid.Row="3" x:Name="LeadStory" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="520"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel x:Name="PhotoColumn"><Image x:Name="MainPhotograph" Source="{Binding Assets[ar_reagan_haig_cabinet_1981]}" Height="347" Stretch="Uniform" Opacity="0.91"/><TextBlock x:Name="PhotoTitle" Text="Diplomacia en la Casa Blanca" FontSize="21" LineHeight="24" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic" Margin="0,7,0,5"/><TextBlock x:Name="PhotoCaption" Text="Reagan (centro), Haig (izquierda) y asesores en la Casa Blanca. Fotografía de archivo, 28 de mayo de 1981. Oficina Fotográfica de la Casa Blanca." FontSize="15" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Border BorderBrush="#6A766A" BorderThickness="0,1,0,0" Padding="0,8,0,0"><TextBlock x:Name="PhotoDeck" Text="Las órdenes de combatir dan paso al regreso a casa." FontSize="20" LineHeight="23" TextWrapping="Wrap" FontStyle="Italic"/></Border>
     </StackPanel>
     <StackPanel x:Name="LeadColumn" Grid.Column="2"><TextBlock x:Name="LeadParagraph1" Text="WASHINGTON — El presidente Reagan y el secretario de Estado Alexander M. Haig Jr. han logrado un acuerdo de alto el fuego entre Gran Bretaña y Argentina tras renovar la mediación estadounidense en el conflicto del Atlántico Sur." FontSize="17" LineHeight="20" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="LeadParagraph2" Text="Haig transmitió propuestas entre ambos gobiernos mientras Reagan instaba a sus dirigentes a detener los combates y aceptar una retirada supervisada de las islas en disputa." FontSize="17" LineHeight="20" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="LeadParagraph3" Text="El acuerdo sigue a las graves pérdidas sufridas por la expedición británica. Sus tropas conservan una cabeza de playa en San Carlos, pero el costo de continuar la campaña ha devuelto a Londres a la mesa de negociaciones." FontSize="17" LineHeight="20" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="LeadParagraph4" Text="Las tropas británicas y la guarnición argentina se retirarán por etapas. Una administración provisional bajo bandera de las Naciones Unidas gobernará las islas mientras prosigan las conversaciones." FontSize="17" LineHeight="20" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="LeadParagraph5" Text="Ningún gobierno ha abandonado su reclamo de soberanía. El alto el fuego detiene los combates, pero deja sin resolver la disputa principal." FontSize="17" LineHeight="20" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel>
    </Grid>
    <Grid Grid.Row="4" x:Name="AnalysisSection"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="235"/><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="Subheadline" Text="Ambas partes aceptan el plan de retirada" FontSize="33" LineHeight="37" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic" VerticalAlignment="Center"/>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel x:Name="DetailColumn1" Grid.Column="0"><TextBlock x:Name="Detail1_1" Text="La primera tarea será separar a las fuerzas enfrentadas y organizar su salida bajo supervisión internacional. El acuerdo exige que ambas partes cesen las operaciones ofensivas." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="Detail1_2" Text="Los representantes militares deberán fijar el calendario, las rutas y las garantías de la retirada. El alto el fuego permite hacerlo sin librar otra batalla." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel><StackPanel x:Name="DetailColumn2" Grid.Column="2"><TextBlock x:Name="Detail2_1" Text="Una administración provisional se hará cargo de las islas hasta que Gran Bretaña y Argentina alcancen otro acuerdo. Ninguna parte deberá renunciar a su reclamo de soberanía." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="Detail2_2" Text="El futuro de los isleños sigue siendo central en la disputa. La nueva fórmula aplaza la decisión definitiva en lugar de imponerla por la fuerza." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel><StackPanel x:Name="DetailColumn3" Grid.Column="4"><TextBlock x:Name="Detail3_1" Text="Washington ha sentado a la misma mesa a dos gobiernos con objetivos muy distintos. La próxima prueba será mantener la tregua durante la retirada y el inicio del diálogo político." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/><TextBlock x:Name="Detail3_2" Text="Para los hombres en el mar y en tierra, la consecuencia inmediata es más sencilla. Las órdenes de combatir dan paso a los preparativos para volver a casa." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel></Grid>
     <Border Grid.Row="2" BorderBrush="#666657" BorderThickness="0,1,0,0"><TextBlock x:Name="LowerTitle" Text="Cesan los combates, la paz sigue siendo incierta" FontSize="29" LineHeight="33" TextWrapping="Wrap" FontFamily="Arial" FontStyle="Italic" VerticalAlignment="Center"/></Border>
     <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel x:Name="LowerColumn1" Grid.Column="0"><TextBlock x:Name="LowerHeading1" Text="Londres sopesa el costo" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" Height="48" Margin="0,0,0,9"/><TextBlock x:Name="LowerBody1_1" Text="La fuerza británica ha sufrido daños suficientes para encarecer la continuación de la campaña. El acuerdo permite poner fin a los combates, pero no ofrece a Londres una solución definitiva sobre el futuro de las islas." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel><StackPanel x:Name="LowerColumn2" Grid.Column="2"><TextBlock x:Name="LowerHeading2" Text="Buenos Aires mantiene su reclamo" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" Height="48" Margin="0,0,0,9"/><TextBlock x:Name="LowerBody2_1" Text="Argentina ha impedido una victoria británica decisiva sin obtener el reconocimiento de su soberanía. Sus buques y aeronaves supervivientes regresan de una campaña cuyo resultado político permanece abierto." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel><StackPanel x:Name="LowerColumn3" Grid.Column="4"><TextBlock x:Name="LowerHeading3" Text="Las próximas negociaciones" FontSize="23" LineHeight="26" TextWrapping="Wrap" FontFamily="Arial" Height="48" Margin="0,0,0,9"/><TextBlock x:Name="LowerBody3_1" Text="La mediación de Reagan y Haig ha logrado el alto el fuego. Las Naciones Unidas supervisarán las medidas provisionales, pero Gran Bretaña y Argentina aún deberán negociar un acuerdo duradero." FontSize="18" LineHeight="22" TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,12"/></StackPanel></Grid>
    </Grid>
    <Border Grid.Row="5" x:Name="Footer" BorderBrush="#777769" BorderThickness="0,1,0,0" Padding="0,8,0,0"><Grid><StackPanel><TextBlock x:Name="PrintingOffice" Text="Impreso en 91 Georgia Lane, Harwich, MA · Harwich Times" FontSize="14"/><TextBlock Text="ATLÁNTICO SUR · EL ALTO EL FUEGO Y LA RETIRADA" FontFamily="Arial" FontSize="10" Margin="0,5,0,0"/></StackPanel><TextBlock Text="1" FontSize="18" HorizontalAlignment="Right"/></Grid></Border>
   </Grid>
  </Border>
  <Image x:Name="PaperWear" Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.32" IsHitTestVisible="False"/>
 </Grid>
</Viewbox>