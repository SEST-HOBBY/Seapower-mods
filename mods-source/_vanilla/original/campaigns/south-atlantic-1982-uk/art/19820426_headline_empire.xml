<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
  <!-- Change text values to edit the words. Change the Grid rows and columns to fit longer text.
     Each large heading is one complete text line. Keep the image files beside this layout.
     A Viewbox fits each heading into its space. Longer words will look narrower.
     Negative margins remove empty space around letters. Check accents after editing.
     The paper marks are a separate Image at the end and can be removed. -->
  <Border Width="1000" Height="1333" Background="#253E47" TextElement.Foreground="#292A25">
    <Border.Resources>
      <!-- These styles set the fonts for the headings and small print. -->
      <Style x:Key="LargeHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="100" />
        <Setter Property="FontFamily" Value="Impact" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
      <Style x:Key="ArticleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Times New Roman" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </Border.Resources>
    <Grid>
      <Image Source="{Binding Assets[hermes_clean_background]}" Stretch="Fill" />
      <Grid Height="172" VerticalAlignment="Top" Margin="28,12,28,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="24" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource ArticleText}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#E52827">April 19, 1982 / $1.50</TextBlock>
        <Viewbox Stretch="Fill" Grid.Row="1">
          <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Georgia" Margin="0,-18,0,-18" Text="Headline" Foreground="#E52827" FontWeight="Bold" x:Name="PaperName">
            <TextBlock.Effect>
              <DropShadowEffect Color="#FFF6DF" BlurRadius="3" ShadowDepth="0" Opacity="1" />
            </TextBlock.Effect>
          </TextBlock>
        </Viewbox>
      </Grid>
      <Grid Width="345" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="25,209,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="109" />
          <RowDefinition Height="109" />
          <RowDefinition Height="109" />
          <RowDefinition Height="109" />
          <RowDefinition Height="24" />
          <RowDefinition Height="40" />
          <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <Viewbox Stretch="Fill" Grid.Row="0" Width="188" HorizontalAlignment="Left" Margin="0,0,0,12">
          <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Arial Black" Margin="0,-20,0,-22" Text="The" Foreground="#F5F040" x:Name="HeadlineLine1" />
        </Viewbox>
        <Viewbox Stretch="Fill" Grid.Row="1" Width="327" HorizontalAlignment="Left" Margin="0,0,0,12">
          <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Arial Black" Margin="0,-20,0,-22" Text="Empire" Foreground="#F5F040" x:Name="HeadlineLine2" />
        </Viewbox>
        <Viewbox Stretch="Fill" Grid.Row="2" Width="302" HorizontalAlignment="Left" Margin="0,0,0,12">
          <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Arial Black" Margin="0,-20,0,-22" Text="Strikes" Foreground="#F5F040" x:Name="HeadlineLine3" />
        </Viewbox>
        <Viewbox Stretch="Fill" Grid.Row="3" Width="235" HorizontalAlignment="Left" Margin="0,0,0,12">
          <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Arial Black" Margin="0,-20,0,-22" Text="Back" Foreground="#F5F040" x:Name="HeadlineLine4" />
        </Viewbox>
        <Border Grid.Row="4" Height="3" Background="#F5F040" Margin="0,10,48,10" />
        <Viewbox Stretch="Fill" Grid.Row="5" Width="267" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-13" Text="The Falklands" Foreground="#F5F040" x:Name="TextTheFalklands" />
        </Viewbox>
        <Viewbox Stretch="Fill" Grid.Row="6" Width="116" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="Crisis" Foreground="#F5F040" x:Name="TextCrisis" />
        </Viewbox>
      </Grid>
      <Grid Width="170" Height="56" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,48">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Viewbox Stretch="Fill" Grid.Row="0">
          <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Arial Black" Margin="0,-20,0,-22" Text="HMS Hermes" Foreground="#F5F040" x:Name="TextHMSHermes" />
        </Viewbox>
        <Viewbox Stretch="Fill" Grid.Row="1">
          <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Arial Black" Margin="0,-20,0,-22" Text="Steams South" Foreground="#F5F040" x:Name="TextSteamsSouth" />
        </Viewbox>
      </Grid>
    </Grid>
  </Border>
</Viewbox>