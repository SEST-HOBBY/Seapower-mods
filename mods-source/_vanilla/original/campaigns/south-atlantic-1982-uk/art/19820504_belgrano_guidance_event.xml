<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly"><Border Width="850" Height="1200" Background="#E3A9BC"><Grid><Grid.OpacityMask><ImageBrush ImageSource="{Binding Assets[umbra_print_grain]}" Stretch="Fill"/></Grid.OpacityMask><TextBlock x:Name="TopClassification" Text="UNCLASSIFIED" Width="200" Margin="370,37,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="14" Foreground="#35302F" /><TextBlock x:Name="CopyNumber" Text="3279 - 3" Width="150" Margin="635,37,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="16" Foreground="#35302F" /><TextBlock x:Name="Heading" Text="UNCLASSIFIED&#10;FM FCO 041030Z MAY 82&#10;TO IMMEDIATE CERTAIN MISSIONS AND DEPENDENT TERRITORIES&#10;GUIDANCE TELEGRAM NUMBER 85 OF 4 MAY 1982" Width="655" Margin="132,61,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Consolas" FontSize="14.5" Foreground="#35302F" /><TextBlock x:Name="Subject" Text="FALKLANDS: SINKING OF GENERAL BELGRANO" Width="630" Margin="132,163,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Consolas" FontSize="15" Foreground="#35302F" /><StackPanel x:Name="TelegramBody" Width="540" Margin="132,207,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock x:Name="Opening" Text="1.   IN COUNTERING CRITICISM OF THE FACT THAT THIS SHIP WAS SUNK OUTSIDE THE TOTAL EXCLUSION ZONE (TEZ), YOU SHOULD DRAW ON MR NOTT'S STATEMENT OF 3 MAY (VERBATIM NO 059 REPEATING TELNO 899 TO WASHINGTON (NOT TO ALL)). YOU SHOULD ADD THAT:" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Consolas" FontSize="16" Foreground="#35302F" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,5"/><TextBlock x:Name="Warning" Text="A.   ON 23 APRIL THE SWISS EMBASSY IN BUENOS AIRES PASSED A MESSAGE FROM HMG TO THE ARGENTINE GOVERNMENT, WHICH INCLUDED THE FOLLOWING: 'ANY APPROACH ON THE PART OF ARGENTINE WARSHIPS, INCLUDING SUBMARINES, NAVAL AUXILIARIES OR MILITARY AIRCRAFT, WHICH COULD AMOUNT TO A THREAT TO INTERFERE WITH THE MISSION OF BRITISH FORCES IN THE SOUTH ATLANTIC, WILL ENCOUNTER THE APPROPRIATE RESPONSE'." TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Consolas" FontSize="16" Foreground="#35302F" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,5"/><TextBlock x:Name="Release" Text="B.   THIS MESSAGE WAS IMMEDIATELY CIRCULATED IN THE UN SECURITY COUNCIL AND RELEASED PUBLICLY." TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Consolas" FontSize="16" Foreground="#35302F" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,5"/><TextBlock x:Name="Threat" Text="C.   MOD SPOKESMEN HAVE EXPLAINED THAT EACH COMMANDER IN OUR TASK FORCE TAKES INTO ACCOUNT THE CAPABILITIES OF ANY ARGENTINE VESSEL OR AIRCRAFT, IN CONSIDERING WHETHER IT CONSTITUTES A THREAT, WHICH CALLS FOR A RESPONSE. ONCE SUCH A THREAT IS IDENTIFIED, BECAUSE OF THE NATURE OF MODERN WEAPONS, BRITISH COMMANDERS CANNOT WAIT FOR THE OTHER SIDE TO FIRE FIRST. THUS THE PRESENCE IN ITSELF IS A THREAT." TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Consolas" FontSize="16" Foreground="#35302F" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,5"/><TextBlock x:Name="Signoff" Text="PYM" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Consolas" FontSize="16" Foreground="#35302F" LineHeight="20" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,5"/></StackPanel><TextBlock x:Name="DistributionHeading" Text="BY TELEGRAPH:" Width="230" Margin="132,700,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="14" Foreground="#35302F" TextDecorations="Underline"/><TextBlock x:Name="ImmediateLeft" Text="BRUSSELS (UKREP,EEC)&#10;BRUSSELS (UKDEL,NATO)&#10;STOCKHOLM&#10;MOSCOW" Width="270" Margin="132,723,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="13" Foreground="#35302F" /><TextBlock x:Name="ImmediateMiddle" Text="CARACAS&#10;MEXICO CITY&#10;BRASILIA" Width="180" Margin="398,723,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="13" Foreground="#35302F" /><TextBlock x:Name="ImmediateRight" Text="MONTEVIDEO&#10;CANBERRA&#10;WELLINGTON" Width="200" Margin="590,723,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="13" Foreground="#35302F" /><TextBlock x:Name="ImmediateLabel" Text="[ALL IMMEDIATE]" Width="270" Margin="378,776,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="13" Foreground="#35302F" /><TextBlock x:Name="PriorityColumn1" Text="ANKARA&#10;ISTANBUL&#10;ATHENS&#10;COPENHAGEN&#10;THE HAGUE&#10;LISBON&#10;LUXEMBOURG&#10;OSLO&#10;STRASBOURG (UKDEL)&#10;ROME&#10;BERNE&#10;GENEVA (UKMIS)&#10;DUBLIN&#10;HELSINKI&#10;MADRID&#10;VIENNA (UKMIS IAEA)&#10;WARSAW&#10;SAO PAULO&#10;RIO DE JANEIRO&#10;BOGOTA" Width="260" Margin="132,801,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="13" Foreground="#35302F" LineHeight="13.5" LineStackingStrategy="BlockLineHeight"/><TextBlock x:Name="PriorityColumn2" Text="HAVANA&#10;LIMA&#10;SANTIAGO&#10;ASUNCION&#10;LA PAZ&#10;PANAMA&#10;QUITO&#10;SAN JOSE&#10;SANTO DOMINGO&#10;TEGUCIGALPA&#10;AMMAN&#10;JEDDA&#10;KUWAIT&#10;TEL AVIV&#10;CAIRO&#10;DAKAR&#10;KINSHASA&#10;CAPE TOWN&#10;PRETORIA&#10;ISLAMABAD" Width="180" Margin="398,801,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="13" Foreground="#35302F" LineHeight="13.5" LineStackingStrategy="BlockLineHeight"/><TextBlock x:Name="PriorityColumn3" Text="PEKING&#10;TOKYO&#10;NEW DELHI&#10;DACCA&#10;COLOMBO&#10;ACCRA&#10;LAGOS&#10;NAIROBI&#10;SALISBURY&#10;LUSAKA&#10;KINGSTON&#10;PORT OF SPAIN&#10;GEORGETOWN&#10;BRIDGETOWN&#10;NASSAU&#10;BELMOPAN&#10;HONG KONG&#10;GIBRALTAR (PERSONAL)&#10;ASCENSION ISLAND&#10;ST HELENA" Width="230" Margin="590,801,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="13" Foreground="#35302F" LineHeight="13.5" LineStackingStrategy="BlockLineHeight"/><TextBlock x:Name="PriorityLabel" Text="[ALL PRIORITY]" Width="250" Margin="380,1075,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="13" Foreground="#35302F" /><TextBlock x:Name="Saving" Text="AND SAVING TO CERTAIN OTHER POSTS" Width="430" Margin="132,1126,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="13" Foreground="#35302F" /><TextBlock x:Name="Whitehall" Text="FCO/WHITEHALL&#10; INFORMATION D&#10; EMERGENCY UNIT" Width="340" Margin="132,1148,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="12.5" Foreground="#35302F" /><TextBlock x:Name="Additional" Text="ADDITIONAL DISTRIBUTION&#10;       GUIDANCE&#10;&#10;COPIES TO:&#10;MR FUTTER, CABINET OFFICE" Width="295" Margin="545,1126,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" FontFamily="/Assets/Resources/ui/fonts/#Special Elite" FontSize="12" Foreground="#