<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly"><Border Width="1000" Height="1220" Background="#F5F3EB" TextElement.Foreground="#39372F"><Grid Margin="65,50,75,60"><StackPanel x:Name="WarrantColumn" Margin="180,0,0,145"><TextBlock x:Name="RoyalName" Text="Elizabeth R" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="50" TextWrapping="Wrap" HorizontalAlignment="Right" Margin="0,0,0,20" /><TextBlock x:Name="OpeningName" Text="Elizabeth the Second" FontFamily="/Assets/Resources/ui/fonts/#UnifrakturMaguntia" FontSize="43" TextWrapping="Wrap" /><TextBlock x:Name="RoyalStyle" Text="by the Grace of God of the United Kingdom of Great Britain and Northern Ireland and of Our other Realms and Territories Queen, Head of the Commonwealth, Defender of the Faith, Sovereign of the Most Excellent Order of the British Empire, to Our trusty and well beloved" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="25" TextWrapping="Wrap" LineHeight="29" LineStackingStrategy="BlockLineHeight" /><TextBlock x:Name="Recipient" Text="{Binding CommanderDisplayName}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="30" TextWrapping="Wrap" Margin="0,8,0,0" /><TextBlock x:Name="Service" Text="{Binding NavyName}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="25" TextWrapping="Wrap" /><TextBlock x:Name="Greeting" Text="Greeting" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="34" TextWrapping="Wrap" TextAlignment="Right" Margin="0,8,0,6" /><TextBlock x:Name="Appointment" Text="Whereas We have thought fit to nominate and appoint you to be an Ordinary Commander of the Military Division of Our said Most Excellent Order of the British Empire." FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="27" TextWrapping="Wrap" LineHeight="30" /><TextBlock x:Name="Grant" Text="We do by these presents grant unto you the Dignity of an Ordinary Commander of Our said Order and hereby authorise you to Have Hold and Enjoy the same, together with the privileges belonging to that appointment." FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="27" TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="30" /><TextBlock x:Name="Given" Text="Given at Our Court at Saint James’s under Our Sign Manual and the Seal of Our said Order" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="25" TextWrapping="Wrap" Margin="0,22,0,0" LineHeight="29" /><TextBlock x:Name="Date" Text="{Binding PresentationDate}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="25" TextWrapping="Wrap" Margin="0,6,0,0" /><TextBlock x:Name="Reign" Text="in the Thirty-first Year of Our Reign." FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="25" TextWrapping="Wrap" /><TextBlock x:Name="Command" Text="By the Sovereign’s Command" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="35" TextWrapping="Wrap" Margin="0,16,0,0" TextAlignment="Right" /><TextBlock x:Name="GrandMaster" Text="Philip" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="38" TextWrapping="Wrap" TextAlignment="Right" Margin="0,5,40,0" /><TextBlock x:Name="GrandMasterTitle" Text="Grand Master" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="26" TextWrapping="Wrap" TextAlignment="Right" Margin="0,0,25,0" /></StackPanel><StackPanel Width="600" VerticalAlignment="Bottom" HorizontalAlignment="Left"><TextBlock x:Name="Docket" Text="Grant of the dignity of an Ordinary Commander&#10;of the Military Division of the Order of the British Empire" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="25" TextWrapping="Wrap" /><TextBlock x:Name="DocketName" Text="{Binding CommanderDisplayName}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="27" TextWrapping="Wrap" /></StackPanel></Grid></Border></Viewbox>
