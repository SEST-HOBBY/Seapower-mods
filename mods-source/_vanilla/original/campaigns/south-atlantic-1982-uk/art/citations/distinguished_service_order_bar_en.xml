<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly"><Border Width="700" Height="940" Background="#F8F6EF" TextElement.Foreground="#39372F"><Grid Margin="42,35,42,40"><Grid.RowDefinitions><RowDefinition Height="65" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock x:Name="RunningHead" Text="SUPPLEMENT TO THE LONDON GAZETTE" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" /><StackPanel x:Name="GazetteColumn" Grid.Row="1"><TextBlock x:Name="PublicationDate" Text="{Binding PresentationDate}" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontSize="18" TextWrapping="Wrap" TextAlignment="Right" Margin="0,0,0,18" /><TextBlock x:Name="Department" Text="MINISTRY OF DEFENCE&#10;(NAVY DEPARTMENT)" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontSize="23" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" /><TextBlock x:Name="Notice" Text="Her Majesty The Queen has approved the award of a Bar to the Distinguished Service Order for further distinguished service during the South Atlantic operations." FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontSize="21" TextWrapping="Wrap" LineHeight="28" TextAlignment="Justify" /><TextBlock x:Name="AwardHeading" Text="Bar to the Distinguished Service Order" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontSize="25" TextWrapping="Wrap" TextAlignment="Center" Margin="0,20,0,16" /><TextBlock x:Name="Recipient" Text="{Binding CommanderDisplayName}" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontSize="23" TextWrapping="Wrap" /><TextBlock x:Name="Service" Text="D.S.O., Royal Navy." FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontSize="22" TextWrapping="Wrap" Margin="0,0,0,18" /><TextBlock x:Name="Narrative" Text="{Binding CitationBody}" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontSize="21" TextWrapping="Wrap" TextAlignment="Justify" LineHeight="28" /></StackPanel></Grid></Border></Viewbox>
