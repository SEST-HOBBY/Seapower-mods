<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly"><Border Width="1000" Height="1600" Background="#F5F3EB" TextElement.Foreground="#39372F"><Grid Margin="55,65,65,75"><StackPanel x:Name="WarrantColumn" Margin="185,0,0,190"><TextBlock x:Name="RoyalName" Text="Elizabeth R" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="62" TextWrapping="Wrap" HorizontalAlignment="Right" Margin="0,0,0,20" /><TextBlock x:Name="OpeningName" Text="Elizabeth the Second" FontFamily="/Assets/Resources/ui/fonts/#UnifrakturMaguntia" FontSize="49" TextWrapping="Wrap" /><TextBlock x:Name="RoyalStyle" Text="by the Grace of God of the United Kingdom of Great Britain and Northern Ireland and of Our other Realms and Territories Queen, Head of the Commonwealth, Defender of the Faith, Sovereign of the Distinguished Service Order, to Our trusty and well beloved" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="32" TextWrapping="Wrap" LineHeight="36" LineStackingStrategy="BlockLineHeight" /><TextBlock x:Name="Recipient" Text="{Binding CommanderDisplayName}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="35" TextWrapping="Wrap" Margin="0,14,0,0" TextAlignment="Center" /><TextBlock x:Name="Service" Text="{Binding NavyName}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="32" TextWrapping="Wrap" TextAlignment="Center" /><TextBlock x:Name="Greeting" Text="Greeting" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="42" TextWrapping="Wrap" HorizontalAlignment="Right" Margin="0,6,0,20" /><TextBlock x:Name="Appointment" Text="Whereas We have thought fit to Nominate and Appoint you to be a Member of Our Distinguished Service Order We do by these Presents grant unto you the Dignity of a Companion of Our said Order. And We do hereby authorise you to Have Hold and Enjoy the said Dignity as a Member of Our said Order together with all and singular the Privileges thereunto belonging or appertaining." FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="36" TextWrapping="Wrap" LineHeight="44" LineStackingStrategy="BlockLineHeight" /><TextBlock x:Name="Given" Text="Given at Our Court at Saint James’s under Our Sign Manual" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="35" TextWrapping="Wrap" Margin="0,38,0,0" /><TextBlock x:Name="Date" Text="{Binding PresentationDate}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="35" TextWrapping="Wrap" Margin="0,14,0,0" TextAlignment="Center" /><TextBlock x:Name="Reign" Text="in the Thirty-first Year of Our Reign." FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="34" TextWrapping="Wrap" Margin="0,8,0,0" TextAlignment="Right" /><TextBlock x:Name="Command" Text="By the Sovereign’s Command" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="42" TextWrapping="Wrap" Margin="0,40,0,0" TextAlignment="Right" /></StackPanel><StackPanel VerticalAlignment="Bottom" Width="490" HorizontalAlignment="Left"><TextBlock x:Name="Docket" Text="Companion of the Distinguished Service Order" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="26" TextWrapping="Wrap" /><TextBlock x:Name="DocketName" Text="{Binding CommanderDisplayName}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="28" TextWrapping="Wrap" /></StackPanel></Grid></Border></Viewbox>
