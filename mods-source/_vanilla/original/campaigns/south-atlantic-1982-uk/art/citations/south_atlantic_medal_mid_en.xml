<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly"><Border Width="1050" Height="1030" Background="#FFFFFF" TextElement.Foreground="#39372F"><Grid Margin="55,45,55,40"><Grid.RowDefinitions><RowDefinition Height="145" /><RowDefinition Height="*" /><RowDefinition Height="180" /></Grid.RowDefinitions><Image x:Name="RoyalArms" Source="{Binding SealImage}" Height="125" Stretch="Uniform" HorizontalAlignment="Center" /><StackPanel Grid.Row="1" x:Name="CertificateColumn" VerticalAlignment="Center"><TextBlock x:Name="Order" Text="By the QUEEN’S Order the name of" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontStyle="Italic" FontSize="34" TextWrapping="Wrap" TextAlignment="Center" /><TextBlock x:Name="Recipient" Text="{Binding CommanderDisplayName}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="44" TextWrapping="Wrap" Margin="0,12,0,0" TextAlignment="Center" Foreground="#9F2924" /><TextBlock x:Name="Service" Text="{Binding NavyName}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="41" TextWrapping="Wrap" Margin="0,4,0,18" TextAlignment="Center" Foreground="#9F2924" /><TextBlock x:Name="Publication" Text="was published in the London Gazette on" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontStyle="Italic" FontSize="31" TextWrapping="Wrap" TextAlignment="Center" /><TextBlock x:Name="Date" Text="{Binding PresentationDate}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="40" TextWrapping="Wrap" TextAlignment="Center" Foreground="#9F2924" /><TextBlock x:Name="Mention" Text="as mentioned in a Despatch for distinguished service.&#10;I am charged to record&#10;Her Majesty’s high appreciation." FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontStyle="Italic" FontSize="30" TextWrapping="Wrap" TextAlignment="Center" LineHeight="46" /></StackPanel><StackPanel Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock x:Name="Signature" Text="{Binding SignatureName}" FontFamily="/Assets/Resources/ui/fonts/#Pinyon Script" FontSize="47" TextWrapping="Wrap" Margin="0,0,40,28" TextAlignment="Center" /><TextBlock x:Name="SignatureTitle" Text="{Binding SignatureTitle}" FontFamily="/Assets/Resources/ui/fonts/#Noto Serif" FontStyle="Italic" FontSize="22" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Grid></Border></Viewbox>
