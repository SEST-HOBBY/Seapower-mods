<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="Both" x:Name="CampaignBookRoot">
<Viewbox.Resources>
<Style x:Key="BookArrow" TargetType="{x:Type Button}">
<Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#AEB6BE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="58"/><Setter Property="FontWeight" Value="Light"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border Background="{TemplateBinding Background}"><TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="58" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#28383B3F"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Visibility" Value="Hidden"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<DataTemplate x:Key="ServiceRow">
<Border Height="178" BorderBrush="#9A9B93" BorderThickness="0,0,0,1" Padding="0,20,0,20">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="328"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
<TextBlock Text="{Binding DisplayName}" Foreground="#202528" FontFamily="Arial" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" LineHeight="27"/>
<TextBlock Text="{Binding TypeLine}" Foreground="#303633" FontFamily="Arial" FontSize="14" TextWrapping="Wrap" Margin="0,5,0,0"/>
<Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="EXPERIENCE" Foreground="#303633" FontFamily="Arial" FontSize="10"/><TextBlock Text="{Binding ProficiencyDisplay}" Foreground="#202528" FontFamily="Arial" FontSize="16" Margin="0,5,0,0"/></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="BATTLE HONOURS" Foreground="#303633" FontFamily="Arial" FontSize="10"/><TextBlock Text="{Binding MissionsSurvivedDisplay}" Foreground="#202528" FontFamily="Arial" FontSize="16" Margin="0,5,0,0"/></StackPanel>
</Grid></StackPanel>
<Image Grid.Column="1" Stretch="Uniform" MaxHeight="128" MaxWidth="328">
<Image.Style><Style TargetType="{x:Type Image}"><Setter Property="Source"><Setter.Value><MultiBinding Converter="{StaticResource IniToProfileConverter}"><Binding Path="UnitType"/><Binding Path="VariantIndex"/></MultiBinding></Setter.Value></Setter></Style></Image.Style>
</Image>
</Grid></Border>
</DataTemplate>
<DataTemplate x:Key="CompactServiceRow">
<Border Height="105" BorderBrush="#9A9B93" BorderThickness="0,0,0,1" Padding="0,8">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center" Margin="0,0,6,0">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Width="16" Height="11" Source="{Binding NationFlag}" Stretch="Uniform" VerticalAlignment="Top" Margin="0,3,6,0"/><TextBlock Grid.Column="1" Text="{Binding DisplayNameWithQuantity}" Foreground="#202528" FontFamily="Arial" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" LineHeight="16"/></Grid>
<TextBlock Text="{Binding TypeLine}" Foreground="#303633" FontFamily="Arial" FontSize="11" Margin="22,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
<Border Background="#B5A58A" Padding="7,2" Margin="22,5,0,0" HorizontalAlignment="Left" MinWidth="70"><TextBlock Text="{Binding ProficiencyDisplay}" Foreground="#202528" FontFamily="Arial" FontSize="10" FontWeight="Bold" TextAlignment="Center"/></Border>
<TextBlock Foreground="#303633" FontFamily="Arial" FontSize="10" Margin="22,4,0,0"><Run Text="BATTLE HONOURS  "/><Run Text="{Binding MissionsSurvivedDisplay}" FontWeight="Bold"/></TextBlock>
</StackPanel>
<Image Grid.Column="1" Width="116" Height="72" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center"><Image.Source><MultiBinding Converter="{StaticResource IniToProfileConverter}"><Binding Path="UnitType"/><Binding Path="VariantIndex"/></MultiBinding></Image.Source></Image>
</Grid></Border>
</DataTemplate>
</Viewbox.Resources>
<Grid Width="1050" Height="1004" DataContext="{Binding Document.ServiceBook}">
<Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition Width="754"/><ColumnDefinition Width="148"/></Grid.ColumnDefinitions>
<Grid Grid.Column="1"><Border Width="754" Height="1004" TextElement.FontFamily="Arial">
<Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsCover}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
<Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8"><GradientStop Color="#171B24" Offset="0"/><GradientStop Color="#292C37" Offset="0.45"/><GradientStop Color="#30333E" Offset="1"/></LinearGradientBrush></Border.Background>
<Grid ClipToBounds="True"><Border Width="14" HorizontalAlignment="Left" Background="#10151D"/><Border BorderBrush="#414450" BorderThickness="0,0,1,1" Margin="15,5,5,5"/>
<StackPanel Margin="100,118,72,0" VerticalAlignment="Top">
<TextBlock Text="JAMES’" FontFamily="/Assets/Resources/ui/fonts/#Roboto" Foreground="#EFEFE8" FontSize="79" TextAlignment="Right" FontWeight="Light"/>
<TextBlock Text="FIGHTING" FontFamily="/Assets/Resources/ui/fonts/#Roboto" Foreground="#EFEFE8" FontSize="53" TextAlignment="Right" Margin="0,-9,0,0"/>
<TextBlock Text="SHIPS" FontFamily="/Assets/Resources/ui/fonts/#Roboto" Foreground="#EFEFE8" FontSize="53" TextAlignment="Right" Margin="0,-10,0,0"/>
<TextBlock Text="1982–83" Foreground="#EFEFE8" FontSize="77" FontFamily="Times New Roman" TextAlignment="Right"/>
</StackPanel>
<TextBlock Text="South Atlantic edition" Foreground="#EFEFE8" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,527,72,0"/>
<TextBlock Text="A record of the ships and squadrons in service" Foreground="#EFEFE8" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,641,72,0"/>
<StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,817,72,0">
<TextBlock Text="Royal Navy" Foreground="#EFEFE8" FontSize="24" TextAlignment="Right"/>
<TextBlock Text="Royal Fleet Auxiliary" Foreground="#EFEFE8" FontSize="24" TextAlignment="Right"/>
<TextBlock Text="Fleet Air Arm" Foreground="#EFEFE8" FontSize="24" TextAlignment="Right"/>
</StackPanel></Grid></Border><Border Width="754" Height="1004" Background="#D0C7B4">
<Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsUnitPage}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
<Grid>
<Grid Margin="38,25,38,0" Height="42" VerticalAlignment="Top"><StackPanel VerticalAlignment="Center"><TextBlock Text="JAMES’ FIGHTING SHIPS" FontFamily="Arial" FontSize="17" FontWeight="Bold" Foreground="#202528"/><TextBlock Text="UNITED KINGDOM · SOUTH ATLANTIC · 1982–83" FontFamily="Arial" FontSize="11" Foreground="#303633" Margin="0,5,0,0"/></StackPanel></Grid>
<Grid DataContext="{Binding CurrentPage}" Margin="38,102,38,70">
<Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="712"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Ships &amp; squadrons" Foreground="#202528" FontFamily="Arial" FontSize="38" FontWeight="Bold"/><Rectangle Height="2" Fill="#202528" Margin="0,18,0,0"/></StackPanel>
<ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ServiceRow}"/>
</Grid>
<Grid Margin="38,0,38,25" Height="24" VerticalAlignment="Bottom"><TextBlock Text="JAMES’ FIGHTING SHIPS" Foreground="#303633" FontFamily="Arial" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="{Binding PageLabel}" Foreground="#202528" FontFamily="Arial" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
</Grid></Border></Grid>
<Grid Grid.Column="1" Width="778" DataContext="{Binding DataContext, ElementName=CampaignBookRoot}">
<Grid.Style><Style TargetType="{x:Type Grid}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Document.ServiceBook.IsFullRecord}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
<Grid.RowDefinitions><RowDefinition Height="950"/><RowDefinition Height="54"/></Grid.RowDefinitions>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Center" CanContentScroll="False">
<Border x:Name="ServiceBookExportRoot" Width="754" Height="{Binding Document.ServiceBook.FullRecordHeight}" Background="#D0C7B4">
<StackPanel Margin="38,25,38,25">
<Grid Height="42" Margin="0,0,0,35"><StackPanel VerticalAlignment="Center"><TextBlock Text="JAMES’ FIGHTING SHIPS" FontFamily="Arial" FontSize="17" FontWeight="Bold" Foreground="#202528"/><TextBlock Text="UNITED KINGDOM · SOUTH ATLANTIC · 1982–83" FontFamily="Arial" FontSize="11" Foreground="#303633" Margin="0,5,0,0"/></StackPanel></Grid>
<StackPanel Height="92"><TextBlock Text="Ships &amp; squadrons" Foreground="#202528" FontFamily="Arial" FontSize="38" FontWeight="Bold"/><Rectangle Height="2" Fill="#202528" Margin="0,18,0,0"/></StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="SHIPS &amp; SUBMARINES" Foreground="#202528" FontFamily="Arial" FontSize="13" FontWeight="Bold" Height="28"/>
<ItemsControl ItemsSource="{Binding Document.ServiceBook.SurfaceRows}" ItemTemplate="{StaticResource CompactServiceRow}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
<Rectangle Grid.Column="1" Width="1" Fill="#9A9B93" HorizontalAlignment="Center"/>
<StackPanel Grid.Column="2"><TextBlock Text="AIRCRAFT SQUADRONS" Foreground="#202528" FontFamily="Arial" FontSize="13" FontWeight="Bold" Height="28"/>
<ItemsControl ItemsSource="{Binding Document.ServiceBook.SquadronRows}" ItemTemplate="{StaticResource CompactServiceRow}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
</Grid>
<TextBlock Text="COMPLETE SERVICE RECORD" Foreground="#303633" FontFamily="Arial" FontSize="10" Height="24" Margin="0,25,0,0"/>
</StackPanel>
</Border>
</ScrollViewer>
<Grid Grid.Row="1" Margin="12,12,12,0">
<TextBlock Text="{Binding Document.ServiceBook.PageLabel}" Foreground="{StaticResource Brush.Foreground.Normal}" FontSize="14" VerticalAlignment="Center"/>
<Button Content="{Binding LanguageDictionary[freecontentexportpng], Source={StaticResource LanguageResourceInterface}}" Command="{Binding ExportPngCommand}" CommandParameter="ServiceBookExportRoot" Width="150" Height="38" HorizontalAlignment="Right" VerticalAlignment="Center"/>
</Grid>
</Grid>
<Button Grid.Column="0" Width="96" Height="190" Style="{StaticResource BookArrow}" Content="&lt;" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"/>
<Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource BookArrow}" Content="&gt;" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"/>
</Grid></Viewbox>