<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
  <!-- Fictional campaign assessment in the REJOICE paper format. The host supplies
       CampaignVariables from the source mission configured in campaign.ini.
       Each Run changes only its own sentence. Both British losses replace the whole report.
       False loss flags mean afloat, not undamaged. Missing flags never assert survival. -->
  <Border Width="900" Height="1280" BorderBrush="#777C72" BorderThickness="1" TextElement.Foreground="#363A35"
          TextElement.FontFamily="/Assets/Resources/ui/fonts/#Special Elite" TextElement.FontSize="22">
    <Border.Resources><Style x:Key="Paragraph" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="28"/>
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="Margin" Value="0,0,0,22"/>
    </Style></Border.Resources>
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
      <GradientStop Color="#D8DCD2" Offset="0"/><GradientStop Color="#E7E9DF" Offset="0.35"/>
      <GradientStop Color="#DADFD5" Offset="0.78"/><GradientStop Color="#C9CEC5" Offset="1"/>
    </LinearGradientBrush></Border.Background>
    <Grid>
      <Canvas IsHitTestVisible="False" ClipToBounds="True">
        <Path Fill="#333832" Data="M 41,57 C 53,57 62,65 65,77 C 62,89 52,94 44,88 L 39,77 Z"/>
        <Path Stroke="#70776B" StrokeThickness="1.1" Data="M 42,62 L 31,45 29,29 23,19 21,5 M 35,48 L 43,52 44,65"/>
        <Path Stroke="#FFFDF0" StrokeThickness="2" Opacity="0.26" Data="M 820,1279 L 899,1192"/>
      </Canvas>
      <TextBlock Text="SECRET UK EYES B" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0"/>
      <Border Margin="0,82,70,0" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#74776D" BorderThickness="1" Padding="12,7" Opacity="0.55" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><RotateTransform Angle="-2"/></Border.RenderTransform><TextBlock Text="ADVANCE COPY" FontSize="23"/>
      </Border>
      <StackPanel x:Name="ReportBody" Width="730" Margin="85,175,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock Text="OPERATION CORPORATE" TextDecorations="Underline"/>
        <TextBlock Margin="0,8,0,22"><Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value="INTELLIGENCE SUMMARY"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[ForceFlagshipLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[ForceFlagshipLost].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="SITUATION REPORT"/></MultiDataTrigger></Style.Triggers></Style></Run.Style></Run></TextBlock>
        <TextBlock Text="FROM: CINCFLEET NORTHWOOD&#10;TO: CTG 317.8&#10;2 MAY 1982" LineHeight="28" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,24"/>
<StackPanel x:Name="NormalReport"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[ForceFlagshipLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[ForceFlagshipLost].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Style="{StaticResource Paragraph}"><Run Text="1. SITUATION: " TextDecorations="Underline"/><Run Text="Today the Task Force engaged the Argentine Navy at sea east of the Falklands. "/><Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value=""/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="HMS INVINCIBLE and HMS HERMES remain afloat. "/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="HMS HERMES was lost during the action. HMS INVINCIBLE remains afloat. "/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="HMS INVINCIBLE was lost during the action. HMS HERMES remains afloat. "/></MultiDataTrigger></Style.Triggers></Style></Run.Style></Run>
          <Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value="The status of VEINTICINCO DE MAYO remains unconfirmed. "/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="Our forces have sunk VEINTICINCO DE MAYO. "/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="VEINTICINCO DE MAYO withdrew beyond striking range and is presumed retiring west. "/></MultiDataTrigger></Style.Triggers></Style></Run.Style></Run>
          <Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value=""/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The Task Force retains both carriers for further operations."/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The loss of HERMES has greatly reduced the Task Force's flexibility of action."/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The loss of INVINCIBLE has greatly reduced the Task Force's flexibility of action."/></MultiDataTrigger></Style.Triggers></Style></Run.Style></Run></TextBlock>
        <TextBlock Style="{StaticResource Paragraph}"><Run Text="2. AIR AND SUBMARINE THREAT: " TextDecorations="Underline"/><Run Text="Mainland-based Argentine aircraft remain capable of attacking the Task Force. "/><Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value="The status of VEINTICINCO DE MAYO remains unconfirmed. "/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The destruction of VEINTICINCO DE MAYO removes the immediate threat of carrier-launched strikes. "/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="VEINTICINCO DE MAYO remains a threat. Her withdrawal may be temporary, and a further sortie in conjunction with mainland aircraft cannot be excluded. "/></MultiDataTrigger></Style.Triggers></Style></Run.Style></Run>
          <Run Text="Argentine submarine dispositions remain uncertain. The absence of recent contacts does not establish that the area is clear."/></TextBlock>
        <TextBlock Style="{StaticResource Paragraph}"><Run Text="3. ENEMY INTENTIONS: " TextDecorations="Underline"/><Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value="The status of VEINTICINCO DE MAYO remains unconfirmed. "/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="Following the loss of their carrier, the Argentines are likely to rely more heavily on mainland aircraft and submarines to contest British operations. "/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The Argentines are likely to preserve their carrier while seeking another opportunity to attack under favourable conditions. "/></MultiDataTrigger></Style.Triggers></Style></Run.Style></Run>
          <Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value=""/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="Both British carriers remain afloat and are likely to remain priority targets."/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="HMS INVINCIBLE is likely to become the principal target. Her loss would remove the Task Force's remaining carrier-based air cover."/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="HMS HERMES is likely to become the principal target. Her loss would remove the Task Force's remaining carrier-based air cover."/></MultiDataTrigger></Style.Triggers></Style></Run.Style></Run></TextBlock>
        <TextBlock Style="{StaticResource Paragraph}"><Run Text="4. ASSESSMENT: " TextDecorations="Underline"/><Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value="The effect of this engagement on the balance at sea cannot yet be fully assessed."/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The balance at sea has improved considerably. Argentine air and submarine forces nevertheless retain the ability to inflict serious losses."/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The destruction of the Argentine carrier is a significant success, but the loss of HMS HERMES leaves the Task Force dependent upon HMS INVINCIBLE for carrier-based air cover."/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The destruction of the Argentine carrier is a significant success, but the loss of HMS INVINCIBLE leaves the Task Force dependent upon HMS HERMES for carrier-based air cover."/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The engagement has not removed the principal enemy naval threat. Further carrier action remains possible."/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The balance at sea has deteriorated. The enemy retains his carrier while the Task Force is now dependent upon HMS INVINCIBLE for carrier-based air cover."/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Bool}" Value="False"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Bool}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="The balance at sea has deteriorated. The enemy retains his carrier while the Task Force is now dependent upon HMS HERMES for carrier-based air cover."/></MultiDataTrigger></Style.Triggers></Style></Run.Style></Run></TextBlock></StackPanel><StackPanel x:Name="DefeatReport"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[ForceFlagshipLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[ForceFlagshipLost].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="CAMPAIGN DEFEAT" FontSize="25" Margin="0,0,0,25"/><TextBlock Style="{StaticResource Paragraph}"><Run Text="1. SITUATION: " TextDecorations="Underline"/><Run Text="The force flagship has been lost. Command of Operation CORPORATE can no longer be sustained."/></TextBlock>
        <TextBlock Style="{StaticResource Paragraph}"><Run Text="2. ENEMY THREAT: " TextDecorations="Underline"/><Run Text="Argentine mainland aircraft and submarines remain a threat to the surviving force. "/><Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value="The status of VEINTICINCO DE MAYO remains unconfirmed. "/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="VEINTICINCO DE MAYO has also been sunk, but her destruction does not offset the loss of the force flagship."/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_DeMayoSunk].Bool}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="VEINTICINCO DE MAYO remains afloat and may be employed against the surviving British force."/></MultiDataTrigger></Style.Triggers></Style></Run.Style></Run></TextBlock>
        <TextBlock Style="{StaticResource Paragraph}"><Run Text="3. ASSESSMENT: " TextDecorations="Underline"/><Run Text="The loss of the force flagship has ended the present expedition. Operation CORPORATE has failed."/></TextBlock></StackPanel>
        <TextBlock x:Name="UnconfirmedReport" Text="Carrier loss reports are incomplete. The outcome of the engagement and its effect on the balance at sea cannot yet be assessed." TextWrapping="Wrap" LineHeight="28" Margin="0,0,0,22">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CampaignVariables[UK_HermesLost].Exists}" Value="True"/><Condition Binding="{Binding CampaignVariables[UK_InvincibleLost].Exists}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Text="CINCFLEET NORTHWOOD" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock Text="SECRET UK EYES B" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,32"/>
    </Grid>
  </Border>
</Viewbox>
