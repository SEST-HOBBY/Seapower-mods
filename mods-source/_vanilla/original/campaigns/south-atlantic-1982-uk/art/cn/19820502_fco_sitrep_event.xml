      <StackPanel x:Name="Article2" Width="710" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,220,0,0">
      <TextBlock Text="Japan" TextWrapping="Wrap" LineHeight="21" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,14" TextDecorations="Underline"/><TextBlock Text="10. The international press reported that the Japanese Government had imposed economic sanctions against Argentina. The Japanese Embassy in Buenos Aires said this was unfounded and false." TextWrapping="Wrap" LineHeight="21" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,14" />
