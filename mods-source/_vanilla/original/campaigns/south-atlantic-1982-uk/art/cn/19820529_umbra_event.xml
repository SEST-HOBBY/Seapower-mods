   <!-- Edit each complete routing entry or paragraph below. Margins set paragraph spacing. -->
   <StackPanel x:Name="Page4_ReportBody" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Left" Width="570" Margin="66,0,0,0"><StackPanel.LayoutTransform><ScaleTransform ScaleX="1.23"/></StackPanel.LayoutTransform>
   <TextBlock x:Name="Page4_Continuation" Text="SUPPORT, WHICH BECOMES UNACCEPTABLE BECAUSE OF THE LOSSES SUFFERED&#10;WHEN IT IS CARRIED OUT." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page4_AirSituation" Text="AIR SITUATION:" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page4_AirAssessment" Text="THE ENEMY HAS ABSOLUTE AIR SUPERIORITY AND HAS SIGNIFICANTLY&#10;INCREASED ITS QUANTITY OF PLANES. AT THE SAME TIME THERE ARE&#10;STRONG INDICATIONS THAT IN SAN CARLOS THEY WERE ((B%&#10;PREPARING))((II)) HARRIER PLANES WHICH WOULD THEN INCREASE THE&#10;AIRCRAFT CARRIER'S COMPLEMENT. APART FROM AIR DEFENCE THEY ARE&#10;CARRYING OUT CONSTANT HARASSMENT AND ATTACKS ON OUR POSITIONS,&#10;HAVING ACHIEVED THE DESTRUCTION OF AN IMPORTANT NUMBER OF PUCARA&#10;PLANES AND HELICOPTERS AND THEREFORE NULLIFIED OUR CAPACITY FOR&#10;SIGNIFICANT HELICOPTER TRANSPORT OPERATIONS." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page4_Part4" Text="PART IV OF VI PARTS" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page4_CloseSupport" Text="THE PROFITABILITY OF DIRECT FIRE SUPPORT GROWS LESS EVERY DAY,&#10;GIVEN THAT TO THE FRAGILITY AND INEPTITUDE OF THE PUCARA PLANE FOR&#10;THIS THEATRE IS ADDED THE GREAT DENSITY OF ANTI-AIR WEAPONS,&#10;ESPECIALLY THE PORTABLE MISSILES POSSESSED BY THE ENEMY, A&#10;CONSIDERATION EQUALLY VALID FOR THESE OPERATIONS WITH PLANES FROM&#10;THE MAINLAND. THE TREMENDOUS EFFORT MADE BY THE AIR FORCE IN&#10;DESTROYING NAVAL UNITS HAS NOT SUCCEEDED IN AFFECTING THE AIR&#10;SUPREMCY POSSESSED BY THE ENEMY WHICH ALLOWS HIM TO DEVELOP AIR AND&#10;HELICOPTER TRANSPORT OPERATIONS WITH ABSOLUTE FREEDOM OF ACTION." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page4_NavalSituation" Text="NAVAL SITUATION:" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page4_NavalAssessment" Text="THE ENEMY HAS BEEN GRANTED ABSOLUTE CONTROL OF THE SEA, WHICH&#10;PERMITS HIM TO REINFORCE AND SUPPLY THE BEACHHEAD DURING THE NIGHT,&#10;CARRY OUT NAVAL FIRE TO SOFTEN UP OUR POSITIONS OR SUPPORT LAND&#10;MANOEUVRES BY ITS OWN TROOPS, IMPLEMENT THE EFFECTIVE NAVAL&#10;BLOCKADE OF THIS HARBOUR, DESTROY WITHOUT OPPOSITION THE MERCHANT&#10;VESSELS STILL ASSIGNED, AND HAVE AVAILABLE AN EFFICIENT SYSTEM OF&#10;AIR-TACTICAL SURVEILLANCE AND CONTROL WHICH PUTS OUR PLANES IN A&#10;SERIOUSLY INFERIOR POSITION." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page4_Part5" Text="PART V OF VI PARTS" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page4_OverallSituation" Text="THIS SITUATION, WHICH IT HAS NOT BEEN POSSIBLE TO MODIFY IN SPITE&#10;OF THE DESTRUCTION OF A HIGH NUMBER OF SURFACE UNITS THROUGH AIR&#10;ATTACKS, PUTS THE ENEMY IN UNSURPASSABLE CONDITIONS TO EXTEND THE&#10;OCCUPATION OF THE ISLANDS." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,0"/>
   </StackPanel>
