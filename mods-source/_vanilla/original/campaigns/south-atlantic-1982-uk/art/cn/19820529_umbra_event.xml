   <StackPanel x:Name="Page5_ReportBody" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Left" Width="570" Margin="66,0,0,0"><StackPanel.LayoutTransform><ScaleTransform ScaleX="1.23"/></StackPanel.LayoutTransform>
   <TextBlock x:Name="Page5_Conclusions" Text="CONCLUSIONS:" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page5_AssessmentLead" Text="FROM THE ABOVE IT IS ASSESSED THAT:" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page5_Conclusion1" Text="1)   WHEN THE ENEMY DECIDES TO OPERATE AGAINST OUR POSITIONS,&#10;HE WILL FIND A DEFENCE LACKING IN MOBILITY AND WITH RELATIVELY LESS&#10;FIRE POWER AND TRAINING, WHICH IT IS CONSIDERED WILL PREVIOUSLY&#10;HAVE BEEN SOFTENED UP BY INTENSE NAVAL FIRE AND AIR SUPPORT." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page5_Part6" Text="PART VI OF VI PARTS" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page5_Conclusion2" Text="2)   THE ENEMY MAINTAINS AN AIR SUPERIORITY WHICH IT HAS NOT BEEN&#10;POSSIBLE TO BREAK IN SPITE OF THE EFFORT MADE BY THE AIR FORCE.&#10;THE CAPABILITY TO CONTROL EQUIPMENT AND THE HIGH DENSITY OF&#10;ANTI-AIR WEAPONRY MAKE THE LOSSES SUFFERED IN THE ATTEMPTS MADE TO&#10;PROVIDE CLOSE SUPPORT FIRE UNACCEPTABLE." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page5_Conclusion3" Text="3)   THE ENEMY MAINTAINS ABSOLUTE SUPREMACY AT SEA, WITH ALL THE&#10;OPERATIONAL AND LOGISTICAL CONSEQUENCES WHICH THIS IMPLIES, ((AND))&#10;A MODIFICATION OF THIS SITUATION IS NOT ANTICIPATED BECAUSE OF THE&#10;TOTAL ABSENCE OF OUR NAVAL RESOURCES. THIS MESSAGE IS TOP&#10;SECRET." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page5_Footnote1" Text="FOOTNOTES:  ((I))  'DESEQUILIBRANTES' IN TEXT." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
   <TextBlock x:Name="Page5_Footnote2" Text="           ((II))  'ARMANDO' IN TEXT." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,0"/>
