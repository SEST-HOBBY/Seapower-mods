   <TextBlock x:Name="Page3_From" Text="FROM:  COMMANDER FALKLANDS GROUP" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_To" Text="TO:    COMMANDER SOUTHERN AIR FORCE" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_Info" Text="INFO:  COMMANDER IN CHIEF OF THE ARGENTINE AIR FORCE&#10;       COMMANDER STRATEGIC AIR COMMAND" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_Date" Text="INTERNAL DTG:  2905821500" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_Number" Text="NO:  ZVS 133/FC" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_Part1" Text="PART I OF VI PARTS" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_Introduction" Text="I REPORT THE DEVELOPMENT OF THE TACTICAL SITUATION IN THE FALKLANDS&#10;THEATRE:" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_LandSituation" Text="LAND SITUATION:" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_Paragraph1" Text="IN THE OPERATION ON DARWIN THE ENEMY DEMONSTRATED GREAT MOBILITY&#10;THROUGH ((THE USE OF)) HELICOPTERS, OVERWHELMING LAND FIRE POWER&#10;AND ANTI-AIR ((FIRE POWER)) THROUGH THE USE OF PORTABLE MISSILES, AS&#10;WELL AS EXCELLENT TRAINING AND OUTFITTING FOR NIGHT COMBAT, ACTING&#10;IN EXACT COORDINATION WITH SUPPORTING NAVAL FIRE, EMPLOYING IT AS&#10;BACK-UP AND RELIEF FOR THE TROOPS ENGAGED IN THE FRONT LINE." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_Part2" Text="PART II OF VI PARTS" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_Paragraph2" Text="OUR OWN FORCE OFFERED STRENUOUS RESISTANCE BUT PROBLEMS IN THE&#10;CONDUCT AND CONTROL OF OUR OWN TROOPS BECAME OBVIOUS. LACKING IN&#10;ADEQUATE COMMUNICATIONS AND SUFFICIENT TRAINING, THEY FELL INTO&#10;CONFUSION AND WERE UNABLE TO DERIVE ((ANY)) ADVANTAGE FROM THE&#10;PUCARA'S SUPPORTING FIRE WHICH FORCED THE ENEMY TO YIELD&#10;POSITIONS TEMPORARILY. THE SUPERIOR TRAINING AND OUTFITTING OF&#10;ENEMY TROOPS, THE GREAT CAPACITY OF THE HELICOPTERS FOR NIGHT-TIME&#10;MOBILITY AND NAVAL ARTILLERY SUPPORT, BECAME DECISIVE((I)) FACTORS&#10;DURING THE BATTLE AND REPRESENT THE MOST IMPORTANT DIFFERENCES WITH&#10;OUR OWN TROOPS' CAPABILITIES." LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_Part3" Text="PART III OF VI PARTS" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,17"/>
<TextBlock x:Name="Page3_Paragraph3" Text="THE CONDUCT OF THE LAND ELEMENT, WITH AN ERRONEOUS CONCEPTION OF&#10;THE USE OF AIR EQUIPMENT, OVERESTIMATES THE LATTER'S CAPABILITIES&#10;AND RELIES EXCLUSIVELY ON THEM FOR THE ANNIHILATION OF THE ENEMY,&#10;WITHOUT UNDERSTANDING THE REDUCED PROFITABILITY OF DIRECT FIRE" LineHeight="17.5" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,0"/>
   </StackPanel>
