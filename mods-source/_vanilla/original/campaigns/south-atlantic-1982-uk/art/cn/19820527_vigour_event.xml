<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Stretch="Uniform" StretchDirection="DownOnly">
  <!-- Editable signal from DEFE 68/630 f35. Preserve the source date and registry serial. -->
  <Border Width="1000" Height="957" BorderBrush="#777C72" BorderThickness="1"
          TextElement.Foreground="#363A35" TextElement.FontSize="18"
          TextElement.FontFamily="/Assets/Resources/ui/fonts/#Special Elite">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
        <GradientStop Color="#D8DCD2" Offset="0"/>
        <GradientStop Color="#E7E9DF" Offset="0.35"/>
        <GradientStop Color="#DADFD5" Offset="0.78"/>
        <GradientStop Color="#C9CEC5" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Border Width="2" Background="#9A9F94" Opacity="0.10" HorizontalAlignment="Center"/>
      <Border Width="1" Background="#F3F4E9" Opacity="0.5" HorizontalAlignment="Center" Margin="4,0,0,0"/>
      <Grid Margin="90,35,35,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="140"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Ellipse Width="14" Height="21" Fill="#616456" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-32,20,0,0"/>
        <TextBlock x:Name="Circulation" Text="CLFFI" FontFamily="Segoe Print" FontSize="22" Foreground="#254D88"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,38,0"/>
        <Border Width="59" Height="49" CornerRadius="28" BorderBrush="#963426" BorderThickness="3"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,40,0" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><RotateTransform Angle="-8"/></Border.RenderTransform>
          <TextBlock Text="16" FontFamily="Segoe Print" FontSize="30" Foreground="#963426" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
        </Border>

        <!-- The blue EFFECTIVE insert follows the handwritten correction in the scan.
             Other overwritten letters are resolved into their legible corrected words. -->
        <StackPanel Grid.Row="1" Margin="22,0,35,0" Opacity="0.84">
          <TextBlock x:Name="RoutingFlags" Text="HH" FontSize="15" Margin="57,0,0,0"/>
          <TextBlock x:Name="Routing" LineHeight="19" LineStackingStrategy="BlockLineHeight"
                     Text="O 271100Z MAY 82&#10;FM CTF 317&#10;TO CTG 317.8&#10;CTG 317.0&#10;CTG 317.1&#10;CTU 317.1.1&#10;BT&#10;S E C R E T EXCLUSIVE UK EYES BRAVO&#10;SIC AAA/ACA/I9N&#10;OPERATION SUTTON. EXCLUSIVE FOR CDRS."/>
          <TextBlock x:Name="Paragraph1" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Text="1. AFTER THE EVENTS OF THE LAST FEW DAYS, NOT LEAST THE REDUCED&#10;BUT CONTINUING CAPABILITY OF THE ARG AIR FORCE, MY THOUGHTS ARE AS&#10;FOLLOWS."/>
          <TextBlock x:Name="Paragraph2A" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Text="2. A. CONSOLIDATION ASHORE IS PROCEEDING SATISFACTORILY."/>
          <TextBlock x:Name="Paragraph2B" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Text="B. THE AIR THREAT TO LAND FORCES IS CAPABLE OF INFLICTING SOME&#10;ATTRITION, BUT CANNOT BE DECISIVE."/>
          <TextBlock x:Name="Paragraph2C" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Text="C. AIR THREAT AGAINST SHIPS PARTICULARLY CVS COULD, IN THE WORST&#10;CASE, BRING THE WHOLE OPERATION TO A HALT."/>
          <TextBlock x:Name="Paragraph2D" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Text="D. SM THREAT IS CURRENTLY SMALL."/>
          <TextBlock x:Name="Paragraph2E" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"><Run Text="E. SURFACE THREAT IS POTENTIALLY CONSIDERABLE BUT WE HAVE A FAIR"/><LineBreak/><Run Text="CHOICE OF "/><Run Text="EFFECTIVE" FontFamily="Segoe Print" Foreground="#254D88" FontSize="17"/><LineBreak/><Run Text="COUNTERS PROVIDING WE GET REASONABLE"/><LineBreak/><Run Text="WARNING."/></TextBlock>
          <TextBlock x:Name="Paragraph3" LineHeight="19" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     Text="3. I DEDUCE FROM THIS THAT THE WAR MUST BE WON ASHORE, BUT COULD BE&#10;LOST AT SEA. WE MUST THEREFORE PRESS ON TO STANLEY WITH THE GREATEST&#10;VIGOUR, DASH AND DRIVE. FORCES AT SEA MUST IN CONTRAST OPERATE&#10;WITH CAUTION TO ENSURE THE SURVIVAL OF THE FLEET IN BEING WHILE AT THE&#10;SAME TIME KEEPING A FLOW OF SUPPLIES MOVING ASHORE."/>
          <TextBlock Text="BT"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="NNNN'3" Opacity="0.75" VerticalAlignment="Bottom" Margin="22,0,0,40"/>
      <!-- Remove or comment out the whole Grid below to hide the registry stamp. -->
      <Grid x:Name="RegistryStamp" Grid.Row="2" Width="302" Height="185" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            TextElement.Foreground="#AE2F36" TextElement.FontFamily="Arial" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><RotateTransform Angle="0.6"/></Grid.RenderTransform>
        <Grid.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.25,1">
            <GradientStop Color="#F0000000" Offset="0"/>
            <GradientStop Color="#C0000000" Offset="0.16"/>
            <GradientStop Color="#E8000000" Offset="0.18"/>
            <GradientStop Color="#AC000000" Offset="0.22"/>
            <GradientStop Color="#F0000000" Offset="0.24"/>
            <GradientStop Color="#CF000000" Offset="0.46"/>
            <GradientStop Color="#F0000000" Offset="0.49"/>
            <GradientStop Color="#B8000000" Offset="0.71"/>
            <GradientStop Color="#ED000000" Offset="0.73"/>
            <GradientStop Color="#F0000000" Offset="1"/>
          </LinearGradientBrush>
        </Grid.OpacityMask>
        <Border BorderBrush="#AE2F36" BorderThickness="3" Padding="10,8,10,8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="35"/>
              <RowDefinition Height="34"/>
              <RowDefinition Height="34"/>
              <RowDefinition Height="34"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StampHQRM" Text="HQRM" FontWeight="Bold" FontSize="30" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StampTitle" Grid.Row="1" Text="TOP SECRET REGISTRY" FontWeight="Bold" FontSize="21" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="MOD FORM 102 No. ....................." FontSize="18"/>
            <TextBlock Grid.Row="3" Text="SERIAL NUMBER.........................." FontSize="18"/>
            <TextBlock x:Name="StampSerial" Grid.Row="3" Text="16" FontFamily="Segoe Print" Foreground="#35342F" FontSize="22" Margin="186,-8,0,0"/>
            <TextBlock Grid.Row="4" Text="DATE..........................................." FontSize="18"/>
            <TextBlock x:Name="StampDate" Grid.Row="4" Text="27 may 82" FontFamily="Segoe Print" Foreground="#35342F" FontSize="20" Margin="66,-8,0,0"/>
          </Grid>
        </Border>
      </Grid>
      <!-- End of registry stamp. -->
      </Grid>
    </Grid>
  </Border>
</Viewbox>