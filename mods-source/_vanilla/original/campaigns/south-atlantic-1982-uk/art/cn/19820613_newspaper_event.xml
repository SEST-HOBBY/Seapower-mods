<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
  <!-- Change text values to edit the words. Change the Grid rows and columns to fit longer text.
     Each large heading is one complete text line. Keep the image files beside this layout.
     A Viewbox fits each heading into its space. Longer words will look narrower.
     Negative margins remove empty space around letters. Check accents after editing.
     The paper marks are a separate Image at the end and can be removed. -->
  <Border Width="1000" Height="1300" Background="#E5DFCC" TextElement.Foreground="#292A25">
    <Border.Resources>
      <!-- These styles set the fonts for the headings and small print. -->
      <Style x:Key="LargeHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="100" />
        <Setter Property="FontFamily" Value="Impact" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
      <Style x:Key="ArticleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Times New Roman" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </Border.Resources>
    <Grid>
      <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="145" />
          <RowDefinition Height="260" />
          <RowDefinition Height="490" />
          <RowDefinition Height="*" />
          <RowDefinition Height="45" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
            <RowDefinition Height="9" />
          </Grid.RowDefinitions>
          <Viewbox Stretch="Fill" Grid.Row="0">
            <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Georgia" Margin="0,-18,0,-20" Text="Current News" FontWeight="Bold" x:Name="PaperName" />
          </Viewbox>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource ArticleText}" FontSize="12">Wednesday June 16 1982  •  15p  •  Weather: Sunny intervals</TextBlock>
            <TextBlock Style="{StaticResource ArticleText}" FontSize="14" FontWeight="Bold" Grid.Column="1" TextAlignment="Right">THE VOICE OF BRITAIN</TextBlock>
          </Grid>
          <Border BorderBrush="#292A25" BorderThickness="0,0,0,4" Grid.Row="2" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,16,0,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="65" />
            <RowDefinition Height="65" />
            <RowDefinition Height="82" />
            <RowDefinition Height="24" />
          </Grid.RowDefinitions>
          <Viewbox Stretch="Fill" Grid.Row="0">
            <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="The Falklands are once more under the" x:Name="HeadlineLine1" />
          </Viewbox>
          <Viewbox Stretch="Fill" Grid.Row="1">
            <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="Government desired by their inhabitants" x:Name="HeadlineLine2" />
          </Viewbox>
          <Viewbox Stretch="Fill" Grid.Row="2" Margin="120,12,120,0">
            <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="GOD SAVE THE QUEEN" x:Name="HeadlineLine3" />
          </Viewbox>
          <TextBlock Style="{StaticResource ArticleText}" FontSize="12" FontWeight="Bold" Grid.Row="3" TextAlignment="Center" Margin="0,4,0,0">GENERAL MOORE’S DRAMATIC SIGNAL FROM PORT STANLEY</TextBlock>
        </Grid>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="25" />
            </Grid.RowDefinitions>
            <Border BorderBrush="#292A25" BorderThickness="2">
              <Image Source="{Binding Assets[victory_thatcher_halftone]}" Stretch="Fill" />
            </Border>
            <TextBlock Style="{StaticResource ArticleText}" FontSize="10" Grid.Row="1" TextAlignment="Center" Margin="0,5,0,0">MARGARET THATCHER — Library photograph, March 1981</TextBlock>
          </Grid>
          <Grid Grid.Column="1" Margin="14,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="25" />
            </Grid.RowDefinitions>
            <Border BorderBrush="#292A25" BorderThickness="2">
              <Image Source="{Binding Assets[victory_queen_halftone]}" Stretch="Fill" />
            </Border>
            <TextBlock Style="{StaticResource ArticleText}" FontSize="10" Grid.Row="1" TextAlignment="Center" Margin="0,5,0,0">QUEEN ELIZABETH II — Windsor, June 1982</TextBlock>
          </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,8,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="103" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48*" />
            <ColumnDefinition Width="52*" />
          </Grid.ColumnDefinitions>
          <Viewbox Stretch="Fill" Grid.RowSpan="2" Margin="0,5,15,5">
            <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Georgia" Margin="0,-18,0,-20" Text="VF" FontWeight="Bold" x:Name="VictoryLetters" />
          </Viewbox>
          <Grid Grid.Column="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource ArticleText}" FontSize="13" FontWeight="Bold" TextAlignment="Justify">THE PEOPLE of the Falklands are restored to the lives they wanted. The fighting has ended and the long work of recovery begins.<LineBreak />
                <LineBreak />Across Britain, families waited for news of the men who had sailed south.</TextBlock>
              <TextBlock Style="{StaticResource ArticleText}" FontSize="13" FontWeight="Bold" Grid.Column="1" Margin="14,0,0,0" TextAlignment="Justify">In the days ahead the nation will count the cost of the campaign and remember those who will not return. For the islanders, there is relief after weeks of fear and uncertainty.</TextBlock>
            </Grid>
          </Grid>
          <Viewbox Stretch="Fill" Grid.Row="1" Grid.Column="1" Margin="0,10,0,5">
            <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Georgia" Margin="0,-18,0,-20" Text="DAY" FontWeight="Bold" x:Name="VictoryWord" />
          </Viewbox>
        </Grid>
        <Border Grid.Row="4" BorderBrush="#292A25" BorderThickness="0,4,0,2" Padding="65,11">
          <Viewbox Stretch="Fill">
            <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Arial" Margin="0,-18,0,-15" Text="THE FALKLANDS VICTORY. SPECIAL EDITION: PLEASE SEE INSIDE" FontWeight="Bold" x:Name="TextTHEFALKLANDSVICTORYSPECIALEDITIONPL" />
          </Viewbox>
        </Border>
      </Grid>
      <Image Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.65" IsHitTestVisible="False" />
    </Grid>
  </Border>
</Viewbox>