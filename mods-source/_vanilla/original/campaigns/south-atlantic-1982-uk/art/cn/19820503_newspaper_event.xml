<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
  <!-- Change PageLayout rows to move the sections. Moon stays one text line. -->
  <!-- Headings use upright Impact. The Moon name uses Arial Black with one simple slant. -->
  <!-- Preview with the NoesisWindows profile. It accounts for the game font spacing without changing this file. -->
  <Border Width="1000" Height="1210" Background="#E5DFCC" TextElement.Foreground="#292A25" x:Name="Paper">
    <Border.Resources>
      <Style x:Key="LargeHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="100" />
        <Setter Property="FontFamily" Value="Impact" />
        <Setter Property="TextWrapping" Value="NoWrap" />
      </Style>
      <Style x:Key="ArticleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Times New Roman" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </Border.Resources>
    <Grid>
      <Grid Margin="28,28,28,20" x:Name="PageLayout">
        <!-- Rows: masthead, date, GOTCHA, photos and lead story, full-width bottom story, footer. -->
        <Grid.RowDefinitions>
          <RowDefinition Height="140" />
          <RowDefinition Height="26" />
          <RowDefinition Height="260" />
          <RowDefinition Height="430" />
          <RowDefinition Height="*" />
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Border Grid.Row="1" Grid.RowSpan="5" BorderBrush="#292A25" BorderThickness="1.5" Margin="-5,0,-5,-2" />
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*" />
            <ColumnDefinition Width="32*" />
            <ColumnDefinition Width="15*" />
          </Grid.ColumnDefinitions>
          <Border Background="#CC3F37" Margin="0,0,13,0">
            <Grid>
              <Viewbox Stretch="Fill" Height="17" Width="84" Margin="0,6,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="THE" Foreground="#FFF6DF" FontStyle="Normal" x:Name="TextTHE" />
              </Viewbox>
              <Viewbox Stretch="Fill" Margin="16,26,35,6">
                <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Arial Black" Margin="0,-35,0,-28" Text="Moon" Foreground="#FFF6DF" x:Name="PaperName" FontStyle="Normal">
                  <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-12" CenterY="75" />
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Viewbox>
            </Grid>
          </Border>
          <Border Grid.Column="1" BorderBrush="#292A25" BorderThickness="3" Padding="8" Margin="0,0,8,0" Background="#292A25">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Viewbox Stretch="Fill" Grid.Row="0">
                <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="QE2 IS SET TO" Foreground="#E5DFCC" FontStyle="Normal" x:Name="TextQE2ISSETTO" />
              </Viewbox>
              <Viewbox Stretch="Fill" Grid.Row="1">
                <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="SAIL FOR WAR" Foreground="#E5DFCC" FontStyle="Normal" x:Name="TextSAILFORWAR" />
              </Viewbox>
              <TextBlock Style="{StaticResource ArticleText}" FontSize="13" Grid.Row="2" Foreground="#E5DFCC">A great liner prepares for a new role as the fleet builds up in the South Atlantic. Fresh stores reach the ships. Full report inside.</TextBlock>
            </Grid>
          </Border>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="30" />
              <RowDefinition Height="30" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Viewbox Stretch="Fill" Grid.Row="0">
              <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="We told" x:Name="TextWetold" FontStyle="Normal" />
            </Viewbox>
            <Viewbox Stretch="Fill" Grid.Row="1">
              <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="you first" x:Name="Textyoufirst" FontStyle="Normal" />
            </Viewbox>
            <TextBlock Style="{StaticResource ArticleText}" FontSize="12" Grid.Row="2">More news from the fleet, with reports from London and the South Atlantic. The latest pictures and reports inside.</TextBlock>
          </Grid>
        </Grid>
        <Grid Grid.Row="1" Margin="0,5,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource ArticleText}" FontSize="11" VerticalAlignment="Center">Tuesday, May 4, 1982</TextBlock>
          <TextBlock Style="{StaticResource ArticleText}" FontSize="13" FontWeight="Bold" Grid.Column="1" TextAlignment="Center">14p</TextBlock>
          <TextBlock Style="{StaticResource ArticleText}" FontSize="11" FontWeight="Bold" Grid.Column="2" TextAlignment="Right">FIRST FOR THE FLEET</TextBlock>
        </Grid>
        <Viewbox Stretch="Fill" Grid.Row="2" Margin="0,11,0,13">
          <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-20" Text="GOTCHA" x:Name="HeadlineLine1" FontStyle="Normal" />
        </Viewbox>
        <Grid Grid.Row="3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="51*" />
            <ColumnDefinition Width="49*" />
          </Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="35" />
              </Grid.RowDefinitions>
              <Border BorderBrush="#292A25" BorderThickness="2">
                <Image Source="{Binding Assets[gotcha_gunboat]}" Stretch="Fill" />
              </Border>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-6,10,0" Text="SUNK" FontStyle="Normal" x:Name="TextSUNK" FontSize="32" VerticalAlignment="Top" />
                <TextBlock Style="{StaticResource ArticleText}" FontSize="12" Grid.Column="1" Margin="0,0,0,0">First reports from the fleet told of a strike against an Argentine gunboat.</TextBlock>
              </Grid>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,8">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="35" />
              </Grid.RowDefinitions>
              <Border BorderBrush="#292A25" BorderThickness="2">
                <Image Source="{Binding Assets[gotcha_cruiser]}" Stretch="Fill" />
              </Border>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-6,10,0" Text="CRIPPLED" FontStyle="Normal" x:Name="TextCRIPPLED" FontSize="32" VerticalAlignment="Top" />
                <TextBlock Style="{StaticResource ArticleText}" FontSize="12" Grid.Column="1" Margin="0,0,0,0">The cruiser General Belgrano, at the centre of the latest reports from the South Atlantic.</TextBlock>
              </Grid>
            </Grid>
          </Grid>
          <Grid Grid.Column="1" Margin="16,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="84" />
              <RowDefinition Height="84" />
              <RowDefinition Height="84" />
              <RowDefinition Height="24" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#292A25" BorderThickness="0,0,0,3" Padding="0,0,0,5">
              <Viewbox Stretch="Fill">
                <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="Our lads sink" x:Name="TextOurladssink" FontStyle="Normal" />
              </Viewbox>
            </Border>
            <Border Grid.Row="1" BorderBrush="#292A25" BorderThickness="0,0,0,3" Padding="0,0,0,5">
              <Viewbox Stretch="Fill">
                <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="gunboat and" x:Name="Textgunboatand" FontStyle="Normal" />
              </Viewbox>
            </Border>
            <Border Grid.Row="2" BorderBrush="#292A25" BorderThickness="0,0,0,3" Padding="0,0,0,5">
              <Viewbox Stretch="Fill">
                <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="hole cruiser" x:Name="Textholecruiser" FontStyle="Normal" />
              </Viewbox>
            </Border>
            <TextBlock Style="{StaticResource ArticleText}" FontSize="11" FontWeight="Bold" Grid.Row="3" TextAlignment="Center" Margin="0,7,0,3">By OUR DEFENCE STAFF</TextBlock>
            <TextBlock Style="{StaticResource ArticleText}" FontSize="16" FontWeight="Bold" Grid.Row="4" TextAlignment="Left" x:Name="LeadArticle">THE NAVY struck in the South Atlantic last night as reports of attacks on Argentine warships reached London.<LineBreak />
              <LineBreak />The first reports spoke of a gunboat lost and a cruiser badly damaged. Families waited for further news while ministers met to assess the next move.</TextBlock>
          </Grid>
        </Grid>
        <Grid Grid.Row="4" Margin="0,8,0,8" x:Name="BottomNews">
          <!-- Change the headline and the three articles below. The columns use the whole page width. -->
          <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Viewbox Stretch="Fill">
            <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" FontStyle="Normal" Margin="0,-20,0,-10" Text="UNION BOYCOTTS WAR" x:Name="BottomHeadline" />
          </Viewbox>
          <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="3" BorderBrush="#928C7C" BorderThickness="1,0,0,0" Opacity="0.65" Width="1" HorizontalAlignment="Center" />
            <Border Grid.Column="1" BorderBrush="#928C7C" BorderThickness="1,0,0,0" Opacity="0.65" Width="1" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource ArticleText}" FontSize="15" Grid.Column="0" Margin="0" x:Name="BottomArticle1">Dockside workers debated fresh action yesterday as the growing crisis brought urgent calls for ships and supplies. A stream of lorries carried equipment to the waterfront while crews worked through the night. Union officials faced appeals to keep the ships moving as the Government called for a united effort. Preparations continued at the ports as more stores arrived, destined for vessels already waiting to sail.</TextBlock>
            <TextBlock Style="{StaticResource ArticleText}" FontSize="15" Grid.Column="2" Margin="0" x:Name="BottomArticle2">Ministers appealed for the preparations to continue. Families crowded the gates as sailors returned from leave and the ships took on stores for the long voyage south. The mood was anxious but determined. Along the waterfront, work went on under floodlights as men checked equipment and loaded the last supplies. More vessels were expected to join the operation, with crews standing by for orders throughout the night.</TextBlock>
            <TextBlock Style="{StaticResource ArticleText}" FontSize="15" Margin="0" Grid.Column="4" x:Name="BottomArticle3">Fresh reports brought a day of anxious waiting. The fleet remained at sea as diplomats pressed for an answer. In London, there was no sign of a quick end to the crisis. Further details were expected as messages reached the capital. Families gathered around radios and television sets for the latest bulletin. For those with relatives aboard the ships, the wait for definite news seemed endless. Ministers said more information would be released as soon as it could be confirmed.</TextBlock>
          </Grid>
        </Grid>
        <Border Grid.Row="5" Background="#292A25" Padding="7,6">
          <Viewbox Stretch="Fill">
            <TextBlock Style="{StaticResource LargeHeading}" FontFamily="Impact" Margin="0,-20,0,-10" Text="£50,000 BINGO! Today’s lucky numbers are on Page 10" Foreground="#E5DFCC" FontWeight="Normal" x:Name="Text50000BINGOTodaysluckynumbersareonPa" FontStyle="Normal" />
          </Viewbox>
        </Border>
      </Grid>
      <Image Source="{Binding Assets[moon_paper_wear]}" Stretch="Fill" Opacity="0.65" IsHitTestVisible="False" />
    </Grid>
  </Border>
</Viewbox>