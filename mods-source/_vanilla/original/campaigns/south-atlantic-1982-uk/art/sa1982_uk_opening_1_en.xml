<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Stretch="Uniform"
  StretchDirection="Both">
  <!-- The INI controls step sequence and camera; this XML owns copy. -->
  <!-- Match the host Free Content window so the slide does not read as an inset panel. -->
  <Grid Width="1560" Height="920" Background="{StaticResource Brush.Window.Header}" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#8E969E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="58"/><Setter Property="FontWeight" Value="Light"/><Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#28383B3F"/><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#40383B3F"/><Setter Property="Opacity" Value="0.9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
    <!-- This page owns its displayed copy. -->
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="INTRODUCTION" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="SOUTH ATLANTIC, APRIL 1982" FontSize="13" Foreground="#99A1A8" HorizontalAlignment="Center"/>
    </StackPanel>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,72,0"><TextBlock Text="2 / 8" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <!-- Dismissal is provided by the host window close and Skip controls. -->
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&lt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-uk/art/sa1982_uk_opening_0_en.xml"/>
      <Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&gt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/south-atlantic-1982-uk/art/sa1982_uk_opening_2_en.xml"/>
      <StackPanel Grid.Column="1" Orientation="Vertical">
        <Image Source="{Binding Assets[sa1982_photo_galtieri]}" Height="365" Stretch="Uniform" HorizontalAlignment="Center"/>
        <TextBlock Text="Galtieri in the Casa Rosada, prior to the conflict." FontStyle="Italic" FontSize="11" Foreground="#99A1A8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock Text="The Road to War" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,7"/>
		<TextBlock TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#D0D4D8">
		<Run Text="By early 1982, Argentina's military junta, led by Lieutenant General Leopoldo Galtieri, faced recession, inflation, political opposition and growing public unrest. The longstanding claim to the Malvinas offered the regime a national cause around which it hoped to rally support. Its leaders judged that Britain lacked both the will and the means to answer quickly with force."/>
		<LineBreak/>
		<LineBreak/>
		<Run Text="Diplomatic talks had produced no agreement. In March, Argentine scrap-metal workers raised their flag at the abandoned whaling station at Leith on South Georgia, beginning the confrontation. Buenos Aires formulated a plan for a rapid seizure of the islands: Operation Rosario."/>
		</TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Viewbox>

