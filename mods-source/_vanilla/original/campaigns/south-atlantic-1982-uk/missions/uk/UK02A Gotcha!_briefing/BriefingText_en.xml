<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Tag="FullBleedBriefing" BorderBrush="#92968C" BorderThickness="1" HorizontalAlignment="Stretch">
  <Border.Resources>
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="/Assets/Resources/ui/fonts/#Special Elite"/>
      <Setter Property="Foreground" Value="#49677F"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="24"/>
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>
  </Border.Resources>
  <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
      <GradientStop Color="#DADCD5" Offset="0"/>
      <GradientStop Color="#F0F0E8" Offset="0.32"/>
      <GradientStop Color="#E7E9E2" Offset="0.76"/>
      <GradientStop Color="#D4D8D1" Offset="1"/>
    </LinearGradientBrush>
  </Border.Background>
  <Grid>
    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Canvas.Left="13" Canvas.Top="39" Width="10" Height="13" Fill="#616456"/>
      <Path Stroke="#9A9F94" StrokeThickness="1" Data="M 18,39 L 14,28 15,14 11,2"/>
      <Ellipse Canvas.Left="13" Canvas.Top="76" Width="10" Height="13" Fill="#616456"/>
      <Path Stroke="#D3D6CA" StrokeThickness="1.5" Data="M 13,83 C 14,89 20,90 24,85"/>
    </Canvas>
    <Border Width="2" Background="#9A9F94" Opacity="0.09" HorizontalAlignment="Center" IsHitTestVisible="False"/>
    <Border Width="1" Background="#FFFFFF" Opacity="0.32" HorizontalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False"/>
    <Border Height="1" Background="#9A9F94" Opacity="0.12" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <StackPanel Margin="38,30,28,30">
      <Border BorderBrush="#A24F4E" BorderThickness="1.5" Padding="14,7" Margin="0,0,5,26"
              HorizontalAlignment="Right" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><RotateTransform Angle="-2"/></Border.RenderTransform>
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0.2,1">
            <GradientStop Color="#E0000000" Offset="0"/>
            <GradientStop Color="#B0000000" Offset="0.32"/>
            <GradientStop Color="#F0000000" Offset="0.35"/>
            <GradientStop Color="#B0000000" Offset="0.71"/>
            <GradientStop Color="#E0000000" Offset="1"/>
          </LinearGradientBrush>
        </Border.OpacityMask>
        <StackPanel>
          <TextBlock Text="SECRET" TextAlignment="Center" Foreground="#A24F4E" FontSize="20"/>
          <TextBlock Text="UK EYES A" TextAlignment="Center" Foreground="#A24F4E" FontSize="20"/>
        </StackPanel>
      </Border>
      <TextBlock TextDecorations="Underline" FontSize="20" LineHeight="26" Margin="0,0,0,18">
OPERATION CORPORATE
      </TextBlock>
      <TextBlock Margin="0,0,0,22">
FROM: FLAG OFFICER SUBMARINES, NORTHWOOD
    <LineBreak/>
    TO: COMMANDING OFFICER, {SelectedUnitName}
    <LineBreak/>
    2 MAY 1982
      </TextBlock>
      <Border Height="1" Background="#7F939E" Opacity="0.45" Margin="0,0,0,22"/>
      <TextBlock Margin="0,0,0,20">
Time Zone Used Throughout the Order: ZULU.
      </TextBlock>
      <TextBlock Margin="0,0,0,20">
<Run Text="1. SITUATION:" TextDecorations="Underline"/> The Argentine cruiser GENERAL BELGRANO, escorted by two destroyers, is operating southwest of the Falkland Islands outside the Total Exclusion Zone. The carrier 25 DE MAYO is at sea to the north. The two groups may threaten the Task Force from opposite directions.
      </TextBlock>
      <TextBlock Margin="0,0,0,20">
<Run Text="2. MISSION:" TextDecorations="Underline"/> You are ordered to attack and sink ARA GENERAL BELGRANO. Destroy the cruiser before her group can threaten the Task Force from the south, or move east towards South Georgia.
      </TextBlock>
      <TextBlock Margin="0,0,0,20">
<Run Text="3. RULES OF ENGAGEMENT:" TextDecorations="Underline"/> Previous restrictions on attacking Argentine naval vessels outside the Total Exclusion Zone have been lifted. Northwood has signalled authority to attack such vessels on the high seas. GENERAL BELGRANO and her escorts may be engaged outside the Zone under the amended rules. Confirm the cruiser before firing.
      </TextBlock>
      <TextBlock Margin="0,0,0,20">
<Run Text="4. EXECUTION:" TextDecorations="Underline"/> Weapon choice and firing position are at the Commanding Officer's discretion. Sinking the escorting destroyers is not required. After attacking, evade prosecution and escape the area.
      </TextBlock>
      <TextBlock Margin="0,0,0,20">
<Run Text="5. COMMAND AND SIGNAL:" TextDecorations="Underline"/> Flag Officer Submarines at Northwood retains control of submarine operations. Maintain radio silence during the approach. Report the outcome when safe to transmit.
      </TextBlock>
      <TextBlock Margin="0,0,0,20">
FLAG OFFICER SUBMARINES
    <LineBreak/>
    NORTHWOOD
      </TextBlock>
      <Border Height="1" Background="#7F939E" Opacity="0.35" Margin="0,4,0,18"/>
      <TextBlock Text="SECRET / UK EYES A" TextAlignment="Center" FontSize="16" Foreground="#617A8C"/>
    </StackPanel>
  </Grid>
</Border>
