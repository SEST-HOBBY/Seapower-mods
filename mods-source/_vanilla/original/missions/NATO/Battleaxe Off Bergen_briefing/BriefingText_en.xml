<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Tag="FullBleedBriefing" BorderBrush="#92968C" BorderThickness="1" HorizontalAlignment="Stretch">
  <Border.Resources>
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="FontFamily" Value="/Assets/Resources/ui/fonts/#Special Elite"/>
      <Setter Property="Foreground" Value="#49677F"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="24"/>
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>
  </Border.Resources>
  <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
      <GradientStop Color="#DADCD5" Offset="0"/>
      <GradientStop Color="#F0F0E8" Offset="0.32"/>
      <GradientStop Color="#E7E9E2" Offset="0.76"/>
      <GradientStop Color="#D4D8D1" Offset="1"/>
    </LinearGradientBrush>
  </Border.Background>
  <Grid>
    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Canvas.Left="13" Canvas.Top="39" Width="10" Height="13" Fill="#616456"/>
      <Path Stroke="#9A9F94" StrokeThickness="1" Data="M 18,39 L 14,28 15,14 11,2"/>
      <Ellipse Canvas.Left="13" Canvas.Top="76" Width="10" Height="13" Fill="#616456"/>
      <Path Stroke="#D3D6CA" StrokeThickness="1.5" Data="M 13,83 C 14,89 20,90 24,85"/>
    </Canvas>
    <Border Width="2" Background="#9A9F94" Opacity="0.09" HorizontalAlignment="Center" IsHitTestVisible="False"/>
    <Border Width="1" Background="#FFFFFF" Opacity="0.32" HorizontalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False"/>
    <Border Height="1" Background="#9A9F94" Opacity="0.12" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <StackPanel Margin="38,30,28,30">
      <!-- Match the existing South Atlantic paper briefings. The briefing shell owns scrolling. -->
      <Border BorderBrush="#A24F4E" BorderThickness="1.5" Padding="14,7" Margin="0,0,5,22"
              HorizontalAlignment="Right" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><RotateTransform Angle="-2"/></Border.RenderTransform>
        <TextBlock Text="SECRET" Foreground="#A24F4E" FontSize="20" TextAlignment="Center"/>
      </Border>
      <TextBlock TextDecorations="Underline" FontSize="20" LineHeight="26" Margin="0,0,0,18">BATTLEAXE OFF BERGEN</TextBlock>
      <TextBlock Margin="0,0,0,22">From: Commander UKN08<LineBreak/>To: Captain HMS Battleaxe<LineBreak/>SUBJ: Establishment of ASW Picket.</TextBlock>
      <Border Height="1" Background="#7F939E" Opacity="0.45" Margin="0,0,0,20"/>
      <TextBlock Margin="0,10,0,10" TextDecorations="Underline">1. SITUATION:</TextBlock>
      <TextBlock Margin="0,0,0,12">COMEASTLANT has indicated an increased likelihood of Soviet submarines attempting to establish themselves in the Bergen approaches. HMS Battleaxe and HMS Euryalus will conduct an ASW Barrier search beginning 50 nautical miles North Northeast of the Convoy. Locate and sink all USSR submarines encountered.</TextBlock>
      <TextBlock Margin="0,10,0,10" TextDecorations="Underline">2. MISSION:</TextBlock>
      <TextBlock Margin="0,0,0,12">2.1 Detach from Convoy and establish ASW picket station 50 nautical miles North Northeast of Convoy. Begin ASW screen no later than 0215Z.</TextBlock>
      <TextBlock Margin="0,0,0,12">2.2 Locate and sink any hostile submarines encountered.</TextBlock>
      <TextBlock Margin="0,10,0,10" TextDecorations="Underline">3. EXECUTION:</TextBlock>
      <TextBlock Margin="0,0,0,12">3.1 EMCON Unrestricted.</TextBlock>
      <TextBlock Margin="0,0,0,12">3.2 HMS Battleaxe and HMS Euryalus, supported by P-3C Orion (Callsign Pelican 1), will patrol the area from 50 nautical miles North Northeast of the convoy to the Norwegian coast.</TextBlock>
      <TextBlock Margin="0,10,0,10" TextDecorations="Underline">4. ENEMY OOB:</TextBlock>
      <TextBlock Margin="0,0,0,12">4.1 2x SSN</TextBlock>
      <TextBlock Margin="0,0,0,12">4.2 2x SSK</TextBlock>
      <TextBlock Margin="0,0,0,12">4.3 Air threat not anticipated.</TextBlock>
      <TextBlock Margin="0,0,0,12">4.4 Surface threat not anticipated.</TextBlock>
      <TextBlock Margin="0,10,0,10" TextDecorations="Underline">5. INTEL ASSESSMENT:</TextBlock>
      <TextBlock Margin="0,0,0,12">5.1 Convoy towed array escorts have had intermittent contact with probable SSK at second convergence zone near planned ASW Picket location. Last reported contact is 3 hours old.</TextBlock>
      <Border Height="1" Background="#7F939E" Opacity="0.35" Margin="0,4,0,18"/>
      <TextBlock Text="SECRET" TextAlignment="Center" FontSize="16" Foreground="#617A8C"/>
    </StackPanel>
  </Grid>
</Border>
