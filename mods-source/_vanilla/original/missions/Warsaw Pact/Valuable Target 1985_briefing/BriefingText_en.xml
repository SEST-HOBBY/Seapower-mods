<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform" StretchDirection="DownOnly">
<!-- Fictional execution message. Edit complete paragraphs below. Soviet markings are period-inspired, not a reproduced archival document. -->
<Border Width="827" Height="1169" Background="#FCFBF5" TextElement.Foreground="#292926" TextElement.FontFamily="/Assets/Resources/ui/fonts/#Consolas" TextElement.FontSize="16" TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight">
<Grid Margin="68,54,62,46">
<!-- Reused UMBRA print-grain mask affects ink only. All words remain editable. -->
<Grid.OpacityMask><ImageBrush ImageSource="{Binding Assets[briefing_print_grain]}" Stretch="Fill"/></Grid.OpacityMask>
 <Grid.RowDefinitions><RowDefinition Height="118"/><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
 <Grid Grid.Row="0">
  <StackPanel HorizontalAlignment="Right">
   <TextBlock x:Name="Classification" Text="Совершенно секретно" FontSize="21" FontWeight="Bold"/>
   <TextBlock Text="TOP SECRET" FontSize="14" Margin="0,4,0,0"/>
   <TextBlock Text="Copy No. 1" Margin="0,12,0,0"/>
  </StackPanel>
  <StackPanel VerticalAlignment="Bottom"><TextBlock Text="COMBAT ORDER No. 017" FontWeight="Bold"/><TextBlock Text="27 JUNE 1985   /   0530Z" Margin="0,5,0,0"/></StackPanel>
 </Grid>
 <Grid Grid.Row="1" Margin="0,25,0,0">
  <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel><TextBlock Text="From:"/><TextBlock Text="To:" Margin="0,7,0,0"/><TextBlock Text="Subj:" Margin="0,7,0,0"/></StackPanel>
  <StackPanel Grid.Column="1"><TextBlock Text="CMDR, RED BANNER NORTHERN FLEET"/><TextBlock Text="COMMANDER, ISAKOV STRIKE GROUP" Margin="0,7,0,0"/><TextBlock Text="INTERDICTION OF NORWAY SUPPLY CONVOY" Margin="0,7,0,0"/></StackPanel>
 </Grid>
 <!-- Compact paragraph spacing keeps the full sign-off above the classification footer. -->
 <StackPanel Grid.Row="2" x:Name="MessageBody">
  <TextBlock Text="EXECUTION MESSAGE" FontWeight="Bold" Margin="0,0,0,10"/>
  <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="Comrade Commander, hostilities have begun. The Americans have been building up their forces in Norway for several weeks. Your group has been placed across the route of an approaching supply convoy. You are now ordered to attack."/>
  <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="PRESIDENT VAN BUREN carries ammunition, replacement vehicles and communications equipment for the American forces ashore. Our satellites show three American warships in company with her."/>
  <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="Locate the American convoy and destroy it with your missiles or guns."/>
  <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="The area remains heavy with merchant traffic as ships at sea make for port. Neutral shipping is not to be attacked under any circumstances."/>
  <TextBlock Text="END OF MESSAGE" Margin="0,5,0,0"/><TextBlock Text="COMMANDER, RED BANNER NORTHERN FLEET" Margin="0,5,0,0"/>
 </StackPanel>
 <Grid Grid.Row="3" VerticalAlignment="Bottom"><TextBlock Text="Совершенно секретно" FontSize="14"/><TextBlock Text="1" HorizontalAlignment="Right"/></Grid>
</Grid>
</Border>
</Viewbox>
