{
    "name": "@seapower/tslib",
    "author": "Microsoft Corp.",
    "homepage": "https://www.typescriptlang.org/",
    "version": "2.8.1",
    "license": "0BSD",
    "description": "Runtime library for TypeScript helper functions",
    "keywords": [
        "TypeScript",
        "Microsoft",
        "compiler",
        "language",
        "javascript",
        "tslib",
        "runtime"
    ],
    "bugs": {
        "url": "https://github.com/Microsoft/TypeScript/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Microsoft/tslib.git"
    },
    "seapower": {
        "aliases": [
            "tslib"
        ]
    },
    "scripts": {
        "build": "pnpm run build:system && pnpm run build:es6",
        "build:system": "pnpm exec babel tslib.es6.js -o tslib.system.cc.js",
        "build:es6": "pnpm exec babel --config-file ./es6.babel.config.json tslib.es6.js -o tslib.es6.cc.js",
        "pack": "npm-pack-zip --destination=\"../../../modules\" --add-version=true"
    },
    "main": "tslib.system.cc.js",
    "jsnext:main": "tslib.es6.cc.js",
    "typings": "tslib.d.ts",
    "sideEffects": false,
    "devDependencies": {
        "@babel/cli": "^7.0.0",
        "@babel/core": "^7.0.0",
        "@babel/plugin-transform-modules-systemjs": "^7.27.1",
        "@seapower/sp-closure-transform": "workspace:*"
    },
    "files": [
        "tslib.system.cc.js",
        "tslib.d.ts"
    ],
    "exports": {
        ".": {
            "module": {
                "types": "./modules/index.d.ts",
                "default": "./tslib.es6.cc.js"
            },
            "import": {
                "node": "./modules/index.js",
                "default": {
                    "types": "./modules/index.d.ts",
                    "default": "./tslib.es6.cc.js"
                }
            },
            "default": "./tslib.js"
        },
        "./*": "./*",
        "./": "./"
    }
}
