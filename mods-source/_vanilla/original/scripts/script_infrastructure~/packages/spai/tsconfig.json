{
  "include": ["./src/**/*.ts"],
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./build/ts",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "esnext",
    "target": "es5",
    "types": [],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmitHelpers": true,
    "importHelpers": true,
    "inlineSources": true,

    "paths": {
      "spruntime": ["../spruntime/dist/index.d.ts"],
      "tslib": ["../tslib/tslib.d.ts"],
      "es6-promise": ["../es6-promise/es6-promise.d.ts"],
      "json-rpc-2.0": ["../json-rpc-2.0/dist/index.d.ts"]
    },
    "lib": [
      "ES5",
      "ES2015.Promise",
      "ES2018.Promise",
      "ES2020.Promise",
      "ES2021.Promise",
      "ES2024.Promise",
      "ES2015.Collection",
      "ESNext.Promise",
      "ESNext.AsyncIterable",
      "ESNext.Disposable",
      "DOM",
    ]
  }
}
