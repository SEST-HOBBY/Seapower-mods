<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Stretch="Uniform"
  StretchDirection="Both">
  <Grid Width="1560" Height="920" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">

    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8E969E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="58"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#28383B3F"/>
                  <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="76"/>
      <RowDefinition Height="1"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="YOU CHOSE: SILENCE" FontSize="28" FontWeight="SemiBold" Foreground="#C98A6A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="122"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="122"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&lt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/mare-nostrum-28/art/decision_en.xml"/>
      <TextBlock Grid.Column="2" Text="&gt;" FontSize="58" Foreground="#5F676E" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>

      <StackPanel Grid.Column="1" Orientation="Vertical">
        <Image Source="{Binding Assets[warwidens]}" Height="330" Stretch="Uniform" HorizontalAlignment="Center"/>

        <TextBlock Text="The Silence" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,14"/>

        <TextBlock TextWrapping="Wrap" FontSize="16" LineHeight="26" Foreground="#D0D4D8" Margin="170,0,170,0" TextAlignment="Center">
          The logs go back into the safe. No one will ever know what happened that night in the Tyrrhenian, and Europe will carry the blame for a torpedo it never fired.
          <LineBreak/><LineBreak/>
          Waiting for you at the Strait is the Russian fleet that engineered all of this - and behind it, the Sixth Fleet following orders from a country you can no longer explain anything to. Two enemies. One of them by mistake.
          <LineBreak/><LineBreak/>
          <Span FontWeight="SemiBold" Foreground="#C98A6A">Play the mission "PILLARS - THE SILENCE" (ENDING A) on the campaign map.</Span>
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Viewbox>
