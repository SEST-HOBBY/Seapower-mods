<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Stretch="Uniform"
  StretchDirection="Both">
  <Grid Width="1560" Height="920" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8E969E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="58"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#28383B3F"/>
                  <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="76"/>
      <RowDefinition Height="1"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="ACTO III - LA COALICION SE CIERRA" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
      <TextBlock Text="2 / 2" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="122"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="122"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&lt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/mare-nostrum-28/art/acto3_es.xml"/>
      <TextBlock Grid.Column="2" Text="&gt;" FontSize="58" Foreground="#5F676E" Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>

      <StackPanel Grid.Column="1" Orientation="Vertical">
        <Image Source="{Binding Assets[NolongerAlone]}" Height="360" Stretch="Uniform" HorizontalAlignment="Center"/>
        <TextBlock Text="Berlin y La Haya rompen su neutralidad: la Fuerza Naval Europea ya son cinco banderas." FontStyle="Italic" FontSize="11" Foreground="#99A1A8" HorizontalAlignment="Center" Margin="0,8,0,0"/>

        <TextBlock Text="Ya No Estais Solos" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,12"/>

        <TextBlock TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#D0D4D8" Margin="150,0,150,0">
          Alemania y Holanda llevaban meses mirando hacia otro lado, confiando en que el desastre se quedara en el sur. El hundimiento del Oscar Austin acabo con esa ilusion en una tarde: si Washington considera que Europa entera disparo aquel torpedo, entonces no hay neutralidad que valga.
          <LineBreak/><LineBreak/>
          El Bundestag aprueba en sesion de urgencia el despliegue de la <Span FontWeight="SemiBold">Deutsche Marine</Span> bajo mando combinado. Los Paises Bajos ponen a disposicion la <Span FontWeight="SemiBold">Koninklijke Marine</Span> antes incluso de que termine la votacion.
          <LineBreak/><LineBreak/>
          Fragatas Sachsen y F125, corbetas K130, los De Zeven Provincien y los Karel Doorman, submarinos Type 212A y Walrus. <Span FontWeight="SemiBold" Foreground="#8FBF7F">Ya estan disponibles en tu agrupacion.</Span>
          <LineBreak/><LineBreak/>
          Cinco banderas. Un solo mar. Y del otro lado, por primera vez, la certeza de que esto ya no va de piratas ni de lanchas: al este espera la flota rusa, y al oeste, unos Estados Unidos convencidos de que sois vosotros los asesinos.
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Viewbox>
