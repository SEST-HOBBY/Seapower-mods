<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Stretch="Uniform"
  StretchDirection="Both">
  <Grid Width="1560" Height="920" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8E969E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="58"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#28383B3F"/>
                  <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="76"/>
      <RowDefinition Height="1"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="INTRODUCCION" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
      <TextBlock Text="2 / 3" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="122"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="122"/>
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&lt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/mare-nostrum-28/art/prologo_es.xml"/>
      <Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&gt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/mare-nostrum-28/art/prologo3_es.xml"/>

      <StackPanel Grid.Column="1" Orientation="Vertical">
        <Image Source="{Binding Assets[mn28_greenmarch]}" Height="410" Stretch="Uniform" HorizontalAlignment="Center"/>
        <TextBlock Text="La Nueva Marcha Verde: multitudes y regimenes del Magreb unidos hacia el norte." FontStyle="Italic" FontSize="11" Foreground="#99A1A8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock Text="La Nueva Marcha Verde" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,12"/>
        <TextBlock TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#D0D4D8" Margin="150,0,150,0">
          El hambre de Europa —energia, minerales, grano— se ha vuelto voraz, y el sur ha aprendido a odiarla por ello. Del Atlantico al Nilo, los gobiernos del Magreb se han unido bajo una sola bandera: la <Span FontWeight="SemiBold" Foreground="#8FBF7F">Nueva Marcha Verde</Span>. La llaman una marea de dignidad; sus arsenales, recien salidos de las fabricas de Moscu, cuentan otra historia.
          <LineBreak/><LineBreak/>
          Cierran rutas. Abordan mercantes. Reclaman aguas y yacimientos que Europa juraba suyos. Cada semana se cruza una linea nueva, y ninguna se vuelve a cruzar de regreso.
          <LineBreak/><LineBreak/>
          Nadie ha declarado la guerra. Nadie hace falta. <Span FontWeight="SemiBold" Foreground="#C98A6A">Dos hambres se miran a traves de un mar cada vez mas estrecho</Span>, y alguien, muy pronto, apretara el gatillo primero.
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Viewbox>
