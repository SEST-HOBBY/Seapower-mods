<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Stretch="Uniform"
  StretchDirection="Both">
  <Grid Width="1560" Height="920" TextElement.Foreground="#D8DCE0" TextElement.FontFamily="Roboto">
    <Grid.Resources>
      <Style x:Key="SlideArrowButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8E969E"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="58"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Opacity" Value="0.58"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#28383B3F"/>
                  <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="76"/>
      <RowDefinition Height="1"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="INTRODUCCION" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border Grid.Row="0" Width="76" Height="38" BorderBrush="#3E454B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
      <TextBlock Text="1 / 3" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Rectangle Grid.Row="1" Fill="#3E454B" Margin="22,0"/>

    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="122"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="122"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="&lt;" FontSize="58" Foreground="#5F676E" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Width="96" Height="190" Style="{StaticResource SlideArrowButton}" Content="&gt;" Command="{Binding OpenFileCommand}" CommandParameter="campaigns/mare-nostrum-28/art/prologo2_es.xml"/>

      <StackPanel Grid.Column="1" Orientation="Vertical">
        <Image Source="{Binding Assets[mn28_intro_map]}" Height="410" Stretch="Uniform" HorizontalAlignment="Center"/>
        <TextBlock Text="Europa en 2028: sola ante el mundo tras la retirada de EEUU." FontStyle="Italic" FontSize="11" Foreground="#99A1A8" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBlock Text="El Fin del Paraguas" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,12"/>
        <TextBlock TextWrapping="Wrap" FontSize="16" LineHeight="25" Foreground="#D0D4D8" Margin="150,0,150,0">
          El siglo americano ha terminado. En Washington, una nueva administracion cierra de un portazo la puerta a Europa: abandona la OTAN, decreta embargos y corta el comercio que sostuvo al continente durante ochenta anos. En una sola estacion, el paraguas que cubria a Occidente se ha plegado.
          <LineBreak/><LineBreak/>
          Moscu y Pekin no esperan. Llenan cada vacio, compran cada silencio, mientras potencias como la India observan tras una neutralidad calculada. El viejo orden se deshace, y nadie sabe aun que forma tendra el nuevo.
          <LineBreak/><LineBreak/>
          Y en el sur, donde el Mediterraneo se estrecha hasta casi tocarse, algo empieza a moverse. <Span FontWeight="SemiBold" Foreground="#C98A6A">Europa esta sola.</Span> Por primera vez en generaciones tendra que valerse por si misma. O hundirse.
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Viewbox>
