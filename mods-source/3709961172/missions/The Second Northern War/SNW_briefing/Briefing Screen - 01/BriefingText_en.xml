<!-- Created by Fre3dysbro. This template is a basic structure for creating XAML layouts for the Mission Briefings in the Sea Power Mission Editor. -->

<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="768">

<!-- Only "xmlns" and "xmlns:x" are required for standard XAML. The rest were added for design-time and are not necessary for runtime. You can Google what they do and try them out. -->

	<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="15"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
	</Grid.RowDefinitions>

<!-- GRID.RowDefinitions defines the number of rows and their height. If TextBlocks overlap in the preview, add more rows as needed. -->

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

<!-- GRID.ColumnDefinitions defines the number of columns and their width. -->

    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="14" FontFamily="Consolas" Text="From: The Main Command of the Navy"/>
    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="14" FontFamily="Consolas" Text="To: Operational Strike Group Kronshtadt"/>
    <TextBlock Grid.Row="5" Grid.Column="0" FontSize="18" FontFamily="Consolas" FontWeight="Bold" Text="Combat mission: Operation ”Dawn on Narva”"/>

<!-- Don't write all your text into a single TextBlock. XAML is very picky and doesn't like a lot of <LineBreak/> tags within one TextBlock. Splitting your text allows for more customization. -->
<!-- GRID.Row & GRID.Column define which row or column the TextBlock is placed in. -->

    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="16" FontFamily="Consolas" Text="1. OPERATIONAL SUMMARY"/>
	<TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas">
		In accordance with the order of the Supreme Commander dated 05/13/2027 No. 344/32-1, in response to systematic attempts to escalate the political situation,
        <LineBreak/>
        the blocking of strategic transport routes and the systematic increase in the grouping of troops along the state border, the Armed Forces
        <LineBreak/>
        of the Russian Federation has been ordered to launch a preemptive strike against the Baltic countries in order to unblock the Kaliningrad region and eliminate
        <LineBreak/>
        threats to the Russian Federation.
        <LineBreak/>
        The Baltic Fleet has a crucial role to play in delivering the initial strike and ensuring the successful completion of the task of the ground forces. 
		<LineBreak/>
	</TextBlock>

    <TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" FontFamily="Consolas" Text="2. SUBORDINATE FORCES"/>
	<TextBlock Grid.Row="13" Grid.ColumnSpan="4" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas">
		- 1. An operational strike group consisting of ships pr. 20380 "Boiky" and "Perfect", pr. 21631 "Zeleny Dol", "Serpukhov" and "Grad", pr. 1135M "Burevestnik"
        <LineBreak/>
        - 2. Diesel-electric submarines B-806 Dmitrov and B-587 Velikiye Luki
        <LineBreak/>
        - 3. Two divisions of OTRK and attack UAV launchers
        <LineBreak/>
        - 4. Pskov air base with attached aircraft
        <LineBreak/>
        - 5. Разведгруппы ГРУ
		<LineBreak/>		
	</TextBlock>

</Grid>