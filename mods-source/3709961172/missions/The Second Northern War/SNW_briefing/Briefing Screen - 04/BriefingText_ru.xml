<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="768">

<!-- Only "xmlns" and "xmlns:x" are required for standard XAML. The rest were added for design-time and are not necessary for runtime. You can Google what they do and try them out. -->

	<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="15"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
	</Grid.RowDefinitions>

<!-- GRID.RowDefinitions defines the number of rows and their height. If TextBlocks overlap in the preview, add more rows as needed. -->

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

<!-- GRID.ColumnDefinitions defines the number of columns and their width. -->

    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="14" FontFamily="Consolas" Text="От: Главное командование Военно-Морского флота"/>
    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="14" FontFamily="Consolas" Text="Кому: Оперативной ударной группе Кронштадт"/>
    <TextBlock Grid.Row="5" Grid.Column="0" FontSize="18" FontFamily="Consolas" FontWeight="Bold" Text="Боевая задача: Операция “Прорыв в Калининград”"/>

<!-- Don't write all your text into a single TextBlock. XAML is very picky and doesn't like a lot of <LineBreak/> tags within one TextBlock. Splitting your text allows for more customization. -->
<!-- GRID.Row & GRID.Column define which row or column the TextBlock is placed in. -->

    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="16" FontFamily="Consolas" Text="1. ОПЕРАТИВНАЯ СВОДКА"/>
	<TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas">
		Нейтрализовав угрозу в Рижском заливе, мы наконец можем отправить конвои в осажденный Калининград, гарнизон которого героически удерживает оборону уже несколько дней.
        <LineBreak/>
        Это не будет легкой прогулкой, силы НАТО в регионе, несмотря на то, что они еще не мобилизовались полностью, остаются крайне многочисленными. Особенно остерегайтесь
        <LineBreak/>
        их авиации. Чем дальше от наших берегов, тем скорее появляются Гриппены или Еврофайтеры, забрасывая нас крылатыми ракетами.
        <LineBreak/>
        Так же не стоит сбрасывать поляков со счетов, у них еще сохранилось несколько кораблей в районе Куршской косы.
        <LineBreak/>
        Экономьте средства ПВО, путь до Балтийска не близкий, а вокруг территория врага. Удачи. 
 		<LineBreak/>
	</TextBlock>

    <TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" FontFamily="Consolas" Text="2. ПРИДАННЫЕ СИЛЫ"/>
	<TextBlock Grid.Row="13" Grid.ColumnSpan="4" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas">
		- 1. Оперативная ударная группа в составе кораблей пр. 20380 "Бойкий" и "Совершенный", пр. 1135М "Буревестник" и грузового конвоя в составе шести судов
        <LineBreak/>
        - 2. Истребительная авиация Балтийского флота, базирующаяся под Калининградом
        <LineBreak/>
        - 3. Дивизион С-300
		<LineBreak/>		
	</TextBlock>

</Grid>