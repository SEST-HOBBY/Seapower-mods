<!-- Created by Fre3dysbro. This template is a basic structure for creating XAML layouts for the Mission Briefings in the Sea Power Mission Editor. -->

<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="768">

<!-- Only "xmlns" and "xmlns:x" are required for standard XAML. The rest were added for design-time and are not necessary for runtime. You can Google what they do and try them out. -->

	<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="15"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
	</Grid.RowDefinitions>

<!-- GRID.RowDefinitions defines the number of rows and their height. If TextBlocks overlap in the preview, add more rows as needed. -->

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

<!-- GRID.ColumnDefinitions defines the number of columns and their width. -->

    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="14" FontFamily="Consolas" Text="Sender: Naval High Command"/>
    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="14" FontFamily="Consolas" Text="To: Commander of the Baltic Fleet"/>
    <TextBlock Grid.Row="5" Grid.Column="0" FontSize="18" FontFamily="Consolas" FontWeight="Bold" Text="Combat mission: Operation “The reckoning for Moonzund”"/>

<!-- Don't write all your text into a single TextBlock. XAML is very picky and doesn't like a lot of <LineBreak/> tags within one TextBlock. Splitting your text allows for more customization. -->
<!-- GRID.Row & GRID.Column define which row or column the TextBlock is placed in. -->

    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="16" FontFamily="Consolas" Text="1. OPERATIONAL SUMMARY"/>
	<TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas">
		Last night, at 01:14, Ministry of Defense satellites detected the departure of German Navy ships from Kiel and Wilhelmshaven. At 02:20, they joined the ships of the Danish and Swedish Navies, after which
        <LineBreak/>
        headed for the Gulf of Finland. There can be no doubt that the enemy has decided to defeat us with the forces of almost the entire NATO fleet in the Baltic. We can't ignore this.
        <LineBreak/>
        The entire Double Red Banner Baltic Fleet and the attached aircraft deployed in Estonia have been transferred under your command. We will meet the enemy at the Moonsoon archipelago, like our great-grandfathers,
        <LineBreak/>
        but we don't have the right to lose.
        <LineBreak/>
        Judging by the news, the UN is currently deciding on the terms of a cease-fire and a further truce. We have been given the opportunity to tip the scales in our direction. Do not let down your homeland and fallen comrades. Good luck. 
		<LineBreak/>
	</TextBlock>

    <TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" FontFamily="Consolas" Text="2. SUBORDINATE FORCES"/>
	<TextBlock Grid.Row="13" Grid.ColumnSpan="4" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas">
		- 1. The Double Red Banner Baltic Fleet
        <LineBreak/>
        - 2. Baltic Fleet Aviation
		<LineBreak/>		
	</TextBlock>

</Grid>