<!-- Created by Fre3dysbro. This template is a basic structure for creating XAML layouts for the Mission Briefings in the Sea Power Mission Editor. -->

<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="768">

<!-- Only "xmlns" and "xmlns:x" are required for standard XAML. The rest were added for design-time and are not necessary for runtime. You can Google what they do and try them out. -->

	<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="15"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="30"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
	</Grid.RowDefinitions>

<!-- GRID.RowDefinitions defines the number of rows and their height. If TextBlocks overlap in the preview, add more rows as needed. -->

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

<!-- GRID.ColumnDefinitions defines the number of columns and their width. -->

    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="14" FontFamily="Consolas" Text="Sender: Naval High Command"/>
    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="14" FontFamily="Consolas" Text="Recipient: Commander of the Task Force"/>
    <TextBlock Grid.Row="5" Grid.Column="0" FontSize="18" FontFamily="Consolas" FontWeight="Bold" Text="Combat mission: Operation “Tallinn Gate”"/>

<!-- Don't write all your text into a single TextBlock. XAML is very picky and doesn't like a lot of <LineBreak/> tags within one TextBlock. Splitting your text allows for more customization. -->
<!-- GRID.Row & GRID.Column define which row or column the TextBlock is placed in. -->

    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="16" FontFamily="Consolas" Text="1. OPERATIONAL SUMMARY"/>
	<TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas">
		After the successful completion of the first wave of strikes, the command authorizes the start of a major amphibious operation to capture Tallinn and quickly paralyze the resistance
        <LineBreak/>
        Estonian Armed Forces. At the moment, units of the 44th Army Corps are crossing the border and rushing inland. To provide support, they have been assigned
        <LineBreak/>
        almost the entire aviation of the Leningrad Military District, which is why you have quite limited support forces for the entire landing.
        <LineBreak/>
        The enemy has already begun to mobilize its forces in the region, so prepare for sudden visitors from the sea and Estonian rangers in the city itself.
        <LineBreak/>
        That's all. 
		<LineBreak/>
	</TextBlock>

    <TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" FontFamily="Consolas" Text="2. SUBORDINATE FORCES"/>
	<TextBlock Grid.Row="13" Grid.ColumnSpan="4" FontSize="14" TextWrapping="Wrap" FontFamily="Consolas">
		- 1. An operational strike group consisting of the ships pr. 20380 "Boiky" and "Perfect", pr. 1135M "Burevestnik", an attached group of amphibious ships 
        <LineBreak/>
        - 2. Su-25 attack aircraft
        <LineBreak/>
        - 3. 120th Guards Marine Division
		<LineBreak/>		
	</TextBlock>

</Grid>