            <LineBreak/>
               1——国家情报委员会副主席
            <LineBreak/>
               1——国家预警情报官
            <LineBreak/>
               1——执行登记处文件
          </TextBlock>
          <TextBlock Grid.Row="4" Text="绝密" TextAlignment="Center"/>
        </Grid>
      </Border>
    </Border>
