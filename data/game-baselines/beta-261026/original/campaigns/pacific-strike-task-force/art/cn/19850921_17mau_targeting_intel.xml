        <Grid TextElement.FontSize="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="侦察区域"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Text="数量"/>
          <TextBlock Grid.Row="0" Grid.Column="2" Text="设施"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="经纬度坐标"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,12,0" Text="航空基地"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,12,0" Text="4"/>
          <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,6,12,0" Text="机场/跑道"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,6,0,0" Text="09-44-21.6N / 118-44-57.0E"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,12,0" Text="航空基地"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,12,0" Text="4"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,4,12,0" Text="防空炮阵地A"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,4,0,0" Text="09-44-01.8N / 118-45-09.6E"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4,12,0" Text="航空基地"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,12,0" Text="4"/>
          <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,4,12,0" Text="防空炮阵地B"/>
          <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,4,0,0" Text="09-44-03.6N / 118-45-02.4E"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4,12,0" Text="航空基地"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,12,0" Text="4"/>
          <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,4,12,0" Text="S-300防空导弹阵地"/>
          <TextBlock Grid.Row="4" Grid.Column="3" Margin="0,4,0,0" Text="09-45-14.4N / 118-45-28.2E"/>

          <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4,12,0" Text="南方航道海岸"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,4,12,0" Text="上游-1导弹发射器A"/>
          <TextBlock Grid.Row="5" Grid.Column="3" Margin="0,4,0,0" Text="09-40-34.8N / 118-44-21.6E"/>

          <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4,12,0" Text="南方航道海岸"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="6" Grid.Column="2" Margin="0,4,12,0" Text="上游-1导弹发射器B"/>
          <TextBlock Grid.Row="6" Grid.Column="3" Margin="0,4,0,0" Text="09-40-36.0N / 118-44-25.8E"/>

          <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,4,12,0" Text="南方航道海岸"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="7" Grid.Column="2" Margin="0,4,12,0" Text="9K33导弹发射车A"/>
          <TextBlock Grid.Row="7" Grid.Column="3" Margin="0,4,0,0" Text="09-40-32.4N / 118-44-18.6E"/>

          <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,4,12,0" Text="南方航道海岸"/>
          <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="8" Grid.Column="2" Margin="0,4,12,0" Text="9K33导弹发射车B"/>
          <TextBlock Grid.Row="8" Grid.Column="3" Margin="0,4,0,0" Text="09-40-39.6N / 118-44-24.0E"/>

          <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,4,12,0" Text="南方航道海岸"/>
          <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,4,12,0" Text="5"/>
          <TextBlock Grid.Row="9" Grid.Column="2" Margin="0,4,12,0" Text="SON-9火控雷达"/>
          <TextBlock Grid.Row="9" Grid.Column="3" Margin="0,4,0,0" Text="09-40-36.6N / 118-44-22.2E"/>

          <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,4,12,0" Text="北方航道海岸"/>
          <TextBlock Grid.Row="10" Grid.Column="1" Margin="0,4,12,0" Text="2"/>
