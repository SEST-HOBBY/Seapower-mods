<!-- Pacific Strike 17 MAU targeting intelligence event: naval-message paper format. -->
<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
    <Border.Effect>
      <DropShadowEffect />
    </Border.Effect>
    <Border.Background>
      <ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
    </Border.Background>

    <StackPanel Orientation="Vertical">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="3*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="海军消息" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Left"/>
        <TextBlock Grid.Column="1" Text="——————机————密——————" Margin="40,0,40,0" FontWeight="Bold" TextAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="海军部" FontFamily="Arial Narrow Bold" FontSize="26" FontWeight="Bold" TextAlignment="Right"/>
      </Grid>

      <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,1"/>
      <Rectangle HorizontalAlignment="Stretch" Height="1" Fill="Black" Margin="0,0,0,10"/>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" FontSize="16">
          立即<LineBreak/>
          1985年9月21日2300Z时
        </TextBlock>

        <TextBlock Grid.Row="0" Grid.Column="3" FontSize="16" Text="ZYUW RUHQHQA0777 2642300"/>
      </Grid>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" Text="发件："/>
        <TextBlock Grid.Row="0" Grid.Column="2" FontSize="16" Text="夏威夷州火奴鲁鲁太平洋司令部总司令"/>
        <TextBlock Grid.Row="1" Grid.Column="0" FontSize="16" Text="收件："/>
        <TextBlock Grid.Row="1" Grid.Column="2" FontSize="16" Text="海军陆战队第17远征队指挥官"/>
        <TextBlock Grid.Row="2" Grid.Column="0" FontSize="16" Text="抄送："/>
        <TextBlock Grid.Row="2" Grid.Column="2" FontSize="16">
          马来西亚山打根第77特遣舰队指挥官<LineBreak/>
          夏威夷州珍珠港太平洋舰队总司令<LineBreak/>
          夏威夷州珍珠港太平洋潜艇部队司令<LineBreak/>
          澳大利亚北领地达尔文海军总部
        </TextBlock>
        <TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="主题："/>
        <TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="目标情报——普林塞萨港设施"/>
      </Grid>

      <TextBlock TextWrapping="Wrap" FontSize="16" Margin="0,24,0,0">
        机密
        <LineBreak/>
        正文分隔
        <LineBreak/><LineBreak/>
        参考资料：
        <LineBreak/>
        A.俄里翁号态势报告20-85/PP（潜望镜照片和电子支援定位）。
        <LineBreak/>
        B.太平洋司令部总司令联合情报中心目标档案（PP-挑战者-17）。
        <LineBreak/>
        C.第77特遣舰队空中/火力支援记录（1985年9月21日/挑战者行动）。
        <LineBreak/><LineBreak/>
        1.（机密）概要：澳大利亚皇家海军俄里翁号潜艇在普林塞萨港两栖突击区域发现了11处敌方设施。以下数据已传递给第17远征队指挥部，用于制定打击计划和降低登陆风险。
        <LineBreak/><LineBreak/>
        2.（机密）瞄准数据：
      </TextBlock>

