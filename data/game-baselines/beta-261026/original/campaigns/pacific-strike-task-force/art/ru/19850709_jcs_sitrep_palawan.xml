<!-- Campaign event template for JCS-style message traffic - header follows RichMissionMessages USAJCS format -->

<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:SeapowerUI">

	<Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" TextElement.FontFamily="Courier New" TextElement.Foreground="Black" TextElement.FontSize="16" Padding="45">
		<Border.Effect>
			<DropShadowEffect />
		</Border.Effect>
		<Border.Background>
			<ImageBrush ImageSource="{Binding Assets[bkg_paper]}" Stretch="UniformToFill"/>
		</Border.Background>
		
        <StackPanel Orientation="Vertical">

		<Grid
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			
			<TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0" FontFamily="Roboto Mono" FontSize="14" TextAlignment="Center" HorizontalAlignment="Center">
				Министерство обороны<LineBreak/>
				Центр сообщений ОКНШ
			</TextBlock>
			
		</Grid>

			<Grid
			  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
			<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="10"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="10"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBlock Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Left" FontSize="16">
					FLASH<LineBreak/>
					14:30UTC 09 Июл 85
				</TextBlock>

				<TextBlock Grid.Row="1" Grid.Column="3" FontSize="16" Text="ZYUW RUEKJCS4169 1901430"/>
				
				<TextBlock Grid.Row="3" Grid.Column="0" FontSize="16" Text="От кого:"/>
				<TextBlock Grid.Row="3" Grid.Column="2" FontSize="16" Text="ОКНШ, Вашингтон, ОК"/>
				<TextBlock Grid.Row="4" Grid.Column="0" FontSize="16" Text="Кому:"/>
				<TextBlock Grid.Row="4" Grid.Column="2" FontSize="16" Text="Белый Дом, Вашингтон, ОК"/>
				<TextBlock Grid.Row="11" Grid.Column="0" FontSize="16" Text="Копия:"/>
				<TextBlock Grid.Row="11" Grid.Column="2" FontSize="16" Text="Министр обороны, Вашингтон, ОК"/>
				<TextBlock Grid.Row="12" Grid.Column="2" FontSize="16" Text="Государственный секретарь, Вашингтон, ОК"/>
				<TextBlock Grid.Row="13" Grid.Column="2" FontSize="16" Text="Директор ЦРУ, Вашингтон, ОК"/>
				<TextBlock Grid.Row="14" Grid.Column="0" FontSize="16" Text="Тема:"/>
				<TextBlock Grid.Row="14" Grid.Column="2" FontSize="16" Text="Оперативная сводка ОКНШ 001 - Вторжение на Палаван / Стратегические последствия"/>

				<TextBlock Grid.Row="15" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					<LineBreak/>
					СЕКРЕТНО
					<LineBreak/>
					<LineBreak/>
					1. (S) КРАТКАЯ СВОДКА: предварительные донесения указывают, что противник высадил крупную десантную группировку на острове Палаван, западные Филиппины. Местная оборона была быстро подавлена. Войска противника теперь контролируют южную оконечность Палавана и продвигаются, чтобы захватить объекты в районе Пуэрто-Принсессы.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="16" Grid.ColumnSpan="4" FontSize="16" TextWrapping="Wrap">
					2. (S) ДЕЙСТВИЯ ПРОТИВНИКА: советские тяжёлые высадочные средства и ударная авиация из Камрани поддержали штурм и высадили китайские подразделения на берег значительными силами. Последующие эшелоны могут включать боеприпасы, инженерные подразделения, топливо и средства ПВО, предназначенные для закрепления постоянного плацдарма.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="17" Grid.ColumnSpan="4" TextWrapping="Wrap">
					3. (S) УГРОЗА НА МОРЕ:
				</TextBlock>	
				<TextBlock Grid.Row="18" Grid.ColumnSpan="4" TextWrapping="Wrap" Margin="20,0,0,0">	
					- Поступали сообщения о пусках противокорабельных ракет по американским и филиппинским кораблям, пытавшимся пройти пролив Балабак.
					<LineBreak/>
					- По оценке, китайские и советские подводные лодки действуют в проливе Балабак и на прилегающих подходах.
					<LineBreak/>
					- По оценке, на критически важных подходах к проливу Балабак и проходу Палаван ведётся постановка мин.
					<LineBreak/>
				</TextBlock>	
				<TextBlock Grid.Row="19" Grid.ColumnSpan="4" TextWrapping="Wrap">
					4. (S) СОСТОЯНИЕ ДРУЖЕСТВЕННЫХ / РЕГИОНАЛЬНЫХ СИЛ: имеющихся сил союзников в непосредственном районе недостаточно, чтобы парировать высадку на Палаване. Мощные воздушные удары по Малайзии и Филиппинам подавили наши ударные возможности в регионе.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="21" Grid.ColumnSpan="4" TextWrapping="Wrap">
					5. (S) ПОЛИТИКА / ПОЛОЖЕНИЕ СИЛ: движение военно-морских сил союзников к Сингапуру через Южно-Китайское море больше не считается осуществимым без серьёзного риска. Объединённый комитет начальников штабов рекомендует немедленно перегруппировать доступные силы США и союзников в Дарвине, Австралия, сохраняя поддержку филиппинскому сопротивлению.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="23" Grid.ColumnSpan="4" TextWrapping="Wrap">
					6. (S) ОЦЕНКА: контроль противника над Палаваном серьёзно осложняет операции США в Юго-Восточной Азии и создаёт риск отсечения американских сил, входящих в Южно-Китайское море. Если Индонезия перейдёт к поддержке Советов, южные выходы могут быстро закрыться, заперев значительные силы вдали от логистической поддержки и в радиусе действия советских бомбардировщиков из Камрани. Последующие оперативные сводки будут передаваться с интервалом 12 часов.
					<LineBreak/>
				</TextBlock>
				<TextBlock Grid.Row="25" Grid.ColumnSpan="4" TextWrapping="Wrap">
					НАЦИОНАЛЬНЫЙ ВОЕННЫЙ КОМАНДНЫЙ ЦЕНТР
					<LineBreak/>
				</TextBlock>
			</Grid>
        </StackPanel>
    </Border>
</ScrollViewer>
