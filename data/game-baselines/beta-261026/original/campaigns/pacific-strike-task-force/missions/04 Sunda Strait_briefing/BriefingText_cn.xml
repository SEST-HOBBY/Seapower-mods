<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
	<TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Left" FontSize="{StaticResource Font.Size.Header}">
	紧急
	<LineBreak/>
	1985年7月15日0130Z时
	</TextBlock>
    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="发件："/>
    <TextBlock Grid.Row="3" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="第77特遣舰队指挥官"/>
    <TextBlock Grid.Row="4" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="收件："/>
    <TextBlock Grid.Row="4" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="{TaskForceName}指挥官"/>
	<TextBlock Grid.Row="5" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="抄送："/>
    <TextBlock Grid.Row="5" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}">
		夏威夷州珍珠港太平洋舰队总司令<LineBreak/>
		澳大利亚新南威尔士州格伦布鲁克皇家空军司令部
	</TextBlock>
    <TextBlock Grid.Row="7" Grid.Column="0" FontSize="{StaticResource Font.Size.Header}" Text="主题："/>
    <TextBlock Grid.Row="7" Grid.Column="2" FontSize="{StaticResource Font.Size.Header}" Text="重分配——前往达尔文的调动命令"/>
    <TextBlock Grid.Row="9" Grid.ColumnSpan="4" FontSize="{StaticResource Font.Size.Header}" TextWrapping="Wrap">
	  机密
	  <LineBreak/>
      <LineBreak/>
	  1.（机密）新加坡和印度尼西亚于6月25日至7月14日期间遭到敌方猛烈攻击的压制，目前局势尚不明朗。所有驻东南亚美军收到命令撤往位于澳大利亚达尔文的新后备阵地。
      <LineBreak/>
      <LineBreak/>
      2.（机密）{TaskForceName}的所有单位以最佳速度开往达尔文，经巽他海峡离开爪哇海。
      <LineBreak/>
      <LineBreak/>
	  3.（机密）海运加勒比海号油船将在雅加达与你会合。
	  <LineBreak/>
      <LineBreak/>
	  4.（机密）报告显示敌方水面部队正在以最大速度向南航行，目标可能是封锁巽他海峡，阻止盟军通行。
	  <LineBreak/>
      <LineBreak/>
	  5.（机密）敌方先头部队和潜艇可能在巽他海峡附近活动。
	  <LineBreak/>
      <LineBreak/>
	  6.（机密）离开海峡后，澳大利亚皇家空军的A-4小队将为你提供空中巡逻并护送你前往达尔文。祝你好运。
	  <LineBreak/>
      <LineBreak/>
	  机密
	  <LineBreak/>
	  解密：由原始发布机构决定
	  </TextBlock>

</Grid>