+            .Single(t => t.FullName == "SeapowerUI.GizmoLayerManager+Entry" && t.IsValueType);
+        internal static readonly ConstructorInfo EntryCtor = Entry.GetConstructors(Instance)
+            .Single(c => Parameters(c, "System.Int32", "System.String", "System.Boolean"));
+        internal static readonly ConstructorInfo LayerCtor = typeof(MapLayer).GetConstructors(Instance)
+            .Single(c => c.IsAssembly && Parameters(c, "SeapowerUI.MapDisplayState", "SeapowerUI.GizmoLayerManager+Entry&", "System.Boolean"));
+        internal static readonly AccessTools.FieldRef<MapUnitViewModel, MapLabelCandidate> Label =
+            AccessTools.FieldRefAccess<MapUnitViewModel, MapLabelCandidate>(Field(typeof(MapUnitViewModel), "Label", typeof(MapLabelCandidate)));
+        internal static readonly AccessTools.FieldRef<MapUnitViewModel, bool> Line3Initialized =
+            AccessTools.FieldRefAccess<MapUnitViewModel, bool>(Field(typeof(MapUnitViewModel), "_line3Initialized", typeof(bool)));
+        internal static readonly AccessTools.FieldRef<MapUnitViewModel, string> ContactInfoLine3 =
+            AccessTools.FieldRefAccess<MapUnitViewModel, string>(Field(typeof(MapUnitViewModel), "_contactInfoLine3", typeof(string)));
+        internal static readonly AccessTools.FieldRef<MapLabelCandidate, bool> Realized =
+            AccessTools.FieldRefAccess<MapLabelCandidate, bool>(Field(typeof(MapLabelCandidate), "Realized", typeof(bool)));
+        internal static readonly AccessTools.FieldRef<MapLabelCandidate, int> Prefix =
+            AccessTools.FieldRefAccess<MapLabelCandidate, int>(Field(typeof(MapLabelCandidate), "Prefix", typeof(int)));
+        internal static readonly AccessTools.FieldRef<MapLabelCandidate, MapLabelLine> HeadLine =
+            AccessTools.FieldRefAccess<MapLabelCandidate, MapLabelLine>(Field(typeof(MapLabelCandidate), "HeadLine", typeof(MapLabelLine)));
+        internal static readonly ConditionalWeakTable<MapUnitViewModel, Due> Next = new ConditionalWeakTable<MapUnitViewModel, Due>();
+
+        internal sealed class Due { internal double At = double.NegativeInfinity; }
+
+        private static bool Parameters(MethodBase method, params string[] names)
+            => method.GetParameters().Select(p => p.ParameterType.FullName).SequenceEqual(names);
+
+        private static FieldInfo Field(Type owner, string name, Type type)
+        {
+            var field = owner.GetField(name, Instance | BindingFlags.DeclaredOnly);
+            if (field == null || field.IsStatic || field.FieldType != type)
+                throw new MissingFieldException("Inspected beta " + owner.Name + "." + name + " changed");
+            return field;
+        }
+    }
+
+    // Replaces the author's `newobj MapLayer::.ctor(int layerNumber, string
+    // name, bool visibleInMenu)` (stable rid 4335, public, _visible left at
+    // true). Mirrors native MapDisplayState..ctor(bool) IL_0079-008c, which
+    // builds each Tactical layer as new MapLayer(this, ref entry, visible)
+    // from an Entry(Number, Name, InMenu); visible is true, as stable left it.
+    // The author's Register then sets Visible itself.
+    public static MapLayer BetterTacMapNewLayer(int layerNumber, string name, bool visibleInMenu, MapDisplayState owner)
+    {
+        if (owner == null) throw new ArgumentNullException(nameof(owner));
+        object entry = BetterTacMapNative.EntryCtor.Invoke(new object[] { layerNumber, name, visibleInMenu });
+        return (MapLayer)BetterTacMapNative.LayerCtor.Invoke(new object[] { owner, entry, true });
+    }
+
+    // Native MapUnitViewModel.UpdateContactInfoLine3 (beta rid 5756) calls
+    // set_ContactInfoLine3, where the author's label Prefix runs, only when
+    // its own inputs change (IL_00c1-010a, IL_0131, IL_0284) and the rebuilt
+    // text differs from _contactInfoLine3 (IL_03da-03eb, BuilderEquals).
+    // Stable called the setter on every Update. Every half second, while line
+    // 3 is shown, this clears both fields: the next Update then treats the
+    // inputs as changed, BuilderEquals(builder, null) is false, the setter
+    // and the author's Prefix run, and BumpContentVersion re-measures the
+    // label. The raw field writes raise no PropertyChanged.
+    public static void BetterTacMapRefreshLine3(MapUnitViewModel view)
+        => BetterTacMapRefreshLine3At(view, GameTime.unscaledTime);
+
+    public const double BetterTacMapLine3Seconds = 0.5;
+
+    public static bool BetterTacMapRefreshLine3At(MapUnitViewModel view, double now)
+    {
+        if (view == null || !BetterTacMapLine3Shown(view)) return false;
+        var due = BetterTacMapNative.Next.GetOrCreateValue(view);
+        if (now < due.At) return false;
+        due.At = now + BetterTacMapLine3Seconds;
+        BetterTacMapNative.Line3Initialized(view) = false;
+        BetterTacMapNative.ContactInfoLine3(view) = null;
+        return true;
+    }
+
+    // Native UpdateContactInfoLine3 IL_0000-0030: line 3 is shown when the
+    // label is realized and its prefix covers it (index 2, or 3 with a head line).
+    public static bool BetterTacMapLine3Shown(MapUnitViewModel view)
+    {
+        var label = BetterTacMapNative.Label(view);
+        if (label == null) return false;
+        int line = (BetterTacMapNative.HeadLine(label) != null ? 1 : 0) + 2;
+        return BetterTacMapNative.Realized(label) && BetterTacMapNative.Prefix(label) > line;
+    }
+}
diff --git a/integration/beta-anchorchain/source/BetaCompatibilityCalls.MissileControlMod.cs b/integration/beta-anchorchain/source/BetaCompatibilityCalls.MissileControlMod.cs
new file mode 100644
index 00000000..7296b425
--- /dev/null
+++ b/integration/beta-anchorchain/source/BetaCompatibilityCalls.MissileControlMod.cs
@@ -0,0 +1,91 @@
+// MissileControlMod 0.1.16 bridges, used only by its hash-pinned private image.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Reflection.Emit;
+using HarmonyLib;
+
+namespace AnchorChain;
+
+public static partial class BetaCompatibilityCalls
+{
+    // Lookups isolated in their own class, so a failed lookup cannot break
+    // BetaCompatibilityCalls' other bridges; a null lookup leaves the stream
+    // unchanged and the author's own shape check then disables the plugin.
+    private static class MissileControlModSteering
+    {
+        internal const BindingFlags Instance = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly;
+        internal static readonly FieldInfo MaxG = Field(typeof(SeaPower.AmmunitionParameters), "_maxTurnG", "System.Single");
+        internal static readonly FieldInfo MaxRate = Field(typeof(SeaPower.AmmunitionParameters), "_maxTurnRateDegrees", "System.Single");
+        internal static readonly MethodInfo Formula = typeof(BetaCompatibilityCalls).GetMethod(nameof(MissileControlModGLimitedTurnRate));
+
+        static FieldInfo Field(Type type, string name, string fieldType)
+        {
+            var field = type.GetField(name, Instance);
+            return field != null && field.FieldType.FullName == fieldType ? field : null;
+        }
+    }
+
+    private static bool MissileControlModMethod(object operand, string type, string name, bool isStatic, string returnType, params string[] parameters)
+        => operand is MethodInfo method && method.DeclaringType?.FullName == type && method.Name == name && method.IsStatic == isStatic &&
+            method.ReturnType.FullName == returnType && method.GetParameters().Select(p => p.ParameterType.FullName).SequenceEqual(parameters);
+
+    private static bool MissileControlModField(object operand, string type, string name, string fieldType)
+        => operand is FieldInfo field && field.DeclaringType?.FullName == type && field.Name == name && !field.IsStatic &&
+            field.FieldType.FullName == fieldType;
+
+    // MissileControlMod's Hooks.SteeringLimits is PatchSteeringLimits(source, 1, 1, 2):
+    // it wraps the one _maxTurnG and the one _maxTurnRateDegrees load of
+    // WeaponBase.setCourseTowardsPosition with its EffectiveG/EffectiveRate.
+    // Beta 261026 moved both loads, unchanged, into WeaponBase.GLimitedTurnRate:
+    //     ldarg.0; ldfld _ap; ldarg.0; call getVelocityInKnots; call GLimitedTurnRate
+    // This returns the stream the author's transpiler expects:
+    //     ldarg.0; ldfld _ap; ldfld _maxTurnG; ldarg.0; ldfld _ap; ldfld _maxTurnRateDegrees;
+    //     ldarg.0; call getVelocityInKnots; call MissileControlModGLimitedTurnRate
+    // which computes what native GLimitedTurnRate(_ap, knots) computes. Any
+    // other stream (setCourseTowardsPositionLegacy, another beta) passes through
+    // unchanged, so the author's own check still fails closed.
+    public static IEnumerable<CodeInstruction> MissileControlModSteeringShape(IEnumerable<CodeInstruction> source)
+    {
+        var list = source.ToList();
+        int k = -1;
+        for (int i = 0; i < list.Count; i++) {
+            if (!MissileControlModMethod(list[i].operand, "SeaPower.WeaponBase", "GLimitedTurnRate", true, "System.Single",
+                "SeaPower.AmmunitionParameters", "System.Single")) continue;
+            if (k >= 0) return list;
+            k = i;
+        }
+        if (k < 4 || list[k].opcode != OpCodes.Call || MissileControlModSteering.MaxG == null ||
+            MissileControlModSteering.MaxRate == null || MissileControlModSteering.Formula == null ||
+            list[k - 4].opcode != OpCodes.Ldarg_0 ||
+            list[k - 3].opcode != OpCodes.Ldfld || !MissileControlModField(list[k - 3].operand, "SeaPower.WeaponBase", "_ap", "SeaPower.AmmunitionParameters") ||
+            list[k - 2].opcode != OpCodes.Ldarg_0 ||
+            list[k - 1].opcode != OpCodes.Call || !MissileControlModMethod(list[k - 1].operand, "SeaPower.ObjectBase", "getVelocityInKnots", false, "System.Single"))
+            return list;
+        for (int i = k - 3; i <= k; i++) if (list[i].labels.Count != 0 || list[i].blocks.Count != 0) return list;
+        // A new call instruction: the incoming one carries no labels or blocks
+        // (checked above), and the caller's instruction objects stay unchanged.
+        list[k] = new CodeInstruction(OpCodes.Call, MissileControlModSteering.Formula);
+        list.InsertRange(k - 2, new[] {
+            new CodeInstruction(OpCodes.Ldfld, MissileControlModSteering.MaxG),
+            new CodeInstruction(OpCodes.Ldarg_0),
+            new CodeInstruction(OpCodes.Ldfld, list[k - 3].operand),
+            new CodeInstruction(OpCodes.Ldfld, MissileControlModSteering.MaxRate) });
+        return list;
+    }
+
+    // Mirrors native beta SeaPower.WeaponBase.GLimitedTurnRate(AmmunitionParameters
+    // ap, float speedInKnots) operation for operation, with ap._maxTurnG and
+    // ap._maxTurnRateDegrees taken as arguments: speed in m/s, the turn radius
+    // at the configured turn rate, and the rate scaled down when the lateral
+    // load exceeds the G limit.
+    public static float MissileControlModGLimitedTurnRate(float maxTurnG, float maxTurnRateDegrees, float speedInKnots)
+    {
+        float speed = 0.5144439935684204f * speedInKnots;
+        float radius = speed * (360f / maxTurnRateDegrees) / 6.2831855f;
+        float lateralG = MathF.Pow(speed, 2f) / (radius * 9.8f);
+        if (lateralG > maxTurnG) maxTurnRateDegrees *= maxTurnG / lateralG;
+        return maxTurnRateDegrees;
+    }
+}
diff --git a/integration/beta-anchorchain/source/BetaCompatibilityCalls.OspreyMechanics.cs b/integration/beta-anchorchain/source/BetaCompatibilityCalls.OspreyMechanics.cs
new file mode 100644
index 00000000..49aa25e5
--- /dev/null
+++ b/integration/beta-anchorchain/source/BetaCompatibilityCalls.OspreyMechanics.cs
@@ -0,0 +1,132 @@
+// Bridges for the hash-pinned OspreyMechanics 1.1.45 image only (see
+// AssemblyAdapters.OspreyMechanics.cs). Stable Build 261021 kept the last
+// ISpeedCommand object in ObjectBase.SpeedCommand, and the plugin decides
+// "I own this unit's speed" by ReferenceEquals with the ConstantSpeed it
+// issued. Beta Build 261026 keeps one SpeedState per unit and applies value
+// SpeedRequests to it. The plugin's orders are therefore applied through the
+// native SetSpeedCommand(in SpeedRequest), and its reads hand back the order
+// object it issued while the unit's SpeedState still holds exactly that
+// request; otherwise they hand back what the game holds.
+using System;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using HarmonyLib;
+using SeaPower;
+
+namespace AnchorChain;
+
+public static partial class BetaCompatibilityCalls
+{
+    // The plugin's own speed order: the request it applied and the knots it
+    // asked for (what its OwnsSpeed compares with ExpectedKnots). It never
+    // reaches native code: SpeedCommand.Value stays the unit's SpeedState.
+    public sealed class OspreyMechanicsSpeedOrder : ISpeedCommand
+    {
+        public readonly SpeedRequest Request;
+        private readonly float knots;
+        internal OspreyMechanicsSpeedOrder(SpeedRequest request, float knots) { Request = request; this.knots = knots; }
+        // As SpeedState.get_Kind and get_Telegraph: read from the request.
+        public SpeedKind Kind => Request.Kind;
+        public int Telegraph => Request.Step;
+        public bool AvoidingCavitation => false;
+        public float CommandSpeedInKnots => knots;
+        public float SpeedInKnots => knots;
+        public float SpeedInMach => Request.Kind == SpeedKind.Mach ? Request.Value : 0f;
+        public float MachLimit => 0f;
+        public bool SpeedIsOverriden => false;
+        public float OverridenSpeedInKnots => 0f;
+        public float GetDemandedSpeedInKnots(ObjectBase objectBase) => knots;
+        public float GetDemandedSpeedInMetresPerSecond(ObjectBase objectBase) => knots / 1.94384f;
+        public void Update(ObjectBase objectBase) { }
+        public void OverrideSpeed(float speedInKnots) { }
+        public void CancelSpeedOverride() { }
+    }
+
+    // The order the plugin last applied to each unit (stable: SpeedCommand.Value
+    // after its SetSpeedCommand), and the order whose native call is running.
+    private static readonly ConditionalWeakTable<ObjectBase, OspreyMechanicsSpeedOrder> ospreyMechanicsApplied = new();
+    [ThreadStatic] private static OspreyMechanicsSpeedOrder ospreyMechanicsInFlight;
+    [ThreadStatic] private static ObjectBase ospreyMechanicsInFlightUnit;
+
+    // Replaces newobj ConstantSpeed(float speedInKnots, ObjectBase objectBase).
+    // Mirrors beta ConstantSpeed..ctor (stores the knots; objectBase unused)
+    // followed by ConstantSpeed.ToRequest(): SpeedRequest.Knots(speedInKnots).
+    public static ISpeedCommand OspreyMechanicsConstantSpeed(float speedInKnots, ObjectBase objectBase)
+        => new OspreyMechanicsSpeedOrder(SpeedRequest.Knots(speedInKnots), speedInKnots);
+
+    // Replaces callvirt ObjectBase.SetSpeedCommand(ISpeedCommand). Calls beta
+    // ObjectBase.SetSpeedCommand(in SpeedRequest) with the order's request (an
+    // equal request leaves the state unchanged, as natively), and records the
+    // order as the unit's current plugin command, as stable's set_Value did.
+    public static void OspreyMechanicsSetSpeedCommand(ObjectBase unit, ISpeedCommand command)
+    {
+        if (command is not OspreyMechanicsSpeedOrder order)
+            throw new ArgumentException("OspreyMechanics speed order was not created by its beta bridge");
+        var request = order.Request;
+        var previous = ospreyMechanicsInFlight; var previousUnit = ospreyMechanicsInFlightUnit;
+        ospreyMechanicsInFlight = order; ospreyMechanicsInFlightUnit = unit;
+        try { unit.SetSpeedCommand(in request); }
+        finally { ospreyMechanicsInFlight = previous; ospreyMechanicsInFlightUnit = previousUnit; }
+        ospreyMechanicsApplied.Remove(unit);
+        ospreyMechanicsApplied.Add(unit, order);
+    }
+
+    // Follows the plugin's native read unit.SpeedCommand.Value (beta: null, or
+    // the unit's SpeedState). Returns the plugin's order while the SpeedState
+    // still holds the request that order applied, else the native value.
+    public static ISpeedCommand OspreyMechanicsSpeedCommand(ObjectBase unit, ISpeedCommand current)
+        => OspreyMechanicsOwned(unit, current);
+
+    // As OspreyMechanicsSpeedCommand, for the value DippingSonar keeps as
+    // ResumeSpeed and re-applies on retrieval. A native SpeedState is captured
+    // as an order holding its current request (SpeedState.get_Request) and its
+    // SpeedState.GetDemandedSpeedInKnots, so the re-apply restores that request.
+    public static ISpeedCommand OspreyMechanicsSpeedSnapshot(ObjectBase unit, ISpeedCommand current)
+    {
+        var owned = OspreyMechanicsOwned(unit, current);
+        return owned is SpeedState state ? new OspreyMechanicsSpeedOrder(state.Request, state.GetDemandedSpeedInKnots(unit)) : owned;
+    }
+
+    // Replaces each load of the hooks' stable speedCommand argument, now
+    // "ref SpeedRequest request" bound to beta SetSpeedCommand(in SpeedRequest
+    // request). The plugin's own call hands back its in-flight order (stable
+    // passed that object). Any other call replaced the plugin's command on
+    // stable, so the plugin no longer owns the unit's speed; it gets the unit's
+    // SpeedState when that holds the request (as SpeedCommand.Value does after
+    // SetSpeedCommand), else an order for the incoming request.
+    public static ISpeedCommand OspreyMechanicsIncomingSpeedCommand(ObjectBase unit, in SpeedRequest request)
+    {
+        var flight = ospreyMechanicsInFlight;
+        if (flight != null && ReferenceEquals(ospreyMechanicsInFlightUnit, unit) && flight.Request.Equals(request)) return flight;
+        if (unit is not null) ospreyMechanicsApplied.Remove(unit);
+        var state = unit.Speed;
+        if (state is not null && state.Request.Equals(request)) return state;
+        return new OspreyMechanicsSpeedOrder(request, request.Kind == SpeedKind.Constant ? request.Value : 0f);
+    }
+
+    // Replaces AccessTools.Method(type, name, parameters, generics) at the two
+    // SetSpeedCommand lookups. The stable lookups (by name, or with
+    // [ISpeedCommand]) resolve to beta's SetSpeedCommand(in SpeedRequest
+    // request); the generic SetSpeedCommand<T>(in T order) forwards to it, so
+    // that one target sees every speed order. Anything else passes through.
+    public static MethodInfo OspreyMechanicsMethod(Type type, string name, Type[] parameters, Type[] generics)
+    {
+        if (type != null && type.FullName == "SeaPower.ObjectBase" && type.Assembly.GetName().Name == "Seapower-Scripts" &&
+            name == "SetSpeedCommand" && generics == null &&
+            (parameters == null || (parameters.Length == 1 && parameters[0]?.FullName == "SeaPower.ISpeedCommand"))) {
+            var matches = type.GetMethods(BindingFlags.DeclaredOnly | BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
+                .Where(m => m.Name == "SetSpeedCommand" && !m.IsGenericMethodDefinition && m.ReturnType == typeof(void) &&
+                    m.GetParameters().Length == 1 && m.GetParameters()[0].Name == "request" && m.GetParameters()[0].ParameterType.IsByRef &&
+                    m.GetParameters()[0].ParameterType.GetElementType().FullName == "SeaPower.SpeedRequest")
+                .ToArray();
+            if (matches.Length != 1) throw new InvalidOperationException("Inspected beta ObjectBase.SetSpeedCommand(in SpeedRequest) changed");
+            return matches[0];
+        }
+        return AccessTools.Method(type, name, parameters, generics);
+    }
+
+    private static ISpeedCommand OspreyMechanicsOwned(ObjectBase unit, ISpeedCommand current)
+        => current is SpeedState state && unit is not null && ospreyMechanicsApplied.TryGetValue(unit, out var mine) &&
+            state.Request.Equals(mine.Request) ? mine : current;
+}
diff --git a/integration/beta-anchorchain/source/BetaCompatibilityCalls.ParallelRangeProbe.cs b/integration/beta-anchorchain/source/BetaCompatibilityCalls.ParallelRangeProbe.cs
new file mode 100644
index 00000000..6952eb01
--- /dev/null
+++ b/integration/beta-anchorchain/source/BetaCompatibilityCalls.ParallelRangeProbe.cs
@@ -0,0 +1,63 @@
+// ParallelRangeProbe 0.12.0 (R6). Used only by its hash-pinned private image.
+using System;
+using System.Collections;
+using System.Reflection;
+using System.Reflection.Emit;
+
+namespace AnchorChain;
+
+public static partial class BetaCompatibilityCalls
+{
+    // Called by the adapted WorkerExpansion.NativeSensorKernel.Read(MethodInfo)
+    // with the instruction list it decoded, just before it returns. For beta
+    // SeaPower.RadarCalculator.BaseMaxDetectionRangeMeter(float, float, float, float)
+    // only, the single `ldsfld RadarCalculator::FourPiCubed` (IL_0026) becomes
+    // `ldc.r4 <FourPiCubed>`: the value native reads there, which beta's
+    // RadarCalculator..cctor sets once to Mathf.Pow(12.566371f, 3f) (the field
+    // is static initonly). Every other method's list is left untouched, and
+    // any other static field read in that method throws, so the plugin's own
+    // FALLBACK path keeps the native game behaviour.
+    public static void ParallelRangeProbeFoldDetectionConstant(IList code, MethodInfo source)
+    {
+        if (code == null || !ParallelRangeProbeIsDetection(source)) return;
+        var four = source.DeclaringType.GetField("FourPiCubed", BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic);
+        if (four == null || !ParallelRangeProbeIsFourPiCubed(four))
+            throw new InvalidOperationException("Inspected beta RadarCalculator.FourPiCubed changed");
+        const BindingFlags fields = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
+        int folded = 0;
+        foreach (object instruction in code) {
+            var type = instruction?.GetType();
+            var opcode = type?.GetField("opcode", fields);
+            var operand = type?.GetField("operand", fields);
+            if (type?.FullName != "WorkerExpansion.NativeSensorKernel+Instruction" || opcode?.FieldType != typeof(OpCode) ||
+                operand?.FieldType != typeof(object))
+                throw new InvalidOperationException("Inspected ParallelRangeProbe sensor instruction changed");
+            var op = (OpCode)opcode.GetValue(instruction);
+            if (op == OpCodes.Ldsflda || op == OpCodes.Stsfld)
+                throw new InvalidOperationException("Uninspected static field access in beta detection kernel");
+            if (op != OpCodes.Ldsfld) continue;
+            if (!(operand.GetValue(instruction) is FieldInfo field) || !ParallelRangeProbeIsFourPiCubed(field))
+                throw new InvalidOperationException("Uninspected static read in beta detection kernel");
+            opcode.SetValue(instruction, OpCodes.Ldc_R4);
+            operand.SetValue(instruction, (float)four.GetValue(null));
+            folded++;
+        }
+        if (folded != 1) throw new InvalidOperationException("Beta detection kernel fold count changed: " + folded);
+    }
+
+    // Structural match, never reference equality: declaring type, name,
+    // static, parameter and return types.
+    public static bool ParallelRangeProbeIsDetection(MethodInfo method)
+    {
+        if (method == null || !method.IsStatic || method.Name != "BaseMaxDetectionRangeMeter" ||
+            method.DeclaringType?.FullName != "SeaPower.RadarCalculator" || method.ReturnType.FullName != "System.Single") return false;
+        var parameters = method.GetParameters();
+        if (parameters.Length != 4) return false;
+        foreach (var parameter in parameters) if (parameter.ParameterType.FullName != "System.Single") return false;
+        return true;
+    }
+
+    private static bool ParallelRangeProbeIsFourPiCubed(FieldInfo field)
+        => field.Name == "FourPiCubed" && field.IsStatic && field.IsInitOnly &&
+            field.DeclaringType?.FullName == "SeaPower.RadarCalculator" && field.FieldType.FullName == "System.Single";
+}
diff --git a/integration/beta-anchorchain/source/BetaCompatibilityCalls.TestRange.cs b/integration/beta-anchorchain/source/BetaCompatibilityCalls.TestRange.cs
new file mode 100644
index 00000000..cc7dcce7
--- /dev/null
+++ b/integration/beta-anchorchain/source/BetaCompatibilityCalls.TestRange.cs
@@ -0,0 +1,69 @@
+// R6 bridges for the hash-pinned TestRange 0.2.3 private image. Both replace
+// calls inside the author's CountermeasureApi.Validate registration of its
+// combined-jamming hook; neither changes game code. Operands are matched by
+// name, never by reference equality, and a mismatch throws, which the
+// author's InitializeWhenModEnabled catch turns into the plugin's own
+// "[TestRange] Initialization failed" stop, as on the beta today.
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using SeaPower;
+
+namespace AnchorChain;
+
+public static partial class BetaCompatibilityCalls
+{
+    // TestRange's ECM.JamUnit argument list, CountermeasureApi.Validate IL_0099..IL_0107.
+    private static readonly string[] TestRangeJamUnitTypes = { "System.Single", "UnityEngine.Vector3", "SeaPower.Globals+Frequency",
+        "System.Single", "System.Single", "System.Single", "SeaPower.Crew", "System.Single" };
+    private const BindingFlags TestRangeLookup = (BindingFlags)60; // Instance | Static | Public | NonPublic, as the author uses
+
+    // A type's structural name: full name, with generic arguments spelled out.
+    public static string TestRangeTypeName(Type type)
+        => type == null ? "<null>" : type.IsGenericType && !type.IsGenericTypeDefinition
+            ? type.GetGenericTypeDefinition().FullName + "<" + String.Join(",", type.GetGenericArguments().Select(TestRangeTypeName)) + ">"
+            : type.FullName;
+
+    private static bool TestRangeTypes(IEnumerable<Type> types, params string[] names)
+        => types != null && types.Select(TestRangeTypeName).SequenceEqual(names);
+
+    // Replaces Enumerable.Concat<Type> at CountermeasureApi.Validate IL_0164
+    // (site 1). Stable summed each jammer's noise inside CombinedJamUnit; beta
+    // RadarCalculator.ApplyJammingToDetectionRange IL_0036..IL_0047 sums
+    // ECM.StandoffNoiseFactor(ownPosition, frequency, jamResistance) per jammer
+    // and passes only the total to CombinedJamUnit(double, ...). Returns the
+    // parameter types of that native beta method, which are JamUnit's
+    // arguments 1, 2 and 7, so the author's Add binds the native per-jammer term.
+    public static IEnumerable<Type> TestRangeStandoffArgs(IEnumerable<Type> legacyPrefix, IEnumerable<Type> jamArgs)
+    {
+        var prefix = legacyPrefix?.ToArray(); var jam = jamArgs?.ToArray();
+        if (!TestRangeTypes(prefix, "System.Collections.Generic.IEnumerable`1<SeaPower.ECM>") || !TestRangeTypes(jam, TestRangeJamUnitTypes))
+            throw new InvalidOperationException("Inspected TestRange combined-jamming registration changed");
+        var standoff = typeof(ECM).GetMethods(TestRangeLookup).Where(m => m.Name == "StandoffNoiseFactor").ToArray();
+        if (standoff.Length != 1 || standoff[0].IsStatic || TestRangeTypeName(standoff[0].ReturnType) != "System.Double" ||
+            !TestRangeTypes(standoff[0].GetParameters().Select(p => p.ParameterType), TestRangeTypeName(jam[1]), TestRangeTypeName(jam[2]), TestRangeTypeName(jam[7])))
+            throw new InvalidOperationException("Inspected beta ECM.StandoffNoiseFactor changed");
+        return standoff[0].GetParameters().Select(p => p.ParameterType).ToArray();
+    }
+
+    // Replaces the call to CountermeasureApi.Add at CountermeasureApi.Validate
+    // IL_01f9 (site 2), the registration of stable's 10-parameter
+    // CombinedJamUnit(IEnumerable<ECM>, ObjectBase, ...). The beta ECM method
+    // table has only CombinedJamUnit(double supportNoiseFactor, ObjectBase, ...),
+    // which receives the sum that site 1's StandoffNoiseFactor hook already
+    // filters, so nothing is registered. Stable's 9-parameter overload only
+    // forwarded to this one, so site 1 covers both.
+    public static void TestRangeLegacyCombined(Type type, string name, Type result, bool isStatic, string hook, bool postfix, bool optional, Type[] args)
+    {
+        if (TestRangeTypeName(type) != "SeaPower.ECM" || name != "CombinedJamUnit" || TestRangeTypeName(result) != "System.Single" || !isStatic ||
+            hook != "Combined" || postfix || optional || args == null || args.Length != 10 ||
+            !TestRangeTypes(args.Take(2), "System.Collections.Generic.IEnumerable`1<SeaPower.ECM>", "SeaPower.ObjectBase") ||
+            !TestRangeTypes(args.Skip(2), TestRangeJamUnitTypes))
+            throw new InvalidOperationException("Inspected TestRange legacy combined-jamming registration changed");
+        var combined = type.GetMethods(TestRangeLookup).Where(m => m.Name == name).ToArray();
+        if (combined.Length != 1 || !combined[0].IsStatic || combined[0].GetParameters().Length != 9 ||
+            TestRangeTypeName(combined[0].GetParameters()[0].ParameterType) != "System.Double" || combined[0].GetParameters()[0].Name != "supportNoiseFactor")
+            throw new InvalidOperationException("Inspected beta ECM.CombinedJamUnit changed: this adapter is for beta Build 261026 only");
+    }
+}
